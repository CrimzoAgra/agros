[Unit]
Description=AgrOS: finish the setup in your first desktop session (wallpaper, colours, app settings)
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=!%S/agros/session-init-done

[Service]
Type=oneshot
ExecStart=/usr/local/lib/agros/agros-session-init
TimeoutStartSec=1h

[Install]
WantedBy=graphical-session.target

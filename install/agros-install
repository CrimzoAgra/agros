#!/usr/bin/env bash
# Sets AgrOS up for a user, unattended: every step ./setup.sh has, one by one, run as that user, with sudo allowed
# without a password for this run only. You never run setup.sh yourself: the installer runs this.
#   agros-install <user>     run as root: by the AgrOS installer (Calamares, in the new system's chroot, after it has
#                            made your user), or on an already installed CachyOS/Arch
#   agros-install --resume   the steps an install left undone (no network then): agros-firstboot.service runs this at
#                            the first boot with network
# Left for later on purpose: the desktop step (it needs the running desktop: agros-session-init at your first login)
# and the personal one (your accounts, from your pen drive: agros-personal). A step that fails doesn't stop the others;
# it's noted in /var/lib/agros/pending and tried again at the next boot. Log: /var/log/agros-install.log
set -uo pipefail

state=${AGROS_STATE:-/var/lib/agros}
log=${AGROS_LOG:-/var/log/agros-install.log}
here=$(dirname "$(readlink -f "$0")")
lib=${AGROS_LIB:-/usr/local/lib/agros}          # where the session and boot parts are installed
units=${AGROS_UNITS:-/etc/systemd}              # (tests: elsewhere)
sudoers=${AGROS_SUDOERS:-/etc/sudoers.d/zz-agros-install}
DEFERRED=(desktop personal)

say() { printf '\n==> %s\n' "$*"; }

[[ $EUID -eq 0 ]] || { echo "Run as root: agros-install <user>"; exit 1; }
resume=false
if [[ ${1:-} == --resume ]]; then
    resume=true
    user=$(cat "$state/user" 2>/dev/null) || { echo "Nothing to resume."; exit 0; }
    [[ -s $state/pending ]] || { echo "Nothing left to do."; exit 0; }
else
    user=${1:?usage: agros-install <user> | --resume}
fi
home=$(getent passwd "$user" | cut -d: -f6) || { echo "No user $user"; exit 1; }
[[ -n $home && -d $home ]] || { echo "No home for $user"; exit 1; }
repo=$home/Projects/agros
mkdir -p "$state" "${log%/*}"
exec > >(tee -a "$log") 2>&1
echo "== agros-install $(date '+%F %T') for $user$($resume && echo ' (resume)')"
echo "$user" >"$state/user"

# The repo, in your home (setup and dotfiles-sync work from it): the installer put it there; on a running system it's
# cloned
if [[ ! -x $repo/setup.sh ]]; then
    if [[ -x $here/../setup.sh && $(readlink -f "$here/..") != "$(readlink -f "$repo")" ]]; then
        mkdir -p "${repo%/*}" && cp -a "$here/.." "$repo"
    else
        command -v git >/dev/null || pacman -S --needed --noconfirm git
        git clone "${AGROS_REPO_URL:-https://github.com/CrimzoAgra/agros.git}" "$repo" || { echo "!! Couldn't get the AgrOS repo"; exit 1; }
    fi
fi
chown -R "$user:" "$home/Projects"

# sudo without a password for the run (setup's system steps), removed whatever happens
command -v sudo >/dev/null || pacman -S --needed --noconfirm sudo
cleanup() { rm -f "$sudoers"; }
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM
printf 'Defaults:%s !requiretty\n%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$user" "$user" >"$sudoers"
chmod 440 "$sudoers"
if command -v visudo >/dev/null && ! visudo -cqf "$sudoers"; then
    echo "!! The temporary sudo rule isn't valid"
    exit 1
fi

# as_user <command...>: run as the user, with a clean login-like environment (no session: none exists yet)
as_user() {
    runuser -u "$user" -- env -i HOME="$home" USER="$user" LOGNAME="$user" SHELL=/bin/bash TERM=dumb \
        LANG="${LANG:-C.UTF-8}" PATH="$home/.local/bin:/usr/local/bin:/usr/bin:/bin" \
        ${AGROS_TEST_ENV:-} "$@"
}

# Resuming at boot: the network first (what's left is mostly downloads), up to 10 minutes
if $resume; then
    for _ in $(seq 120); do
        curl -fsS --max-time 5 -o /dev/null https://archlinux.org && break
        sleep 5
    done
fi

# The steps to run: all of setup's (its own list, in order) less the deferred ones; resuming: those left undone
if $resume; then
    mapfile -t steps <"$state/pending"
else
    mapfile -t steps < <(as_user bash -c 'cd "$1" && ./setup.sh --list' _ "$repo" | awk '{print $1}')
fi
pending=()
for step in "${steps[@]}"; do
    [[ -n $step ]] || continue
    [[ " ${DEFERRED[*]} " == *" $step "* ]] && continue
    say "Step: $step"
    if ! as_user bash -c 'cd "$1" && ./setup.sh --yes --only "$2"' _ "$repo" "$step" </dev/null; then
        echo "!! Step $step failed: tried again at the next boot"
        pending+=("$step")
    fi
done
if ((${#pending[@]})); then
    printf '%s\n' "${pending[@]}" >"$state/pending"
else
    rm -f "$state/pending"
fi

# The parts that run later by themselves: at your first desktop login (the desktop step, then the offer to bring your
# accounts back) and, while steps are left, at boot
install -Dm755 "$repo/install/agros-session-init" "$lib/agros-session-init"
install -Dm755 "$repo/install/agros-install" "$lib/agros-install"
install -Dm644 "$repo/install/agros-session-init.service" "$units/user/agros-session-init.service"
install -Dm644 "$repo/install/agros-firstboot.service" "$units/system/agros-firstboot.service"
mkdir -p "$units/user/graphical-session.target.wants" "$units/system/multi-user.target.wants"
ln -sfn ../agros-session-init.service "$units/user/graphical-session.target.wants/agros-session-init.service"
if ((${#pending[@]})); then
    ln -sfn ../agros-firstboot.service "$units/system/multi-user.target.wants/agros-firstboot.service"
else
    rm -f "$units/system/multi-user.target.wants/agros-firstboot.service"
fi

if ((${#pending[@]})); then
    say "AgrOS installed; left for the next boot (with network): ${pending[*]}"
    # (the installer carries on: these are retried at boot. Resuming, still left: the boot service says it failed)
    $resume && exit 1
    exit 0
fi
say "AgrOS set up for $user."

+// AgrOS: the map scaled to fit the widget, its shape kept, centred in it: where it's drawn
+static QRect
+mapRect( const QSize& widget, const QSize& image )
+{
+    const QSize s = image.scaled( widget, Qt::KeepAspectRatio );
+    return QRect( QPoint( ( widget.width() - s.width() ) / 2, ( widget.height() - s.height() ) / 2 ), s );
+}

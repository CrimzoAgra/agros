#!/usr/bin/env bash
# Links each AgrOS program and its data folder into your home (~/.local/bin/<name>, ~/.local/share/<folder>), where the
# desktop's configs and scripts look for them. New accounts get them from /etc/skel; this adds ones that came with a
# package update since. Never over a file of your own: only missing ones, and links that point into AgrOS. Also
# AgrOS's settings an update added or changed (below). Run at every login (agros-links.service) and for each user
# right after an update of AgrOS's settings or programs (agros-system's 00-agros-links.hook: a session running through
# it gets them then, not at its next login).
set -uo pipefail
case ${1:-} in
    '') ;;
    -h | --help) sed -n '2,${/^#/!q;s/^# \{0,1\}//p;}' "$0"; exit 0 ;;
    *) echo "agros-links: unknown option $1 (agros-links --help)" >&2; exit 2 ;;
esac
lib=${AGROS_LIB:-/usr/lib/agros}
link() {  # link <target> <link>
    if [[ -L $2 ]]; then
        [[ $(readlink "$2") == "$lib"/* && $(readlink "$2") != "$1" ]] && ln -sfn "$1" "$2"
        return 0
    fi
    [[ -e $2 ]] && return 0
    mkdir -p "${2%/*}" && ln -s "$1" "$2"
}
for f in "$lib"/bin/*; do [[ -f $f ]] && link "$f" "$HOME/.local/bin/${f##*/}"; done
# (none: the glob left as it is, not linked as a folder named "*")
for d in "$lib"/share/*/; do d=${d%/}; [[ -e $d ]] && link "$d" "$HOME/.local/share/${d##*/}"; done
# Links into AgrOS whose program a package update took away
for l in "$HOME"/.local/bin/* "$HOME"/.local/share/*; do
    [[ -L $l && $(readlink "$l") == "$lib"/* && ! -e $l ]] && rm -f "$l"
done
# Files a package update brought into /etc/skel/.config (fetch's, LibreWolf's overrides inside a folder you already
# have), its launcher entries (/etc/skel/.local/share/applications), LibreWolf's settings (.local/share/firefox, which
# agros-welcome applies) and Caelestia's wallpaper in Pictures/Wallpapers: copied in once, right after the update or at
# the first login after (an account not made from /etc/skel gets them so too). Never over one of yours, and one you
# delete stays deleted (the files already offered are kept, by their path from .config, the others by theirs from
# home). Not the rest of ~/.local/share: lutris-library adds Lutris's covers its own way
root=${AGROS_SKEL:-/etc/skel} state=${XDG_STATE_HOME:-$HOME/.local/state}/agros
seen=$state/configs-seen
mkdir -p "$state" && : >>"$seen"
declare -A had
while IFS= read -r n; do had[$n]=1; done <"$seen"
for part in .config .local/share/applications .local/share/firefox Pictures/Wallpapers; do
    skel=$root/$part
    while IFS= read -r -d '' f; do
        to=$HOME/$part/${f#"$skel"/} n=${f#"$root"/}
        [[ $part == .config ]] && n=${f#"$skel"/}
        [[ ${had[$n]-} ]] && continue
        # (marked seen only once it's there: a copy that failed, a full disk, is tried again at the next run)
        { [[ -e $to || -L $to ]] || { mkdir -p "$(dirname "$to")" && cp -P "$f" "$to"; }; } && echo "$n" >>"$seen"
    done < <(find "$skel" \( -type f -o -type l \) -print0 2>/dev/null)
done
# Settings an update changed (/usr/share/agros/skel-versions: every version each has had, all but those yours to
# change): yours replaced while it's one of those (you never edited it), else kept, with AgrOS's new one beside it as
# <file>.agros-new and said once
versions=${AGROS_SKEL_VERSIONS:-/usr/share/agros/skel-versions} offered=$state/settings-offered
sum() { sha256sum <"$1" | cut -d' ' -f1; }
declare -A known told
new=() offer=()
if [[ -r $versions ]]; then
    : >>"$offered"
    while read -r s n; do known[$s $n]=1; done <"$versions"
    while IFS= read -r l; do told[$l]=1; done <"$offered"
    while read -r _ n; do
        f=$root/$n to=$HOME/$n
        # (a link, of AgrOS's or yours, left as it is)
        [[ -f $f && ! -L $f && -f $to && ! -L $to ]] || continue
        cmp -s "$f" "$to" && continue
        s=$(sum "$f")
        if [[ ${known[$(sum "$to") $n]-} ]]; then
            # (written beside it, then moved over it: never half-written; its mode as yours was)
            cp "$f" "$to.agros-tmp" && chmod --reference="$to" "$to.agros-tmp" && mv -f "$to.agros-tmp" "$to"
        elif [[ ! ${told[$s $n]-} ]]; then
            cp "$f" "$to.agros-new" && new+=("$n") && offer+=("$s $n")
        fi
    done < <(awk '!x[substr($0, 67)]++' "$versions")  # (each file once: by its name, after the sum and two spaces)
fi
# The bar's status icons, the sound one among them: Caelestia's shell.json is yours (copied in once, never updated), so
# a home from before AgrOS listed them had Caelestia's own, without it. AgrOS's list (/etc/skel's) added once, only
# where there's none: a list of yours kept, and one you take out later stays out. No shell.json, or one jq can't read
# (Caelestia mid-rewrite, a hand edit): looked at again at the next login
shell=$HOME/.config/caelestia/shell.json mark=$state/bar-status-icons
if [[ ! -e $mark && -f $shell ]] && has=$(jq '.bar.statusIcons != null' "$shell" 2>/dev/null) && [[ -n $has ]]; then
    icons=$(jq -c '.bar.statusIcons // empty' "$root/.config/caelestia/shell.json" 2>/dev/null)
    if [[ $has == true ]]; then
        touch "$mark"
    elif [[ -n $icons ]]; then
        # (looked at again under json-edit's lock: a list Caelestia wrote in between kept)
        "$(dirname "$(readlink -f "$0")")/json-edit" "$shell" --indent 4 --argjson i "$icons" \
            'if .bar.statusIcons == null then .bar.statusIcons = $i else . end' && touch "$mark"
    fi
fi
# The lock screen's notifications counted, not shown (lock.hideNotifs: a one-time code showed on a locked screen): a
# shell.json from before AgrOS set it gets it once, only where it has none (yours kept, and turned off later it stays
# off). No shell.json, or one jq can't read: looked at again at the next login
mark=$state/lock-hide-notifs
if [[ ! -e $mark && -f $shell ]] && jq -e 'type == "object"' "$shell" >/dev/null 2>&1; then
    "$(dirname "$(readlink -f "$0")")/json-edit" "$shell" --indent 4 \
        'if .lock.hideNotifs == null then .lock.hideNotifs = true else . end' && touch "$mark"
fi
# VSCodium starts on a new empty window, not on the last one without a folder (window.restoreWindows): a Claude Code
# tab left open there came back at every start and asked again whether to trust your home folder (Claude Code never
# keeps that answer for home). Its settings.json is yours (copied in once, never updated), so one from before gets the
# setting once, only where it has none. None yet, or one jq can't read (VSCodium allows comments, jq doesn't): looked
# at again at the next login
code=$HOME/.config/VSCodium/User/settings.json mark=$state/vscodium-restore-windows
if [[ ! -e $mark && -f $code ]] && jq -e 'type == "object"' "$code" >/dev/null 2>&1; then
    "$(dirname "$(readlink -f "$0")")/json-edit" "$code" --indent 4 \
        'if has("window.restoreWindows") then . else .["window.restoreWindows"] = "folders" end' && touch "$mark"
fi
# VSCodium's dialogs drawn in its own window (window.dialogStyle), not as GTK ones: GTK's is as wide as its longest
# line, and Claude Code's login link (one line, no spaces) made "open the external website?" wider than the screen.
# Added once, as above
mark=$state/vscodium-dialog-style
if [[ ! -e $mark && -f $code ]] && jq -e 'type == "object"' "$code" >/dev/null 2>&1; then
    "$(dirname "$(readlink -f "$0")")/json-edit" "$code" --indent 4 \
        'if has("window.dialogStyle") then . else .["window.dialogStyle"] = "custom" end' && touch "$mark"
fi
# Claude Code's sessions folder, made before its first session: VSCodium's Claude Code Usage extension reads it, and
# showed a red "Error" (Usage refresh failed) until Claude Code had run once. Once: one you delete stays deleted
mark=$state/claude-projects
[[ -e $mark ]] || { mkdir -p "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects" && touch "$mark"; }
# (in the background: Caelestia, the notification server, isn't up yet; agros-links.service keeps it alive). Marked as
# said only once it was: one that never got through is said at the next login
((${#new[@]})) && { "$(dirname "$(readlink -f "$0")")/dots-warn" "AgrOS updated settings you've changed" \
    "Yours kept, AgrOS's new version beside each as .agros-new: ${new[*]}" &&
    printf '%s\n' "${offer[@]}" >>"$offered"; } &
exit 0

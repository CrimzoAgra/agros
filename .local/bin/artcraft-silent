#!/usr/bin/env python3
"""ArtCraft Launcher at login, in the tray only (user/apps.lua; Settings app: startup.artcraft).

It starts with --hidden, but when it updates itself (often right at login) it restarts without it and shows its
window. So for the first two minutes, any ArtCraft window that opens is closed, which sends it to the tray (its
"close to tray" setting). Waits on Hyprland's events; nothing runs after that.
"""
import os
import socket
import subprocess
import time

WATCH = 120  # seconds
CLASS = ("ai.storyteller.artcraft-launcher", "artcraft-launcher")  # Flatpak app id; the .desktop says the latter

subprocess.Popen(["flatpak", "run", "ai.storyteller.artcraft-launcher", "--hidden"], start_new_session=True,
                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

sock = socket.socket(socket.AF_UNIX)
try:
    sock.connect(f"{os.environ['XDG_RUNTIME_DIR']}/hypr/{os.environ['HYPRLAND_INSTANCE_SIGNATURE']}/.socket2.sock")
except (KeyError, OSError):
    raise SystemExit  # not in a Hyprland session: it's started (hidden), nothing to watch
end = time.monotonic() + WATCH
buf = b""
while (left := end - time.monotonic()) > 0:
    sock.settimeout(left)
    try:
        data = sock.recv(4096)
    except TimeoutError:
        break
    if not data:
        break
    buf += data
    *lines, buf = buf.split(b"\n")
    for line in lines:
        name, _, args = line.decode(errors="replace").partition(">>")
        if name == "openwindow":
            addr, _, cls, *_ = args.split(",", 3) + [""]
            if cls in CLASS:
                time.sleep(0.3)  # let it map before closing
                subprocess.run(["hyprctl", "dispatch", f'hl.dsp.window.close({{ window = "address:0x{addr}" }})'],
                               capture_output=True)

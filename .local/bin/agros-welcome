#!/usr/bin/env bash
# AgrOS's first login (agros-welcome.service, once per account): what a package can't do because it's per user, or
# can't be redistributed, then the offer to bring your accounts back from your pen drive.
#   agros-welcome            your account's part, at your first login (the service runs it; again by hand is fine)
#   agros-welcome --system   the system's part, with sudo, in a terminal it opens itself: the apps for hardware
#                            that's plugged in (Razer, Logitech, Moza, tablets, the Legion's camera switch, the
#                            NVIDIA driver loaded early) and
#                            VMware Workstation (its license forbids passing it on, so it's built here from the AUR)
# Log: ~/.local/state/agros/welcome.log
set -uo pipefail
st=${XDG_STATE_HOME:-$HOME/.local/state}/agros
# The shared helpers and AgrOS's other programs beside this, not links agros-links may not have added yet
helpers=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")") qs_running=$helpers/qs-running

# Claude Code's plugins, as "GitHub repo of its marketplace|plugin@marketplace"
CLAUDE_PLUGINS=(
    "DietrichGebert/ponytail|ponytail@ponytail"              # minimal code: justifies each line first (needs node)
    "addyosmani/agent-skills|agent-skills@addy-agent-skills" # Addy Osmani's engineering skills
)
# Apps for hardware, only when a device of that USB vendor is plugged in (or paired over Bluetooth), as
# "name|packages|vendor ids". OpenTabletDriver turns off the kernel's own pen drivers (a convertible's pen stopped
# working), OpenRazer builds a kernel module at every update: so not on machines without them
HARDWARE=(
    "Boxflat (Moza Pit House)|boxflat-git|346e"
    "OpenRazer + Polychromatic (Razer Synapse)|openrazer-daemon openrazer-driver-dkms polychromatic|1532"
    "Solaar (Logitech G Hub, Logi Options+)|solaar|046d"
    "OpenTabletDriver (Wacom, Huion, XP-Pen, Gaomon tablets)|opentabletdriver|056a 256c 28bd 5543"
)

installed() { [[ $(pacman -Qq "$1" 2>/dev/null) == "$1" ]]; }

# --- The system's part (root) ---

# vendors: USB devices (behind hubs and receivers too) and Bluetooth ones (HID names: 0005:046D:B023.0001); not
# built-in I2C ones (0018:…): a convertible's own Wacom pen would pull in OpenTabletDriver, which breaks it
vendors() { { cat /sys/bus/usb/devices/*/idVendor; ls /sys/bus/hid/devices | awk -F: '$1 == "0005" {print tolower($2)}'; } 2>/dev/null | sort -u; }
usb_device() {
    local d
    for d in /sys/bus/usb/devices/*; do
        [[ $(cat "$d/idVendor" 2>/dev/null):$(cat "$d/idProduct" 2>/dev/null) == "$1:$2" ]] && return 0
    done
    return 1
}
# An NVIDIA graphics card (PCI vendor 10de, a display controller: class 03xxxx), as lspci lists it
nvidia_gpu() {
    local d
    for d in "${SYSFS:-/sys}"/bus/pci/devices/*; do
        [[ $(cat "$d/vendor" 2>/dev/null) == 0x10de && $(cat "$d/class" 2>/dev/null) == 0x03* ]] && return 0
    done
    return 1
}
kernel_headers() {
    local f
    for f in /usr/lib/modules/*/pkgbase; do [[ -f $f ]] && echo "$(<"$f")-headers"; done | sort -u
}

system_part() {
    # (rc: an install that failed returned, so the first login's offer comes back at the next one)
    local user=${SUDO_USER:?run with sudo from your account} entry name pkgs usb v want=() names=() rc=0
    v=$(vendors)
    for entry in "${HARDWARE[@]}"; do
        IFS='|' read -r name pkgs usb <<<"$entry"
        grep -qxFf <(tr ' ' '\n' <<<"$usb") <<<"$v" || continue
        names+=("$name")
        # shellcheck disable=SC2206  # (space-separated package names)
        want+=($pkgs)
    done
    if grep -qs 'Name="Ideapad extra buttons"' /proc/bus/input/devices && usb_device 04f2 b83e; then
        names+=("the Legion's camera switch")
        want+=(agros-camera-switch)
    fi
    if nvidia_gpu; then
        names+=("the NVIDIA driver loaded early in the boot")
        want+=(agros-nvidia)
    fi
    if ((${#want[@]})); then
        echo "For the hardware plugged in: ${names[*]}"
        pacman -S --needed --noconfirm "${want[@]}" || { echo "!! Some of them didn't install: ${want[*]}"; rc=1; }
    fi
    # VMware Workstation: from the AUR (its installer from a copy on archive.org, as Broadcom gives it only to signed-in
    # users, checked against the package's checksum), built as you (an AUR helper refuses root), its modules by DKMS
    # for every installed kernel. vmware-keymaps first: the package needs it but sets that only in its build script
    echo "VMware Workstation (built from the AUR: a few minutes)"
    # shellcheck disable=SC2046  # (package names)
    pacman -S --needed --noconfirm $(kernel_headers) >/dev/null
    if sudo -u "$user" paru -S --needed --noconfirm --skipreview vmware-keymaps vmware-workstation; then
        modprobe -a vmw_vmci vmmon 2>/dev/null || echo "!! VMware's kernel modules didn't load: restart before using it"
        systemctl enable --now vmware-networks.path vmware-usbarbitrator.path || echo "!! VMware's services couldn't be turned on"
    else
        echo "!! VMware Workstation didn't install: agros-welcome --system tries again"
        rc=1
    fi
    # OpenRazer only talks to users in its group
    if installed openrazer-daemon; then
        local g
        g=$(getent group openrazer >/dev/null && echo openrazer || echo plugdev)
        getent group "$g" >/dev/null || groupadd -r "$g"
        gpasswd -a "$user" "$g" >/dev/null
    fi
    echo "Done."
    return $rc
}

if [[ ${1:-} == --system && ${BASH_SOURCE[0]} == "$0" ]]; then
    if [[ $EUID -ne 0 ]]; then
        echo "Installing the apps for your hardware and VMware Workstation needs root: sudo asks for your password."
        exec sudo "$0" --system
    fi
    system_part
    exit
fi

# --- Your account's part ---

[[ $EUID -ne 0 || ${BASH_SOURCE[0]} != "$0" ]] || { echo "Run as your account (agros-welcome --system for the system's part)"; exit 1; }

caelestia_setup() {
    # (run in an && list, so set -e is off in here: a failure said, not left silent)
    local dst="$HOME/.config/quickshell/caelestia"
    # A Caelestia already running on the overlay: built for it by caelestia-start at this login (or a pacman hook since),
    # left alone. Rebuilt under it, the swapped folder got the running shell dropped by Hyprland, with nothing to bring
    # it back. Running without the changes (caelestia-start's build failed: Caelestia as it comes, from /etc/xdg or
    # from the copy the failed build left, which the overlay's state file says): stopped, rebuilt and started again by
    # caelestia-restart --rebuild (its notification, once the new shell is up, says if it fails again)
    # (rc: a failure returned, so the step is tried again at the next login, not marked done)
    local running='' ours='' failed='' rc=0
    "$qs_running" /quickshell/caelestia/shell.qml && running=1
    # (on the overlay: from its folder, not Caelestia's own in /etc/xdg; caelestia-overlay's own check)
    "$helpers/caelestia-overlay" --running && ours=1
    grep -qs 'Caelestia runs without your changes' "${XDG_STATE_HOME:-$HOME/.local/state}/caelestia-overlay-skipped" && failed=1
    if [[ -n $ours && -e $dst/shell.qml && -z $failed ]]; then
        echo "Caelestia overlay (your changes to Caelestia) already running."
    elif [[ -n $running ]]; then
        # (outside the desktop, caelestia-restart has Hyprland run it, with the desktop's environment)
        if "$helpers/caelestia-restart" --rebuild >/dev/null 2>&1; then
            echo "Caelestia ran without your changes: rebuilding them, Caelestia restarted on them."
        else
            echo "!! Caelestia runs without your changes (run: ~/.local/bin/caelestia-restart --rebuild)"; rc=1
        fi
    elif [[ -e $dst/shell.qml && -z $failed ]]; then
        # (built, by caelestia-start at this login, its shell not up yet: not built again under it as it comes up)
        echo "Caelestia overlay (your changes to Caelestia) already built."
    elif "$helpers/caelestia-overlay"; then
        echo "Caelestia overlay (your changes to Caelestia) built."
    else
        echo "!! The Caelestia overlay didn't build (run: ~/.local/bin/caelestia-overlay)"; rc=1
    fi
    # Only the first time (its own mark, not Caelestia's wallpaper file, which Caelestia may have written already): run
    # again (after a pull), it would replace the wallpaper and colours you've picked since
    local mark="$st/wallpaper-set"
    if [[ -e $mark ]]; then
        echo "Wallpaper and colours left as you have them."
        return $rc
    fi
    # Then the colours from it (Caelestia starts on its fixed teal scheme). In that order: the dynamic scheme is refused
    # while no wallpaper is set ("No wallpaper set"), and a fresh install kept the teal accent.
    # Hyprland named for the CLI too (the same first one as -i 0): it asks Hyprland whether its config is Lua, and from an
    # SSH login or a text console wrote the window borders' colours to current.conf, which the Lua config doesn't read
    local sig=${HYPRLAND_INSTANCE_SIGNATURE:-$(hyprctl instances -j 2>/dev/null | jq -r '.[0].instance // empty' 2>/dev/null)}
    # Caelestia's own wallpaper (it shows it itself when none is set), set here so its colours can follow it
    local wall=/etc/xdg/quickshell/caelestia/assets/wallpaper.webp
    if HYPRLAND_INSTANCE_SIGNATURE=$sig caelestia wallpaper -f "$wall" 2>/dev/null; then
        if HYPRLAND_INSTANCE_SIGNATURE=$sig caelestia scheme set -n dynamic >/dev/null 2>&1; then
            echo "Wallpaper and colours set."
        else
            echo "!! Wallpaper set, but not its colours (run: caelestia scheme set -n dynamic)"
        fi
        mkdir -p "${mark%/*}" && touch "$mark"
        # (the login screen's copy of them, as caelestia-start does once it sets them)
        "$helpers/greeter-theme-sync" >/dev/null 2>&1
    else
        echo "Wallpaper will be set from inside Caelestia (run: caelestia wallpaper -f $wall)"
    fi
    return $rc
}

# No window buttons drawn by GTK apps (LibreWolf too, and apps installed later): the title bars on floating windows have
# them (.config/caelestia/user/titlebars.lua)
window_buttons() {
    gsettings set org.gnome.desktop.wm.preferences button-layout 'appmenu:' 2>/dev/null || true
}

# Your VSCodium extensions (list in .config/VSCodium/extensions.txt, kept up to date by dotfiles-sync; open replacements
# for the Microsoft-only ones: basedpyright for Pylance, clangd for the C/C++ tools)
# (one failed: the step's failure, so it's tried again at the next login, at most three in a row (vscodium_setup))
vscode_extensions() {
    local list="$HOME/.config/VSCodium/extensions.txt" ext rc=0
    command -v codium >/dev/null && [[ -f $list ]] || return 0
    while read -r ext; do
        [[ -n $ext ]] || continue
        codium --install-extension "$ext" >/dev/null 2>&1 || { echo "!! VSCodium extension failed: $ext"; rc=1; }
    done <"$list"
    ((rc == 0)) && echo "VSCodium extensions installed."
    return $rc
}

# Claude Code comes with its VS Code extension (in extensions.txt); ~/.local/bin/claude runs its CLI
claude_plugins() {
    local claude="$HOME/.local/bin/claude" entry repo_m plugin rc=0
    "$claude" --version >/dev/null 2>&1 || { echo "Claude Code isn't installed: skipping its plugins"; return 0; }
    for entry in "${CLAUDE_PLUGINS[@]}"; do
        IFS='|' read -r repo_m plugin <<<"$entry"
        "$claude" plugin marketplace add "$repo_m" >/dev/null 2>&1 || true # already added is fine
        "$claude" plugin install "$plugin" --scope user >/dev/null 2>&1 || { echo "!! Claude plugin failed: $plugin"; rc=1; }
    done
    ((rc == 0)) && echo "Claude Code plugins installed."
    claude_notify_hook
    return $rc
}

# A notification when Claude Code finishes an answer: ~/.local/bin/claude-notify as its Stop hook, added to
# ~/.claude/settings.json beside what's there (your other settings and hooks kept; already there: left as it is). A file
# of another shape than Claude Code's (not an object, hooks or its Stop list odd) is left untouched, and said; never
# failing the step
claude_notify_hook() {
    local f="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" cmd="$HOME/.local/bin/claude-notify"
    mkdir -p "${f%/*}" || return 0
    [[ -s $f ]] || echo '{}' >"$f" || return 0
    if ! jq -e 'type == "object" and ((.hooks // {}) | type == "object" and ((.Stop // []) | type == "array"
            and all(.[]; type == "object" and ((.hooks // []) | type == "array" and all(.[]; type == "object")))))' \
            "$f" >/dev/null 2>&1; then
        echo "!! $f isn't in the shape Claude Code writes (hooks.Stop a list of {hooks: [...]}): its notification hook not added"
        return 0
    fi
    jq -e --arg c "$cmd" 'any(.hooks.Stop[]?.hooks[]?; .command == $c)' "$f" >/dev/null 2>&1 && return 0
    # (json-edit: replaced whole, never half-written; a link stays one, the file keeps its mode)
    if "$helpers/json-edit" "$f" --indent 2 --arg c "$cmd" \
        '.hooks.Stop = (.hooks.Stop // []) + [{hooks: [{type: "command", command: $c}]}]'; then
        echo "Claude Code's notification hook (claude-notify) added."
    else
        echo "!! Claude Code's notification hook couldn't be added to $f"
    fi
    return 0
}

# LibreWolf's settings (.local/share/firefox/settings.js) into its profile, once per profile: started once in the
# background when it has none yet
librewolf_setup() {
    local settings="$HOME/.local/share/firefox/settings.js" prof pid
    command -v librewolf >/dev/null && [[ -f $settings ]] || return 0
    pgrep -u "$UID" -x librewolf >/dev/null && { echo "LibreWolf is open: its settings are applied at the next login"; return 1; }
    prof=$("$helpers/firefox-bookmarks-export" --profile 2>/dev/null)
    if [[ -z $prof ]]; then
        librewolf --headless about:blank >/dev/null 2>&1 &
        pid=$!
        for _ in $(seq 30); do
            sleep 1
            prof=$("$helpers/firefox-bookmarks-export" --profile 2>/dev/null)
            [[ -n $prof && -f $prof/prefs.js ]] && break
        done
        sleep 2
        kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
    fi
    [[ -n $prof && -d $prof ]] || { echo "!! No LibreWolf profile: settings not applied"; return 1; }
    if [[ ! -e $prof/.dotfiles-imported ]]; then
        grep '^user_pref' "$settings" >>"$prof/prefs.js"
        # The new tab's background: the picture, under the id settings.js names it by
        local wallpaper="$HOME/.local/share/firefox/newtab-wallpaper.jpg" id
        id=$(grep -oP 'customWallpaper\.uuid", "\K[^"]+' "$settings") || true
        [[ -f $wallpaper && -n $id ]] && mkdir -p "$prof/wallpaper/library" && cp "$wallpaper" "$prof/wallpaper/library/$id"
        touch "$prof/.dotfiles-imported"
        echo "LibreWolf settings applied."
    fi
    # Its theme downloaded: offline at the first login, tried again at the next (it was never tried again), failing a
    # third login in a row said and counted as done, as VSCodium's step
    local tries="$st/librewolf-theme-failed"
    librewolf_theme "$prof" && { rm -f "$tries"; return 0; }
    (($("$helpers/fail-streak" "$tries") < 3)) && return 1
    echo "!! The Lagoon theme didn't download three logins in a row: pick it in LibreWolf's settings, Appearance"
    rm -f "$tries"
}

# The Lagoon theme settings.js picks (Mozilla's, on addons.mozilla.org; not part of LibreWolf): put in the profile's
# extensions folder and allowed from there (extensions.autoDisableScopes), registered by one start, then made the theme
# in use (one appearing that way comes in turned off, and extensions.activeThemeID alone doesn't turn it on)
librewolf_theme() {
    local prof=$1 id=nova-lagoon@mozilla.org pid
    grep -q "\"$id\"" "$prof/extensions.json" 2>/dev/null && return 0
    mkdir -p "$prof/extensions"
    curl -sfL --max-time 60 -o "$prof/extensions/$id.xpi" \
        https://addons.mozilla.org/firefox/downloads/latest/nova-lagoon/latest.xpi ||
        { rm -f "$prof/extensions/$id.xpi"; echo "!! The Lagoon theme didn't download (offline?): tried again at the next login"; return 1; }
    echo 'user_pref("extensions.autoDisableScopes", 14);' >>"$prof/prefs.js"
    librewolf --headless about:blank >/dev/null 2>&1 &
    pid=$!
    for _ in $(seq 30); do
        sleep 1
        grep -q "\"$id\"" "$prof/extensions.json" 2>/dev/null && break
    done
    sleep 2
    kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
    # Lagoon the one theme on (json-edit: replaced whole, never left half-written); not listed: left as it is
    [[ -s $prof/extensions.json ]] && "$helpers/json-edit" "$prof/extensions.json" --arg id "$id" '
        if any(.addons[]; .type == "theme" and .id == $id) | not then error("Lagoon not installed") else . end
        | .addons |= map(if .type == "theme" then .active = (.id == $id) | .userDisabled = (.id != $id) else . end)' \
        2>/dev/null || echo "!! The Lagoon theme isn't turned on: pick it in LibreWolf's settings, Appearance"
    # The add-on startup cache still names the old theme, and LibreWolf draws that one (Lagoon only listed as on):
    # without it LibreWolf rebuilds it from extensions.json
    rm -f "$prof/addonStartup.json.lz4"
}

# VSCodium's extensions (Claude Code's among them: its CLI is ~/.local/bin/claude), then Claude Code's plugins and its
# notification hook
# (the plugins tried even when an extension failed: Claude Code's may be there all the same)
# A failure is tried again at the next login (offline), not for good: one extension or plugin gone from its store
# failed the step at every login. Failing a third login in a row (as capri-update does a failure that keeps coming
# back), it's said and counts as done
vscodium_setup() {
    local rc=0 n tries="$st/vscodium-failed"
    vscode_extensions || rc=1
    claude_plugins || rc=1
    ((rc)) || { rm -f "$tries"; return 0; }
    n=$("$helpers/fail-streak" "$tries")
    if ((n >= 3)); then
        echo "!! VSCodium extensions or Claude plugins failed $n logins in a row: not tried again (install them by hand)"
        rm -f "$tries"
        return 0
    fi
    return 1
}

# Flatpaks: Spotify for you (so Spicetify can change it), then Spicetify; Nuvio and ArtCraft from their GitHub
# releases' .flatpak files (flatpak-bundle-update keeps them updated: they have no Flatpak repo)
flatpaks() {
    local ok=0
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || ok=1
    flatpak install --user -y --noninteractive flathub com.spotify.Client || { echo "!! Spotify (Flatpak) failed"; ok=1; }
    "$helpers/flatpak-bundle-update" --install NuvioMedia/NuvioDesktop || ok=1
    "$helpers/flatpak-bundle-update" --install storytold/craft-launcher || ok=1
    if command -v spicetify >/dev/null; then
        spicetify -q config >/dev/null 2>&1 || true
        spicetify -q config spotify_path "$HOME/.local/share/flatpak/app/com.spotify.Client/current/active/files/extra/share/spotify" \
            prefs_path "$HOME/.var/app/com.spotify.Client/config/spotify/prefs" \
            current_theme caelestia color_scheme caelestia custom_apps marketplace || echo "!! Spicetify setup failed"
    fi
    return $ok
}

# The rest that's per user: GTK apps' own window buttons off (the floating windows' title bars have them), Equibop's
# theme in your colours, Lutris's store launchers, the tablet and Razer services
others() {
    window_buttons
    local eq="$HOME/.config/equibop/settings/settings.json" rc=0
    if command -v equibop >/dev/null; then
        # (an empty one started as {}: json-edit leaves an empty file alone, and the theme was never added. Failed: the
        # step tried again at the next login, not marked done)
        { [[ -s $eq ]] || { mkdir -p "${eq%/*}" && echo '{}' >"$eq"; }; } &&
            "$helpers/json-edit" "$eq" '.enabledThemes = ((.enabledThemes // []) + ["caelestia.theme.css"] | unique)' ||
            { echo "!! Equibop's theme couldn't be turned on ($eq)"; rc=1; }
    fi
    [[ -x /usr/bin/lutris ]] && { "$helpers/lutris-library" >/dev/null 2>&1 || echo "!! lutris-library failed"; }
    installed opentabletdriver && systemctl --user enable --now opentabletdriver.service 2>/dev/null
    installed openrazer-daemon && systemctl --user enable --now openrazer-daemon.service 2>/dev/null
    return $rc
}

# (sourced, by the tests: only the functions)
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0
mkdir -p "$st"
exec > >(tee -a "$st/welcome.log") 2>&1
echo "== agros-welcome $(date '+%F %T')"
# An account set up before the offer waited for its answer (agros-welcome.service ended with this script then, which
# killed the offer at once, so none was ever marked offered): its offer was made at its first login, not made again
# now, weeks later, as the unit starts again while offered is missing. Told from an offer left unanswered since by the
# mark this version leaves as it makes one (offer-sent): an account done before has none
if [[ -e $st/done && ! -e $st/offered && ! -e $st/offer-sent ]]; then
    touch "$st/offered" && echo "set up before this version: its offer made then, not again"
fi

# Each step once, marked done; one that failed is tried again at the next login
steps=()
step() {
    local name=$1
    shift
    steps+=("$name")
    [[ -e $st/done-$name ]] && return 0
    echo "-- $name"
    "$@" && touch "$st/done-$name"
}
# (the shell up first: the overlay's restart and the wallpaper talk to it), then caelestia-start's run waited for to
# the end, under the overlay's lock (it holds it from its start until the shell answers): past the 60 s, this went on
# to build again, swapping the folder under the shell just started. In that order: this unit starts beside Hyprland's
# start, and the lock taken first went through before caelestia-start took it; with the shell slow, this then set the
# first wallpaper and colours alongside caelestia-start's own (the folder icons recoloured twice at once)
for _ in $(seq 60); do "$qs_running" /quickshell/caelestia/ && break; sleep 1; done
flock "$HOME/.config/quickshell/caelestia.lock" true 2>/dev/null
step caelestia caelestia_setup
# The live USB (the ISO's own session): only the desktop's look, nothing downloaded, no accounts to restore
[[ -d /run/archiso ]] && { echo "== live system: done $(date '+%F %T')"; exit 0; }
step others others
step librewolf librewolf_setup
step flatpaks flatpaks
step vscodium vscodium_setup
# All of them done: not run at login any more (agros-welcome.service). One that failed (offline, LibreWolf open) keeps it
# coming back until it works: the service used to stop at done-vscodium, written even when the Flatpaks had failed
all_done=1
for s in "${steps[@]}"; do [[ -e $st/done-$s ]] || all_done=; done
[[ -n $all_done ]] && touch "$st/done"

# The system's part (hardware apps, VMware) and your accounts: asked in one notification, run in a terminal. Sent by
# notify-when-up once Caelestia (the notification server) takes it. Marked offered on Later or closed, or once the
# button's restore or system part has worked: one sent to nobody, still unanswered when the session ended, or whose
# part failed or was cancelled (sudo's password prompt closed) is offered again at the next login. Critical: it stays
# on screen until it's answered (the first login's user may be away), and its buttons only open a terminal. Their
# labels short, the text saying what they do: longer ones ("Restore my accounts") were cut off in the notification
# centre, the others not shown at all
if [[ ! -e $st/offered ]]; then
    touch "$st/offer-sent"
    if [[ -n $all_done ]]; then
        text="Everything is installed."
    else
        text="Some of the setup didn't finish: it's tried again at the next login (details: $st/welcome.log)."
    fi
    # (the system's part offered to an admin (wheel) only: another account can't sudo, and its terminal only failed)
    admin=
    [[ " $(id -nG 2>/dev/null) " == *" wheel "* ]] && admin=1
    text+=" Restore accounts: plug in your pen drive to bring back your logins, keys and browser profile."
    [[ -z $admin ]] || text+=" Hardware apps: the apps for the devices plugged in (Razer, Logitech, Moza, tablets), and VMware."
    text+=" Later: run agros-personal${admin:+, or agros-welcome --system for the hardware apps}."
    setsid -f bash -c '
        sys=()
        [[ -z $4 ]] || sys=(-A system="Hardware apps")
        a=$("$1/notify-when-up" -a AgrOS -i system-software-install -u critical -A restore="Restore accounts" \
            "${sys[@]}" -A later="Later" "Welcome to AgrOS" "$2") || exit 1
        case $a in
            restore) exec foot -T "AgrOS: your accounts" sh -c "\"\$1/agros-personal\" && touch \"\$2\"; echo; read -rp \"Enter closes this window \" _" sh "$1" "$3" ;;
            system) exec foot -T "AgrOS: hardware apps and VMware" sh -c "\"\$1/agros-welcome\" --system && touch \"\$2\"; echo; read -rp \"Enter closes this window \" _" sh "$1" "$3" ;;
            *) touch "$3" ;;
        esac
    ' _ "$helpers" "$text" "$st/offered" "$admin" >/dev/null 2>&1 </dev/null
fi
echo "== done $(date '+%F %T')"

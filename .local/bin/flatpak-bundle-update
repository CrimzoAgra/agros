#!/usr/bin/env bash
# Updates the Flatpaks installed from a downloaded .flatpak file (e.g. ArtCraft Launcher), which have no Flatpak repo
# to update from, from the GitHub releases their metadata links to (update-kinds' flatpak, from the
# Updates app; the boot-time auto-update's --fetch and --install-fetched).
#   flatpak-bundle-update           update them (one asking for more access only once you said yes to it)
#   flatpak-bundle-update --check   only list the ones with a newer version ("<app id>: update available (<old> -> <new>)",
#                                   "<new> (asks for more access: <what>)" for one held for that)
#   flatpak-bundle-update --install <owner/repo>   install one for the user from its latest release (agros-welcome)
#   flatpak-bundle-update --fetch <dir>              only download the updates' files into dir (listed in dir/fetched);
#                                                    as a user, only their own: the system-wide ones are root's
#   flatpak-bundle-update --install-fetched <dir>    reinstall from those (the boot's update: it holds sleep and power
#                                                    off as root around this step alone, logind refusing it to a user
#                                                    outside a session)
#   flatpak-bundle-update --no-origin-urls <user|system>...   every app installed from a file has its -origin remote's
#                                                    URL emptied (no_origin_urls), before any flatpak update; fails
#                                                    when one couldn't be
# Takes the latest release's Linux x86_64 .flatpak, checked against the release's SHA256SUMS when it has one (a
# system-wide one only when it has one), and only when the file is that app (its ref). Each app's repo is the one it was
# installed from (--install), else its metainfo's own link to it the first time it's looked for (repo_of), written down
# (AGROS_FLATPAK_BUNDLES: the tests' list) and kept: a later version's metainfo can't point its updates elsewhere.
set -uo pipefail
check=false fetch=
[[ ${1:-} == --check ]] && check=true
[[ ${1:-} == --fetch ]] && fetch=${2:?--fetch <dir>}
status=0
source "$(dirname "$(readlink -f "$0")")/../share/github-release/lib.sh"

# newer <new> <old>: new is a later version. sort -V puts 0.1.33-alpha after 0.1.33: a release over the pre-release
# with the same number counts as newer
newer() {
    [[ $1 == "$2" ]] && return 1
    local nb=${1%%-*} ob=${2%%-*}
    if [[ $nb == "$ob" && ($1 == *-* || $2 == *-*) && ! ($1 == *-* && $2 == *-*) ]]; then
        [[ $1 != *-* ]]
        return
    fi
    [[ $(printf '%s\n' "$1" "$2" | sort -V | tail -1) == "$1" ]]
}

# bundle_app <file> <dir>: the app a .flatpak file installs (its ref, read by flatpak itself into a repo of its own in
# dir, nothing installed); its metadata (the access it asks for) written beside the file, <dir>/.metadata. The file is
# then made again from that repo, <dir>/<app id>.flatpak (the one downloaded removed), with no repo URL nor runtime repo
# in it (build-bundle's --repo-url, --runtime-repo): installed from the file as downloaded, flatpak set the URL it names
# on the app's -origin remote, and a flatpak update (the boot's, as root) could take the app from there before
# no_origin_url emptied it, past every check here
bundle_app() {
    local repo ref id arch branch
    repo=$(mktemp -d "$2/.ref.XXXXXX") && ostree init --repo="$repo" --mode=archive >/dev/null 2>&1 &&
        flatpak build-import-bundle "$repo" "$1" >/dev/null 2>&1 && ref=$(ostree refs --repo="$repo" 2>/dev/null) || return 1
    ref=$(grep -m1 '^app/' <<<"$ref") && ostree cat --repo="$repo" "$ref" /metadata >"$2/.metadata" 2>/dev/null &&
        [[ -s $2/.metadata ]] || return 1
    IFS=/ read -r _ id arch branch <<<"$ref"
    # (its id names the file made: an id's characters alone)
    [[ $id =~ ^[A-Za-z0-9_.-]+$ && $id != .* && -n $arch && -n $branch ]] || return 1
    rm -f "$1"
    flatpak build-bundle --arch="$arch" "$repo" "$2/$id.flatpak" "$id" "$branch" >/dev/null 2>&1 && echo "$id"
}

# keyfile <access|runtime>: a Flatpak metadata file (stdin) read by GLib's own GKeyFile, as flatpak reads it. An awk of
# its own missed what GLib takes: a group header with a space or tab after it, an indented one, CRLF line ends, so a
# [Context] written so gave its access unseen. Fails on a file GLib can't read. access: what it grants, one
# "[group]key=value" a line, sorted (its [Context], each of a list's values on its own; its bus policies, USB devices
# and portal policies); runtime: its [Application]'s runtime
keyfile() {
    python3 -I -c '
import sys
from gi.repository import GLib


def names(r):  # (PyGObject hands some lists back with their length)
    return r[0] if isinstance(r, tuple) else r


raw = sys.stdin.buffer.read()
if b"\0" in raw:
    sys.exit(1)
kf = GLib.KeyFile()
try:
    kf.load_from_bytes(GLib.Bytes.new(raw), GLib.KeyFileFlags.NONE)
    if sys.argv[1] == "runtime":
        print(kf.get_string("Application", "runtime"))
        sys.exit(0)
    for g in names(kf.get_groups()):
        if g not in ("Context", "Session Bus Policy", "System Bus Policy", "USB Devices") and not g.startswith("Policy "):
            continue
        for k in names(kf.get_keys(g)):
            values = [kf.get_string(g, k)] if g.endswith("Bus Policy") else names(kf.get_string_list(g, k))
            for v in values:
                if v:
                    print(f"[{g}]{k}={v}".replace("\\", "\\\\").replace("\n", "\\n"))
except Exception:  # (GLib.Error; text not UTF-8 too)
    sys.exit(1)
' "$1" | LC_ALL=C sort -u
}

# more_access <user|system> <app id> <new metadata>: what the new version asks for that the one installed doesn't have
# (a "!" taking access away isn't more), ", " between; fails when the installed one's can't be read. A new one GLib
# can't read counts as more (what it asks for unknown)
more_access() {
    local old new
    old=$(flatpak info --"$1" --show-metadata "$2" 2>/dev/null) && [[ -n $old ]] && old=$(keyfile access <<<"$old") || return 1
    new=$(keyfile access <"$3") || { echo "metadata that couldn't be read"; return 0; }
    LC_ALL=C comm -13 <(printf '%s\n' "$old") <(printf '%s\n' "$new") | awk 'NF && !/=!/' | paste -sd, | sed 's/,/, /g'
}

# ask_more <app id> <version> <what it adds>: you said yes to an update asking for more access (zenity: Updates' run is
# on your desktop; none, or no answer in 15 min: no)
ask_more() {
    zenity --question --no-markup --timeout=900 --title="Allow more access?" --ok-label=Update --cancel-label="Not now" \
        --text="$1 $2 asks for more access than the version installed: $3. With it, it reaches that outside its sandbox. Update it only if you trust this release." \
        </dev/null >/dev/null 2>&1
}

# fetch_from <release JSON> <dir> <user|system> [app id] [version]: download its Linux x86_64 .flatpak into dir,
# verified (by the release's checksums, required for a system-wide one; and that it's the app given); prints
# "<app id>\t<path>". Exit 3: an update asking for more access you said no to (not a failure)
fetch_from() {
    local url want file got more need=()
    url=$(asset_url "$1" flatpak)
    [[ -n $url ]] || { echo "no Linux .flatpak in the latest release" >&2; return 1; }
    [[ $3 != system ]] || need=(required)
    want=$(checksum "$1" "${url##*/}" "$2" "${need[@]}") && download "$url" "$2" "$want" >&2 || return 1
    file=$2/${url##*/}
    got=$(bundle_app "$file" "$2") || { echo "${url##*/}: which app it is couldn't be read, not installed" >&2; return 1; }
    [[ -z ${4:-} || $got == "$4" ]] || { echo "${url##*/} is $got, not $4: not installed" >&2; return 1; }
    # An update asking for more access than the version installed (a release of the same app made to read your home or
    # talk to Flatpak itself, out of its sandbox): flatpak install -y would grant it unasked. Not at boot (--fetch);
    # from Updates, which you start, only once you said yes to what it adds (ask_more), not by Update all alone. Held,
    # it's written down (held_more), for --check to say in Updates' list
    if [[ -n ${4:-} ]]; then
        more=$(more_access "$3" "$4" "$2/.metadata") ||
            { echo "$4: the access the installed version has couldn't be read, not updated" >&2; return 1; }
        if [[ -n $more && -n $fetch ]]; then
            put "$held_more" "$3" "$4" "${5:-}" "$more"
            echo "$4: its new version asks for more access ($more): update it from Updates, where you can review it" >&2
            return 1
        fi
        if [[ -n $more ]] && ! ask_more "$4" "${5:-}" "$more"; then
            put "$held_more" "$3" "$4" "${5:-}" "$more"
            echo "$4: not updated: its new version asks for more access ($more), not said yes to" >&2
            return 3
        fi
        [[ -z $more ]] || echo "$4: its new version asks for more access, said yes to: $more" >&2
    fi
    printf '%s\t%s\n' "$got" "$2/$got.flatpak"
}

# no_origin_url <user|system> <app id>: the remote flatpak made for an app installed from a file (<name>-origin) left
# with no URL. A file can carry one (flatpak build-bundle --repo-url): flatpak then sets it on that remote, and every
# flatpak update (the boot's, as root for a system-wide one) took the app from there, past every check here. With no
# URL flatpak counts the remote as disabled, as for a file without one: this script alone updates the app
no_origin_url() {
    local origin url
    origin=$(flatpak info --"$1" --show-origin "$2" 2>/dev/null) && [[ $origin == *-origin ]] || return 0
    url=$(flatpak remotes --"$1" --show-disabled --columns=name,url 2>/dev/null | awk -F'\t' -v o="$origin" '$1 == o { print $2 }')
    [[ -z $url ]] || flatpak remote-modify --"$1" --url= "$origin" </dev/null
}

# no_origin_urls <user|system>: every <name>-origin remote of that installation left with no URL, as no_origin_url
# does for one app: run before every flatpak update (auto-update's, update-kinds'), which took an app installed from a
# file before this made it again (bundle_app), or by hand, from the URL its file named. Fails when one couldn't be
# emptied (a password prompt cancelled, for the system's): the caller doesn't update that installation then
no_origin_urls() {
    local remotes name url rc=0
    remotes=$(flatpak remotes --"$1" --show-disabled --columns=name,url 2>/dev/null) || return 1
    while IFS=$'\t' read -r name url; do
        [[ $name == *-origin && -n $url ]] || continue
        flatpak remote-modify --"$1" --url= "$name" </dev/null || rc=1
    done <<<"$remotes"
    return $rc
}

# reinstall <user|system> <file> <app id>: the app reinstalled from that file: the app's own data (~/.var/app) stays.
# The old one is taken out first, so sleep and power off are held off while that runs (cut off there, the app was left
# uninstalled): only here, not for the file's download before it. Usually seconds; a runtime the new version needs and
# doesn't have yet is downloaded first from Flathub (the boot's update gives it 30 min). In a desktop session it
# takes that hold itself; the boot's update, outside any session (logind refuses it there), takes it as root around
# --install-fetched instead
reinstall() {
    # Its runtime (GNOME, KDE...) comes from Flathub in the same installation: for the user, that remote must exist too
    flatpak remote-add --"$1" --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo </dev/null
    local hold=() rt where=()
    # The runtime its metadata names (bundle_app's copy, beside the file), from Flathub, then the file with no
    # dependencies of its own: a file can name a repo for its runtime (build-bundle --runtime-repo), which flatpak
    # install -y adds as a new remote unasked, every flatpak update trusting it from then on (bundle_app's file names
    # none; --no-deps all the same). (One installed for every account counts for the user's apps too)
    rt=$(keyfile runtime 2>/dev/null <"${2%/*}/.metadata")
    [[ $rt == */*/* ]] || { echo "${2##*/}: its runtime couldn't be read, not installed" >&2; return 1; }
    [[ $1 == user ]] || where=(--system)
    flatpak info "${where[@]}" "runtime/$rt" >/dev/null 2>&1 ||
        flatpak install --"$1" -y --noninteractive flathub "runtime/$rt" </dev/null || return 1
    [[ -n ${FLATPAK_BUNDLE_HELD:-} ]] ||
        ! systemd-inhibit --what=sleep:shutdown --mode=block --who="Flatpak update" --why="Reinstalling an app" true 2>/dev/null ||
        hold=(systemd-inhibit --what=sleep:shutdown --mode=block --who="Flatpak update" --why="Reinstalling ${2##*/}")
    # (no stdin: --install-fetched reads its list there, and an app after this one was lost to it)
    "${hold[@]}" flatpak install --"$1" -y --noninteractive --no-deps --reinstall --bundle "$2" </dev/null || return 1
    no_origin_url "$1" "$3"
}

# install_from <release JSON> <user|system> [app id] [version]: download its Linux x86_64 .flatpak, verify it, install
# it (over an older one); prints the app id; exit 3 as fetch_from's. (In your cache, on disk, as update-apps' builds:
# the file and the repo it's read into, about twice the app's size, in /tmp took memory)
install_from() {
    local tmp got ok=0 cache=${XDG_CACHE_HOME:-$HOME/.cache}
    mkdir -p "$cache" || return 1
    # (one a run cut off left there (logged out or shut down mid-update, a power cut: nothing took it away), twice the
    # app's size kept in your cache for good: its own folders alone, by their mktemp name, hours old, taken away)
    find "$cache" -mindepth 1 -maxdepth 1 -type d -name 'agros-flatpak.??????' -mmin +360 -exec rm -rf {} + 2>/dev/null
    tmp=$(mktemp -d "$cache/agros-flatpak.XXXXXX") || return 1
    got=$(fetch_from "$1" "$tmp" "$2" "${3:-}" "${4:-}") || ok=$?
    ((ok)) || { reinstall "$2" "${got#*$'\t'}" "${got%%$'\t'*}" >&2 && echo "${got%%$'\t'*}"; } || ok=1
    rm -rf "${tmp:?}"
    return $ok
}

# The repo each app was installed or first updated from: "<user|system>\t<app id>\t<owner/repo>" lines
if ((EUID)); then bundles=${XDG_STATE_HOME:-$HOME/.local/state}/agros/flatpak-bundles; else bundles=/var/lib/agros/flatpak-bundles; fi
bundles=${AGROS_FLATPAK_BUNDLES:-$bundles}
# put <file> <user|system> <app id> <value>...: that app's line in a list of these, in place of its last (failing, a
# read-only disk: not kept)
put() {
    local f=$1
    shift
    mkdir -p "${f%/*}" 2>/dev/null &&
        { awk -F'\t' -v i="$1" -v a="$2" '!($1 == i && $2 == a)' "$f" 2>/dev/null; (IFS=$'\t'; printf '%s\n' "$*"); } >"$f.new" &&
        mv -f "$f.new" "$f" || rm -f "$f.new" 2>/dev/null
    return 0
}
# remember <user|system> <app id> <owner/repo> (failing: looked up from the metainfo again next time)
remember() { put "$bundles" "$@"; }
# The updates held for asking for more access (at boot, or said no to in Updates): "<user|system>\t<app id>\t<version>\t
# <what it adds>" lines. held_noted <user|system> <app id> <version>: what that one adds, as written down (a system-wide
# one's by root's boot run too)
held_more=$bundles.access
held_noted() {
    local f files=("$held_more")
    [[ $1 != system ]] || files+=(/var/lib/agros/flatpak-bundles.access)
    for f in "${files[@]}"; do
        awk -F'\t' -v i="$1" -v a="$2" -v v="$3" '$1 == i && $2 == a && $3 == v { print $4; found = 1; exit } END { exit !found }' "$f" 2>/dev/null &&
            return 0
    done
    return 1
}
# repo_of <app id> <user|system>: the GitHub owner/repo of an app installed from a file: as written down, else from
# the app's own metainfo (<id>.metainfo.xml, else any), its own links only: source, home page, then bug tracker or help
# (ArtCraft's names its repo only there: its home page is its website), never another github.com link in it (a
# library's, a translator's); written down then
repo_of() {
    local loc meta type repo
    repo=$(awk -F'\t' -v i="$2" -v a="$1" '$1 == i && $2 == a { print $3; exit }' "$bundles" 2>/dev/null)
    [[ -z $repo ]] || { echo "$repo"; return 0; }
    loc=$(flatpak info --"$2" --show-location "$1" 2>/dev/null) || return 1
    meta=("$loc"/files/share/metainfo/"$1".{metainfo,appdata}.xml)
    [[ -e ${meta[0]} || -e ${meta[1]} ]] || meta=("$loc"/files/share/metainfo/*.xml)
    for type in vcs-browser homepage bugtracker help; do
        repo=$(grep -ohE "<url type=\"$type\">https?://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+" "${meta[@]}" 2>/dev/null |
            sed -E 's|.*github\.com/||; s|\.git$||; q')
        [[ -n $repo ]] && break
    done
    [[ -n $repo ]] || return 1
    remember "$2" "$1" "$repo"
    echo "$repo"
}

if [[ ${1:-} == --no-origin-urls ]]; then
    shift
    for inst; do no_origin_urls "$inst" || status=1; done
    exit $status
fi

if [[ ${1:-} == --install-fetched ]]; then
    # (each "<user|system>\t<file>\t<app id>\t<version>", as --fetch listed them)
    while IFS=$'\t' read -r inst file app new; do
        # (its caller holds sleep and power off: the boot's update, as root)
        if FLATPAK_BUNDLE_HELD=1 reinstall "$inst" "$file" "$app"; then echo "$app: updated to $new"; else status=1; fi
    done <"${2:?--install-fetched <dir>}/fetched"
    exit $status
fi

if [[ ${1:-} == --install ]]; then
    # Already installed from a file (its repo found as the update below finds it): updates do the rest. The repo
    # exactly, whatever the case: owner/repo-other isn't it, nor a Flathub app whose metainfo links to it
    # (owner/repo.git is owner/repo: repo_of's form, without .git, both compared and written down)
    want=${2:?owner/repo} want=${want%.git}
    while IFS=$'\t' read -r app origin inst; do
        [[ $origin == *-origin ]] || continue
        repo=$(repo_of "$app" "$inst") || continue
        [[ ${repo,,} == "${want,,}" ]] && { echo "$2: already installed"; exit 0; }
    done < <(flatpak list --app --columns=application,origin,installation)
    api=$(latest_release "$want") || { echo "$2: can't reach GitHub"; exit 1; }
    # (the repo it came from written down for its updates)
    app=$(install_from "$api" user) || exit 1
    remember user "$app" "$want"
    echo "$2: installed $(jq -r .tag_name <<<"$api")"
    exit
fi

while IFS=$'\t' read -r app origin inst; do
    [[ $origin == *-origin ]] || continue # installed from a file: Flatpak names its remote "<name>-origin"
    # (the boot's per-user downloads: a system-wide one is root's, reinstalled once by the boot's own run, as root;
    # as each user it was downloaded per user and refused at the reinstall, every boot)
    [[ -n $fetch && $inst == system && $EUID -ne 0 ]] && continue
    # (one installed before its remote's URL was emptied at its install, no_origin_url: emptied now)
    $check || no_origin_url "$inst" "$app"
    repo=$(repo_of "$app" "$inst") || { echo "$app: no GitHub repo among its metainfo's own links, skipped"; continue; }
    old=$(LC_ALL=C flatpak info --"$inst" "$app" | sed -n 's/^ *Version: //p')
    # No version to compare: any release would look newer, reinstalled on every run
    [[ -n $old ]] || { echo "$app: no version, skipped"; continue; }
    api=$(latest_release "$repo") || { echo "$app: can't reach GitHub"; status=1; continue; }
    new=$(jq -r '.tag_name' <<<"$api")
    new=${new#v}
    if ! newer "$new" "$old"; then
        echo "$app: up to date ($old)"
        continue
    fi
    # (its files still uploading, or none for Linux: not announced as an update that then fails to install)
    [[ -n $(asset_url "$api" flatpak) ]] || { echo "$app: no Linux .flatpak in the latest release ($new)"; status=1; continue; }
    if $check; then
        # (one held for asking for more access: said so, in Updates' list too)
        adds=$(held_noted "$inst" "$app" "$new") && adds=" (asks for more access: $adds)" || adds=
        echo "$app: update available ($old -> $new$adds)"
        continue
    fi
    if [[ -n $fetch ]]; then
        mkdir -p "$fetch/$app"
        if got=$(fetch_from "$api" "$fetch/$app" "$inst" "$app" "$new"); then
            printf '%s\t%s\t%s\t%s\n' "$inst" "${got#*$'\t'}" "$app" "$new" >>"$fetch/fetched"
            echo "$app: $new downloaded"
        else
            status=1
        fi
    else
        install_from "$api" "$inst" "$app" "$new" >/dev/null
        case $? in
            0) echo "$app: updated to $new" ;;
            3) ;; # (more access, not said yes to: said, not a failure)
            *) status=1 ;;
        esac
    fi
done < <(flatpak list --app --columns=application,origin,installation)
exit $status

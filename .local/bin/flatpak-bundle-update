#!/usr/bin/env bash
# Updates the Flatpaks installed from a downloaded .flatpak file (e.g. ArtCraft Launcher), which have no Flatpak repo
# to update from, from the GitHub releases their metadata links to (update-kinds' flatpak, from the
# Updates app; the boot-time auto-update's --fetch and --install-fetched).
#   flatpak-bundle-update           update them
#   flatpak-bundle-update --check   only list the ones with a newer version ("<app id>: update available (<old> -> <new>)")
#   flatpak-bundle-update --install <owner/repo>   install one for the user from its latest release (agros-welcome)
#   flatpak-bundle-update --fetch <dir>              only download the updates' files into dir (listed in dir/fetched);
#                                                    as a user, only their own: the system-wide ones are root's
#   flatpak-bundle-update --install-fetched <dir>    reinstall from those (the boot's update: it holds sleep and power
#                                                    off as root around this step alone, logind refusing it to a user
#                                                    outside a session)
# Takes the latest release's Linux x86_64 .flatpak, checked against the release's SHA256SUMS when it has one (a
# system-wide one only when it has one), and only when the file is that app (its ref). Each app's repo is the one it was
# installed from (--install), else its metainfo's own link to it the first time it's looked for (repo_of), written down
# (AGROS_FLATPAK_BUNDLES: the tests' list) and kept: a later version's metainfo can't point its updates elsewhere.
set -uo pipefail
check=false fetch=
[[ ${1:-} == --check ]] && check=true
[[ ${1:-} == --fetch ]] && fetch=${2:?--fetch <dir>}
status=0
source "$(dirname "$(readlink -f "$0")")/../share/github-release/lib.sh"

# newer <new> <old>: new is a later version. sort -V puts 0.1.33-alpha after 0.1.33: a release over the pre-release
# with the same number counts as newer
newer() {
    [[ $1 == "$2" ]] && return 1
    local nb=${1%%-*} ob=${2%%-*}
    if [[ $nb == "$ob" && ($1 == *-* || $2 == *-*) && ! ($1 == *-* && $2 == *-*) ]]; then
        [[ $1 != *-* ]]
        return
    fi
    [[ $(printf '%s\n' "$1" "$2" | sort -V | tail -1) == "$1" ]]
}

# bundle_app <file> <dir>: the app a .flatpak file installs (its ref, read by flatpak itself into a repo of its own in
# dir, nothing installed)
bundle_app() {
    local repo ref
    repo=$(mktemp -d "$2/.ref.XXXXXX") && ostree init --repo="$repo" --mode=archive >/dev/null 2>&1 &&
        flatpak build-import-bundle "$repo" "$1" >/dev/null 2>&1 && ref=$(ostree refs --repo="$repo" 2>/dev/null) || return 1
    ref=$(grep -m1 '^app/' <<<"$ref") && ref=${ref#app/} && [[ -n ${ref%%/*} ]] && echo "${ref%%/*}"
}

# fetch_from <release JSON> <dir> <user|system> [app id]: download its Linux x86_64 .flatpak into dir, verified (by
# the release's checksums, required for a system-wide one; and that it's the app given); prints "<app id>\t<path>"
fetch_from() {
    local url want file got need=()
    url=$(asset_url "$1" flatpak)
    [[ -n $url ]] || { echo "no Linux .flatpak in the latest release" >&2; return 1; }
    [[ $3 != system ]] || need=(required)
    want=$(checksum "$1" "${url##*/}" "$2" "${need[@]}") && download "$url" "$2" "$want" >&2 || return 1
    file=$2/${url##*/}
    got=$(bundle_app "$file" "$2") || { echo "${url##*/}: which app it is couldn't be read, not installed" >&2; return 1; }
    [[ -z ${4:-} || $got == "$4" ]] || { echo "${url##*/} is $got, not $4: not installed" >&2; return 1; }
    printf '%s\t%s\n' "$got" "$file"
}

# reinstall <user|system> <file>: the app reinstalled from that file: the app's own data (~/.var/app) stays. The old one
# is taken out first, so sleep and power off are held off while that runs (cut off there, the app was left
# uninstalled): only here, not for the file's download before it. Usually seconds; a runtime the new version needs and
# doesn't have yet is downloaded in it from Flathub too (the boot's update gives it 30 min). In a desktop session it
# takes that hold itself; the boot's update, outside any session (logind refuses it there), takes it as root around
# --install-fetched instead
reinstall() {
    # Its runtime (GNOME, KDE...) comes from Flathub in the same installation: for the user, that remote must exist too
    flatpak remote-add --"$1" --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo </dev/null
    local hold=()
    [[ -n ${FLATPAK_BUNDLE_HELD:-} ]] ||
        ! systemd-inhibit --what=sleep:shutdown --mode=block --who="Flatpak update" --why="Reinstalling an app" true 2>/dev/null ||
        hold=(systemd-inhibit --what=sleep:shutdown --mode=block --who="Flatpak update" --why="Reinstalling ${2##*/}")
    # (no stdin: --install-fetched reads its list there, and an app after this one was lost to it)
    "${hold[@]}" flatpak install --"$1" -y --noninteractive --reinstall --bundle "$2" </dev/null
}

# install_from <release JSON> <user|system> [app id]: download its Linux x86_64 .flatpak, verify it, install it (over an
# older one); prints the app id
install_from() {
    local tmp got ok=0
    tmp=$(mktemp -d)
    got=$(fetch_from "$1" "$tmp" "$2" "${3:-}") && reinstall "$2" "${got#*$'\t'}" >&2 && echo "${got%%$'\t'*}" || ok=1
    rm -rf "${tmp:?}"
    return $ok
}

# The repo each app was installed or first updated from: "<user|system>\t<app id>\t<owner/repo>" lines
if ((EUID)); then bundles=${XDG_STATE_HOME:-$HOME/.local/state}/agros/flatpak-bundles; else bundles=/var/lib/agros/flatpak-bundles; fi
bundles=${AGROS_FLATPAK_BUNDLES:-$bundles}
# remember <user|system> <app id> <owner/repo> (failing, a read-only disk: looked up from the metainfo again next time)
remember() {
    mkdir -p "${bundles%/*}" 2>/dev/null &&
        { awk -F'\t' -v i="$1" -v a="$2" '!($1 == i && $2 == a)' "$bundles" 2>/dev/null; printf '%s\t%s\t%s\n' "$@"; } >"$bundles.new" &&
        mv -f "$bundles.new" "$bundles" || rm -f "$bundles.new" 2>/dev/null
    return 0
}
# repo_of <app id> <user|system>: the GitHub owner/repo of an app installed from a file: as written down, else from
# the app's own metainfo (<id>.metainfo.xml, else any), its own links only: source, home page, then bug tracker or help
# (ArtCraft's names its repo only there: its home page is its website), never another github.com link in it (a
# library's, a translator's); written down then
repo_of() {
    local loc meta type repo
    repo=$(awk -F'\t' -v i="$2" -v a="$1" '$1 == i && $2 == a { print $3; exit }' "$bundles" 2>/dev/null)
    [[ -z $repo ]] || { echo "$repo"; return 0; }
    loc=$(flatpak info --"$2" --show-location "$1" 2>/dev/null) || return 1
    meta=("$loc"/files/share/metainfo/"$1".{metainfo,appdata}.xml)
    [[ -e ${meta[0]} || -e ${meta[1]} ]] || meta=("$loc"/files/share/metainfo/*.xml)
    for type in vcs-browser homepage bugtracker help; do
        repo=$(grep -ohE "<url type=\"$type\">https?://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+" "${meta[@]}" 2>/dev/null |
            sed -E 's|.*github\.com/||; s|\.git$||; q')
        [[ -n $repo ]] && break
    done
    [[ -n $repo ]] || return 1
    remember "$2" "$1" "$repo"
    echo "$repo"
}

if [[ ${1:-} == --install-fetched ]]; then
    # (each "<user|system>\t<file>\t<app id>\t<version>", as --fetch listed them)
    while IFS=$'\t' read -r inst file app new; do
        # (its caller holds sleep and power off: the boot's update, as root)
        if FLATPAK_BUNDLE_HELD=1 reinstall "$inst" "$file"; then echo "$app: updated to $new"; else status=1; fi
    done <"${2:?--install-fetched <dir>}/fetched"
    exit $status
fi

if [[ ${1:-} == --install ]]; then
    # Already installed from a file (its repo found as the update below finds it): updates do the rest. The repo
    # exactly, whatever the case: owner/repo-other isn't it, nor a Flathub app whose metainfo links to it
    : "${2:?owner/repo}"
    while IFS=$'\t' read -r app origin inst; do
        [[ $origin == *-origin ]] || continue
        repo=$(repo_of "$app" "$inst") || continue
        [[ ${repo,,} == "${2,,}" ]] && { echo "$2: already installed"; exit 0; }
    done < <(flatpak list --app --columns=application,origin,installation)
    api=$(latest_release "$2") || { echo "$2: can't reach GitHub"; exit 1; }
    # (the repo it came from written down for its updates)
    app=$(install_from "$api" user) || exit 1
    remember user "$app" "${2%.git}"
    echo "$2: installed $(jq -r .tag_name <<<"$api")"
    exit
fi

while IFS=$'\t' read -r app origin inst; do
    [[ $origin == *-origin ]] || continue # installed from a file: Flatpak names its remote "<name>-origin"
    # (the boot's per-user downloads: a system-wide one is root's, reinstalled once by the boot's own run, as root;
    # as each user it was downloaded per user and refused at the reinstall, every boot)
    [[ -n $fetch && $inst == system && $EUID -ne 0 ]] && continue
    repo=$(repo_of "$app" "$inst") || { echo "$app: no GitHub repo among its metainfo's own links, skipped"; continue; }
    old=$(LC_ALL=C flatpak info --"$inst" "$app" | sed -n 's/^ *Version: //p')
    # No version to compare: any release would look newer, reinstalled on every run
    [[ -n $old ]] || { echo "$app: no version, skipped"; continue; }
    api=$(latest_release "$repo") || { echo "$app: can't reach GitHub"; status=1; continue; }
    new=$(jq -r '.tag_name' <<<"$api")
    new=${new#v}
    if ! newer "$new" "$old"; then
        echo "$app: up to date ($old)"
        continue
    fi
    # (its files still uploading, or none for Linux: not announced as an update that then fails to install)
    [[ -n $(asset_url "$api" flatpak) ]] || { echo "$app: no Linux .flatpak in the latest release ($new)"; status=1; continue; }
    if $check; then
        echo "$app: update available ($old -> $new)"
        continue
    fi
    if [[ -n $fetch ]]; then
        mkdir -p "$fetch/$app"
        if got=$(fetch_from "$api" "$fetch/$app" "$inst" "$app"); then
            printf '%s\t%s\t%s\t%s\n' "$inst" "${got#*$'\t'}" "$app" "$new" >>"$fetch/fetched"
            echo "$app: $new downloaded"
        else
            status=1
        fi
    elif install_from "$api" "$inst" "$app" >/dev/null; then
        echo "$app: updated to $new"
    else
        status=1
    fi
done < <(flatpak list --app --columns=application,origin,installation)
exit $status

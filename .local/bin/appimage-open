#!/usr/bin/env python3
"""Opens AppImages: installs the app (or the new version of it) and starts it.

AppImages open with this (mimeapps.list), so an app's own "Update" button, which downloads the new
AppImage and opens it, updates the app by itself: the file goes to ~/Applications/<app>.AppImage in place of
the old version (which is closed first), the launcher entry and icon come from inside the AppImage, and the
app starts again. An AppImage without a launcher entry inside just runs. When installing (--install: appimage-update,
not a file you open) the first time, a system package with the same launcher entry (the app installed another way
before, e.g. from the AUR) is removed, asking for your password, so there's one copy; its updates must keep that
launcher entry. A file you open is asked about first (it runs as you), and read without running it where it can be
(unsquashfs); one whose launcher entry is another app's (an installed app's, or a file of yours) isn't installed.

  appimage-open <file.AppImage>             install/update and start it
  appimage-open --install <file.AppImage>   install/update only (appimage-update)
"""
import atexit
import os
import re
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import time

HOME = os.path.expanduser("~")
APPS = f"{HOME}/Applications"
ENTRIES = f"{HOME}/.local/share/applications"
ICONS = f"{HOME}/.local/share/icons"


def squashfs_offset(appimage: str) -> int | None:
    """Where its files (a squashfs image) start: right after its ELF runtime, at the end of the ELF's section headers.
    None when it isn't laid out so (not an ELF, or no squashfs there: another kind of AppImage)"""
    try:
        with open(appimage, "rb") as f:
            head = f.read(64)
            if len(head) < 64 or head[:4] != b"\x7fELF" or head[4] not in (1, 2) or head[5] not in (1, 2):
                return None
            e = "<" if head[5] == 1 else ">"
            if head[4] == 2:
                shoff, = struct.unpack(e + "Q", head[0x28:0x30])
                shentsize, shnum = struct.unpack(e + "HH", head[0x3A:0x3E])
            else:
                shoff, = struct.unpack(e + "I", head[0x20:0x24])
                shentsize, shnum = struct.unpack(e + "HH", head[0x2E:0x32])
            offset = shoff + shentsize * shnum
            f.seek(offset)
            return offset if f.read(4) == b"hsqs" else None
    except (OSError, struct.error):
        return None


def extract(appimage: str, pattern: str, into: str, run: bool = True) -> None:
    """Its files matching the pattern (one per path part) into <into>/squashfs-root, links as links. Read by unsquashfs,
    the AppImage never run for it; only where that can't be (no squashfs-tools, another kind of AppImage) by its own
    --appimage-extract, which runs it: by then you've said to run it (ask_to_run), or it's an install from the GitHub
    release you picked (appimage-update). run=False: nothing then (ask_to_run's look before you're asked)"""
    offset = squashfs_offset(appimage)
    if offset is not None and shutil.which("unsquashfs"):
        cmd = ["unsquashfs", "-q", "-n", "-f", "-o", str(offset), "-d", f"{into}/squashfs-root", appimage, pattern]
    elif run:
        cmd = [appimage, "--appimage-extract", pattern]
    else:
        return
    # (one that doesn't run here or hangs: nothing extracted, so "no launcher entry", not a traceback)
    try:
        subprocess.run(cmd, cwd=into, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        pass


def ask_to_run(src: str) -> bool:
    """You said to run it (zenity), before it's made runnable or run: a file you opened, from a download or a stick.
    Not asked for one in ~/Applications (installed), nor the new version an installed app's own Update button opens:
    the same app (its launcher entry's id, read by unsquashfs, never run) as the installed AppImage it's opened from
    (its APPIMAGE). Any other file opened from that app (a download, a link), or from what it started (a terminal's
    shell, which inherits APPIMAGE too), is asked about. No answer (no zenity, no desktop): not run"""
    if os.path.realpath(src).startswith(os.path.realpath(APPS) + "/"):
        return True
    running = os.environ.get("APPIMAGE", "")
    if running and os.path.realpath(running).startswith(os.path.realpath(APPS) + "/"):
        with tempfile.TemporaryDirectory() as tmp:
            found = entry_of(src, tmp, run=False)
        if found and os.path.realpath(f"{APPS}/{found[0].lower()}.AppImage") == os.path.realpath(running):
            return True
    try:
        return subprocess.run(["zenity", "--question", "--no-markup", "--title=Run this AppImage?", "--ok-label=Run",
                               "--cancel-label=Cancel", f"--text={os.path.basename(src)} is a program: it runs as you, "
                               "with your files. Run it (and install it in ~/Applications) only if you trust where it "
                               "came from."], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    except OSError:
        return False


def clashing_entry(app: str, install_only: bool) -> str:
    """Another launcher entry with this id ("" when none): a file of yours in ~/.local/share/applications (not one this
    made), which this would write over; else, opening a file, an installed app's (an AppImage naming itself
    librewolf.desktop would take LibreWolf's place in the menu, the dock and as the default browser). Installing
    (appimage-update), a system package's copy is removed instead (remove_package_copy)"""
    mine = f"{ENTRIES}/{app}.desktop"
    if os.path.exists(mine):
        made = "# Made by ~/.local/bin/appimage-open" in open(mine, errors="replace").read()
        return "" if made else mine
    if install_only:
        return ""
    dirs = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    for d in [*dirs.split(":"), f"{HOME}/.local/share/flatpak/exports/share", "/var/lib/flatpak/exports/share"]:
        if d and os.path.exists(f"{d}/applications/{app}.desktop"):
            return f"{d}/applications/{app}.desktop"
    return ""


# (a pattern's characters for unsquashfs and --appimage-extract: in a name read from the AppImage, more of it extracted)
GLOB = re.compile(r"[][*?\\]")


def installed_ids(website: str) -> set[str]:
    """The ids (lowercased) of the AppImages this installed from that GitHub repo (their entries' X-AppImage-Website):
    an update's (appimage-update) is one of them"""
    def norm(url: str) -> str:
        return url.strip().removesuffix("/").removesuffix(".git").lower()
    ids = set()
    if not website or not os.path.isdir(ENTRIES):
        return ids
    for f in os.listdir(ENTRIES):
        try:
            text = open(f"{ENTRIES}/{f}", errors="replace").read() if f.endswith(".desktop") else ""
        except OSError:
            continue
        site = re.search(r"^X-AppImage-Website=(.+)$", text, re.M)
        if ("# Made by ~/.local/bin/appimage-open" in text and re.search(r"^X-AppImage-Path=", text, re.M)
                and site and norm(site.group(1)) == norm(website)):
            ids.add(f.removesuffix(".desktop").lower())
    return ids


def resolve(appimage: str, tmp: str, name: str, run: bool = True) -> str:
    """The extracted file <name> in tmp, with what it links to extracted too: linuxdeploy's AppImages have their launcher
    entry and icon at the top as links into usr/share, and extracting a link extracts only the link. "" when it ends
    outside what was extracted (a link to /home/... or ../.., itself or through a folder that's a link: read, then copied
    into your icons, it was a file of yours) or names a pattern"""
    root = os.path.realpath(f"{tmp}/squashfs-root")
    path = f"{tmp}/squashfs-root/{name}"
    for _ in range(8):
        if not os.path.islink(path):
            break
        name = os.path.normpath(os.path.join(os.path.dirname(name), os.readlink(path)))
        if name.startswith(("/", "..")) or GLOB.search(name):  # (outside the AppImage, or a pattern)
            return ""
        extract(appimage, name, tmp, run)
        path = f"{tmp}/squashfs-root/{name}"
    return path if os.path.realpath(path).startswith(root + "/") else ""


def entry_of(appimage: str, tmp: str, run: bool = True) -> tuple[str, str, str] | None:
    """(app id, launcher entry text, icon file in tmp or "") from inside the AppImage (run=False: as extract's)."""
    extract(appimage, "*.desktop", tmp, run)
    root = f"{tmp}/squashfs-root"
    desktops = [f for f in os.listdir(root) if f.endswith(".desktop")] if os.path.isdir(root) else []
    if not desktops:
        return None
    entry = resolve(appimage, tmp, desktops[0], run)
    if not os.path.isfile(entry):
        return None
    text = open(entry).read()
    app = desktops[0].removesuffix(".desktop")  # its own case: a package's entry and dock pins use it
    icon = ""
    name = re.search(r"^Icon=(.+)$", text, re.M)
    # (an icon's name only: a path or a pattern (Icon=../../.ssh/id_ed25519, Icon=*) read outside it, or all of it)
    if name and not re.search(r"/|\.\.", name.group(1)) and not GLOB.search(name.group(1)):
        for ext in ("png", "svg"):
            extract(appimage, f"{name.group(1)}.{ext}", tmp, run)
            found = resolve(appimage, tmp, f"{name.group(1)}.{ext}", run)
            if os.path.isfile(found):
                icon = found
                break
    return app, text, icon


def close_running(path: str) -> None:
    """Closes running copies of the installed AppImage (the old version), so the new one starts alone."""
    pids = []
    # Not this one, nor what started it (an app's Update button opens the new file through xdg-open, which, and this,
    # inherit the app's APPIMAGE), but the app itself among those: its program runs from its mount (/tmp/.mount_...)
    mine, p = set(), os.getpid()
    while p > 1 and p not in mine:
        try:
            exe = os.readlink(f"/proc/{p}/exe")
        except OSError:
            exe = ""
        if "/.mount_" not in exe:
            mine.add(p)
        try:
            p = int(open(f"/proc/{p}/stat").read().rsplit(")", 1)[1].split()[1])
        except (OSError, IndexError, ValueError):
            break
    for pid in filter(str.isdigit, os.listdir("/proc")):
        if int(pid) in mine:
            continue
        try:
            env = open(f"/proc/{pid}/environ", "rb").read().split(b"\0")
        except OSError:
            continue
        # The app's own processes only (run from its mount, or the file itself), not what it started (a browser opened
        # from a link, a terminal app's shells): those inherit APPIMAGE too
        try:
            exe = os.readlink(f"/proc/{pid}/exe")
        except OSError:
            continue
        if f"APPIMAGE={path}".encode() in env and ("/.mount_" in exe or exe == path):
            pids.append(int(pid))
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    for _ in range(50):
        if not any(os.path.exists(f"/proc/{p}") for p in pids):
            return
        time.sleep(0.1)


def notify(*args: str) -> None:
    """notify-when-up (beside this), in the background: from the boot's update the notification server may not be up
    yet, and nothing here waits on it"""
    subprocess.Popen([f"{os.path.dirname(os.path.realpath(__file__))}/notify-when-up", *args], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def remove_package_copy(app: str) -> None:
    """Removes the system package that installs the same app (same launcher entry), if there's one."""
    owner = subprocess.run(["pacman", "-Qqo", f"/usr/share/applications/{app}.desktop"], capture_output=True, text=True)
    pkg = owner.stdout.strip()
    if owner.returncode != 0 or not pkg:
        return
    cmd = ["pacman", "-R", "--noconfirm", pkg]  # just it: its dependencies may be yours too
    # sudo when it doesn't need asking, otherwise the desktop's password dialog (--install: appimage-update, from the
    # boot auto-update and the Updates app)
    sudo = subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0
    if subprocess.run((["sudo", "-n"] if sudo else ["pkexec"]) + cmd, capture_output=True).returncode == 0:
        notify("-a", "AppImage", f"Removed the {pkg} package (the AppImage replaces it)")


def main() -> None:
    # The old app may be the terminal this runs in (updating it from inside): closing it mustn't end this before the new
    # one is in place
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    args = sys.argv[1:]
    install_only = args[:1] == ["--install"]
    args = args[1:] if install_only else args
    if len(args) != 1 or not os.path.isfile(args[0]):
        sys.exit(__doc__)
    src = os.path.abspath(args[0])
    if not install_only and not ask_to_run(src):
        sys.exit(0)
    # Made executable. On a drive that won't run it (a USB stick's FAT, a read-only or noexec mount; a file not yours):
    # a copy of it in ~/Applications, which becomes the installed file or, with no launcher entry inside, is what runs
    # (it failed, a traceback no one saw, nothing installed or started). Under a name of its own, hidden: under the
    # file's, it wrote over an installed app of that name before anything was checked. Not installed, taken out again
    try:
        os.chmod(src, os.stat(src).st_mode | 0o111)
    except OSError:
        pass
    if not os.access(src, os.X_OK):
        os.makedirs(APPS, exist_ok=True)
        copy = f"{APPS}/.{os.path.basename(src)}.copy"
        shutil.copyfile(src, f"{copy}.new")
        os.chmod(f"{copy}.new", 0o755)
        os.replace(f"{copy}.new", copy)
        atexit.register(lambda: os.path.exists(copy) and os.remove(copy))  # (installed: moved, nothing left)
        src = copy

    with tempfile.TemporaryDirectory() as tmp:
        found = entry_of(src, tmp)
        if not found:
            if not install_only:
                shutil.rmtree(tmp, ignore_errors=True)  # exec leaves the with block without cleaning up
                signal.signal(signal.SIGHUP, signal.SIG_DFL)  # the app itself ends with its terminal as usual
                os.execv(src, [src])
            sys.exit(f"{src}: no launcher entry inside, not installed")
        app, text, icon = found
        # An update (appimage-update, at boot or in Updates: that repo's AppImage installed already) only as the same app:
        # a release naming its entry firefox.desktop took Firefox's place in the menu and as a default app, and asked to
        # remove its package (remove_package_copy: a first install's alone)
        before = installed_ids(os.environ.get("APPIMAGE_WEBSITE", "")) if install_only else set()
        if before and app.lower() not in before:
            notify("-a", "AppImage", "-i", "dialog-warning", f"{os.path.basename(src)} not installed",
                   f"Its launcher entry is now {app}.desktop, not the app's own ({', '.join(sorted(before))})")
            sys.exit(f"{src}: its launcher entry is now {app}.desktop, not the installed app's "
                     f"({', '.join(sorted(before))}): not installed")
        clash = clashing_entry(app, install_only)
        if clash:
            notify("-a", "AppImage", "-i", "dialog-warning", f"{os.path.basename(src)} not installed",
                   f"Its launcher entry, {app}.desktop, is already another app's ({clash})")
            sys.exit(f"{src}: its launcher entry {app}.desktop is already another app's ({clash}): not installed")
        dest = f"{APPS}/{app.lower()}.AppImage"
        updating = os.path.exists(dest) and src != dest
        os.makedirs(APPS, exist_ok=True)
        if src != dest:
            # Not for an update in the background (appimage-update): the app would just vanish, not come back. The
            # running copy keeps its mounted old file; the new one is used from its next start
            if not install_only:
                close_running(dest)
            shutil.move(src, f"{dest}.new")
            os.replace(f"{dest}.new", dest)
        if icon:
            os.makedirs(ICONS, exist_ok=True)
            icon_path = f"{ICONS}/{app}-appimage{os.path.splitext(icon)[1]}"
            shutil.copy(icon, icon_path)
            text = re.sub(r"^Icon=.*$", f"Icon={icon_path}", text, flags=re.M)

    # The launcher entry: the AppImage's own, run from ~/Applications (same id as e.g. a package's, so pins stay)
    # (quoted as the launcher entry format wants when the path has a space, a home folder's: else it ran "/home/a")
    exe = f'"{dest}"' if re.search(r"\s", dest) else dest
    text = re.sub(r'^Exec=("[^"]*"|\S+)', lambda m: f"Exec={exe}", text, flags=re.M)  # a quoted program too
    text = re.sub(r"^TryExec=.*\n", "", text, flags=re.M)
    text = text.rstrip("\n") + f"\nX-AppImage-Path={dest}\n"
    # Where appimage-update finds new versions (it says, installing from a GitHub release; few AppImages carry it)
    # (an update from the app's own button has no APPIMAGE_WEBSITE: the one the installed entry has)
    website = os.environ.get("APPIMAGE_WEBSITE", "")
    for entry in (f"{ENTRIES}/{app}.desktop", f"{ENTRIES}/{app.lower()}.desktop"):
        if not website and os.path.exists(entry):
            found = re.search(r"^X-AppImage-Website=(.+)$", open(entry).read(), re.M)
            website = found.group(1) if found else ""
    if website and not re.search(r"^X-AppImage-Website=", text, re.M):
        text += f"X-AppImage-Website={website}\n"
    text += "# Made by ~/.local/bin/appimage-open\n"
    os.makedirs(ENTRIES, exist_ok=True)
    # An older install's entry under the lowercased id (before entries kept the app's case)
    old = f"{ENTRIES}/{app.lower()}.desktop"
    if app != app.lower() and os.path.exists(old) and "# Made by ~/.local/bin/appimage-open" in open(old).read():
        os.remove(old)
    open(f"{ENTRIES}/{app}.desktop", "w").write(text)
    subprocess.run(["update-desktop-database", ENTRIES], capture_output=True)
    # Only when asked to install, the first time: any AppImage you open could name a package's entry (firefox.desktop...)
    if install_only and not before:
        remove_package_copy(app)

    name = re.search(r"^Name=(.+)$", text, re.M)
    if src != dest or install_only:  # (not the installed file itself opened, e.g. from a file manager: nothing new)
        notify("-a", "AppImage", "-i", icon_path if icon else "application-x-executable",
               f"{name.group(1) if name else app} {'updated' if updating else 'installed'}")
    if not install_only:
        subprocess.Popen([dest], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         preexec_fn=lambda: signal.signal(signal.SIGHUP, signal.SIG_DFL))  # not this one's SIGHUP ignore


if __name__ == "__main__":
    main()

#!/bin/sh
# Opens Settings at its Updates page (Caelestia's Nexus: caelestia-overlay's settings_open_at). The Super menu's "Update
# apps" runs this (from Caelestia's shell.json, yours: copied in once, so one from before still names this). The Updates
# app it opened before is gone, a page of Settings now
exec qs -c caelestia ipc call nexus openPage update

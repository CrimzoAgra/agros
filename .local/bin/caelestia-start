#!/usr/bin/env bash
# Starts Caelestia's shell at login on AgrOS's changes to it: Caelestia's own execs.lua runs this in place of its
# "caelestia shell -d" (agros-hyprland-settings). The changes (~/.config/quickshell/caelestia, caelestia-overlay) are
# built first when they're missing or out of date, so the first login comes up with the dock and the bar as they stay,
# not on Caelestia's own config, rebuilt and restarted under you a minute later (agros-welcome). Under the overlay's own
# lock: agros-welcome's build at that login waits for this one.
# What happened is logged (~/.local/state/agros/caelestia-start.log): at login there's no terminal, and a shell that
# didn't come up left nothing to go by
# --prepare (caelestia-prepare.service, as the session starts, while Hyprland is still starting): only the build and
# the first wallpaper and colours, done, so this run at Hyprland's start finds them done and starts the shell at once
log=${XDG_STATE_HOME:-$HOME/.local/state}/agros/caelestia-start.log
helpers=$(dirname "$(readlink -f "$0")")  # (the shared helpers, beside this)
mkdir -p "${log%/*}"
# Under the overlay's lock until the shell is up: an update's rebuild under way as you log in waited for, and one
# waiting finds the shell running and hands over to caelestia-restart (not the folder swapped under it as it starts).
# The prepare run's too: this run waits for it to finish rather than build alongside it
mkdir -p "$HOME/.config/quickshell"
exec 9>"$HOME/.config/quickshell/caelestia.lock"
flock 9
# (the last 200 lines kept: it's added to at every login, twice)
[[ -f $log ]] && tail -n 200 "$log" >"$log.tmp" && mv -f "$log.tmp" "$log"
prepare=
if [[ ${1:-} == --prepare ]]; then
    prepare=1
    # (a shell already up, from this folder: a build here would swap it under it; caelestia-overlay's own run hands
    # that to caelestia-restart)
    "$helpers/qs-running" /quickshell/caelestia/shell.qml && exit 0
fi
{
    echo "== $(date '+%F %T')${prepare:+ (ahead of the desktop)}"
    # The first time: Caelestia's wallpaper and its colours set before the shell starts (agros-welcome's mark, so it
    # doesn't again). Set after, the shell had already shown its fallback and kept it, its colours from another
    # wallpaper, and Qt's settings (icon theme) appeared after it had looked for them: Papirus never applied. Alongside
    # the build (neither needs the other), waited for before the shell
    mark=${log%/*}/wallpaper-set
    # (the first time's stand-in sudo, below: made as it starts, gone once it's done)
    later=${log%/*}/folders-later
    # (a wallpaper Caelestia already has: an install from before the mark, its wallpaper picked since, kept. Not one a
    # first time cut off left (prepare's time limit, a power cut: its wallpaper set, which writes path.txt, its colours
    # not), its stand-in still there: that's done again, else its colours were never set)
    [[ ! -e $later && -s ${XDG_STATE_HOME:-$HOME/.local/state}/caelestia/wallpaper/path.txt ]] && touch "$mark"
    [[ -e $mark && -e $later ]] && { rm -f "$later/sudo"; rmdir "$later"; }
    first=
    # (set ahead of the desktop, by --prepare: set again at Hyprland's start, below)
    again=${log%/*}/scheme-again
    if [[ ! -e $mark ]]; then
        # Caelestia's CLI recolours the folder icons at each of the two (sudo -n papirus-folders, forked, not waited
        # for): the wallpaper's and the scheme's ran at once, the colour left to whichever ended last, and in the
        # prepare run the unit's end killed them half-way (as root, their ln's left running). Done once, with the final
        # colour: by the scheme's run at Hyprland's start (here, or its run again after the prepare run). Left out of
        # the others by a sudo of their own, which passes anything else on
        # shellcheck disable=SC2016  # (the stand-in's own $2 and $@)
        mkdir -p "$later" && printf '%s\n' '#!/bin/sh' 'case $2 in papirus-folders | */papirus-folders) exit 0 ;; esac' 'exec /usr/bin/sudo "$@"' \
            >"$later/sudo" && chmod +x "$later/sudo"
        {
            PATH=$later:$PATH caelestia wallpaper -f /etc/xdg/quickshell/caelestia/assets/wallpaper.webp &&
                PATH=${prepare:+$later:}$PATH caelestia scheme set -n dynamic &&
                { [[ -z $prepare ]] || touch "$again"; } && touch "$mark" && echo "wallpaper and colours set" &&
                { rm -f "$later/sudo"; rmdir "$later"; }
            # (the login screen's copy of them now: greeter-theme-sync at Hyprland's start ran before they were
            # there, and the first reboot came up on a login screen with neither)
            "$helpers/greeter-theme-sync"
        } 9>&- &
        first=$!
    fi
    # Every login, not only when it's missing: a rebuild an update left waiting for a game to close was lost with the
    # session that ended first. Up to date, it's only checked (its stamp, .agros-built)
    CAELESTIA_REBUILDING=1 "$helpers/caelestia-overlay" | tail -n 3
    echo "overlay checked: exit ${PIPESTATUS[0]}"
    [[ -z $first ]] || wait "$first"
} >>"$log" 2>&1
[[ -z $prepare ]] || exit 0
# Set ahead of the desktop, the colours didn't reach the window borders: Caelestia's CLI asks Hyprland whether its
# config is Lua and, with no Hyprland yet to ask, wrote them to current.conf, which the Lua config doesn't read
# (current.lua kept Caelestia's own colours until the next scheme change). Set again now Hyprland is there, beside the
# shell's start, not before it (the wallpaper and the shell's colours are there already); the folder icons' with them
if [[ -e $again ]]; then
    { caelestia scheme set -n dynamic && rm -f "$again" && echo "colours set again, for Hyprland"; } >>"$log" 2>&1 9>&- &
fi
# (even when the build failed: Caelestia as it comes, rather than no bar at all; it daemonizes and returns)
caelestia shell -d >>"$log" 2>&1 9>&-
for _ in $(seq 300); do "$helpers/qs-running" /quickshell/caelestia/shell.qml && break; sleep 0.1; done
# ...and its config loaded: it answers on its IPC. One that doesn't load leaves Quickshell running with nothing on
# screen (no bar, no notifications, no lock screen): AgrOS's changes on a Caelestia or Quickshell other than the one CI
# checked them against (a type renamed). Not within 30 s, on the overlay's changes (its own files there): started again
# without them, said once it's up (caelestia-restart --without-changes; the lock let go first, as it takes it)
for _ in $(seq 300); do qs ipc -c caelestia show >/dev/null 2>&1 && exit 0; sleep 0.1; done
[[ -n $(find "$HOME/.config/quickshell/caelestia" -type f -name '*.qml' -print -quit 2>/dev/null) ]] || exit 0
echo "$(date '+%F %T') its config didn't load with AgrOS's changes: started again without them" >>"$log"
exec 9>&-
exec "$helpers/caelestia-restart" --without-changes >>"$log" 2>&1

#!/usr/bin/env bash
# The upstream gate: the packages AgrOS's desktop is written against (Hyprland and its libraries, listed in
# /etc/pacman.d/agros-gate.conf, which pacman.conf includes: held back from every pacman run, a manual one too) are
# updated only to versions AgrOS's CI has checked its config, its title bar plugin and its shell patches against (the
# list it publishes beside the [agros] repo, agros-approved: "name version" lines, the version without its pkgrel, so a
# rebuild of an approved version, as for a library's new soname, needs no new check). Run by AgrOS's own updates (the
# boot's download and the shutdown's install, auto-update; the Updates app, update-apps, and its list, update-kinds)
#   update-gate <pacman.conf> <out> [--dbpath <dir>] [--offline]
# <out>: the pacman.conf to update with: <pacman.conf> without the gate's Include when every gated package it would
# update goes to an approved version (or only to a rebuild), else <pacman.conf> as it is (all of them held together:
# they're built against each other; and a library whose update would break one held, with it, even one Hyprland names
# without a version (glslang's new soname, its Hyprland rebuild held in the set): held by the gate's Include, added to
# <out> if <pacman.conf> lacks it). Says on stdout what waits ("name installed -> new" lines, "name
# (held with ...)"). The list fetched each run, kept for when the repo can't be reached; never fetched, nothing new let
# through. The list is taken only with a good signature by AgrOS's key beside it (agros-approved.sig, checked with gpgv
# against agros-keyring's key alone): none, or a bad one (a mirror or a network in between that changed it), and it's
# as if the repo couldn't be reached, said: the kept list, nothing new let through. --offline: the kept list only (the
# shutdown's install: no more let through than the boot downloaded). --runtimes-later (Settings' Updates and its list, in
# the session): a new Qt, or a new Python series (update-kinds' runtimes), left for the boot and the shutdown (below)
set -uo pipefail
usage="usage: update-gate <pacman.conf> <out> [--dbpath <dir>] [--offline] [--runtimes-later]"
base=${1:?$usage} out=${2:?$usage}
shift 2
db=() offline=0 later=0
while (($#)); do
    case $1 in
        --dbpath) db=(--dbpath "${2:?$usage}"); shift 2 ;;
        --offline) offline=1; shift ;;
        --runtimes-later) later=1; shift ;;
        *) echo "$usage" >&2; exit 2 ;;
    esac
done
gate=${AGROS_GATE:-/etc/pacman.d/agros-gate.conf}
keyring=${AGROS_GATE_KEYRING:-/usr/share/pacman/keyrings/agros.gpg}
if [[ $EUID -eq 0 ]]; then cache=${AGROS_GATE_CACHE:-/var/lib/agros/agros-approved}; else cache=${AGROS_GATE_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/agros-approved}; fi
mkdir -p "${cache%/*}" 2>/dev/null
cp -- "$base" "$out" || exit 1
read -ra gated < <(sed -n 's/^[[:space:]]*IgnorePkg[[:space:]]*=[[:space:]]*//p' "$gate" 2>/dev/null | tr '\n' ' ')
# A library whose update would take away one an installed [agros] package loads, with no newer build of that package
# in the same update (soname-hold: sndio 1.11's libsndio.so.9 for .so.7, libcava and with it Caelestia not starting):
# held in <out> until [agros] has the rebuild, said. Before the dry run below, which then holds what needs its new version
# With --held <the gated packages> (held: the gate's Include stays): a library whose update takes away one they load
# (Arch's new soname of glslang, its Hyprland rebuild in the set held), held with them, and what needs it by name
hold_sonames() {
    local holds lib by so with
    local opts=("${db[@]}")
    ((offline == 0)) || opts+=(--offline)
    # (SONAME_HOLD: the tests' stand-in)
    holds=$("${SONAME_HOLD:-$(dirname "$(readlink -f "$0")")/soname-hold}" "$out" "${opts[@]}" "$@") || return 0
    [[ -n $holds ]] || return 0
    while read -r lib by so with; do
        if [[ -n $with ]]; then echo "$lib (waits with $with for $by's update: it needs $with, and may be built for its new version)"
        elif (($#)); then echo "$lib (waits for $by's update: its update takes away $so, which $by loads)"
        else echo "$lib (waits for AgrOS's rebuild of $by: its update takes away $so, which $by loads)"; fi
    done <<<"$holds"
    sed -i "/^\\[options\\]/a IgnorePkg = $(cut -d' ' -f1 <<<"$holds" | sort -u | paste -sd' ')" "$out"
}
# --runtimes-later: a new Qt (or Python series) left for the boot's download and the shutdown's install, which build what's
# built on it (the shell's Quickshell and Caelestia) in the background and install them together. Installed here, under
# the running shell, the shell ran on the old Qt build against the new Qt's files until the rebuild, minutes of compiling
# in the session later (Nexus froze), and was never restarted. Qt's whole release held (every qt6-* in the update: its
# modules go together), the new Python, and by the dry run below what needs them
hold_runtimes() {
    if ((later)); then
        pending=$(LC_ALL=C pacman -Qu --config "$out" "${db[@]}" 2>/dev/null)
        target=$("${UPDATE_KINDS:-$(dirname "$(readlink -f "$0")")/update-kinds}" --runtime-target <<<"$pending" 2>/dev/null) || target=
        later_held=$(awk -v t=" $target " '($1 ~ /^qt6-/ && t ~ / qt6-/) || ($1 == "python" && t ~ / python /) { print $1 }' \
            <<<"$pending" | sort -u | paste -sd' ')
        if [[ -n $later_held ]]; then
            echo "$later_held (installs at shutdown: what's built on it, the shell too, is rebuilt for it in the background at boot first)"
            sed -i "/^\\[options\\]/a IgnorePkg = $later_held" "$out"
        fi
    fi
}
((${#gated[@]})) || { hold_sonames; hold_runtimes; exit 0; }
# (the approved list from the [agros] repo's own servers, fetched beside its database: each in turn, as the boot's copy
# of agros-arch-ok, so a GitHub Pages outage doesn't hold Hyprland's updates while the R2 mirror has the list. One
# unreachable, or whose list has no good signature, gives way to the next)
mapfile -t servers < <(pacman-conf --config "$base" --repo agros Server 2>/dev/null)
# (fetched into a file of its own: two runs at once, the Updates app's and its list's, don't mix theirs)
tmp=
((offline)) || tmp=$(mktemp "$cache.XXXXXX" 2>/dev/null) || tmp=
# (none, --offline: nothing to remove, not a .sig in the folder this runs from)
trap '[[ -z $tmp ]] || rm -f "$tmp" "$tmp.sig"' EXIT
# (a stamp on the address: GitHub Pages' cache served a list from before the last publish for minutes; a passing
# network error tried again, as agros-iso's copies of this fetch do)
stamp=$(date +%s)
get() { curl -fsS --connect-timeout 10 -m 30 --retry 3 --retry-all-errors -o "$1" "$2?t=$stamp" 2>/dev/null; }
for server in "${servers[@]}"; do
    [[ -n $server && -n $tmp ]] || break
    get "$tmp" "$server/agros-approved" &&
        grep -qE '^[a-z0-9@._+-]+ [A-Za-z0-9.:_+~]+$' "$tmp" || continue
    if get "$tmp.sig" "$server/agros-approved.sig" &&
        gpgv --keyring "$keyring" "$tmp.sig" "$tmp" >/dev/null 2>&1; then
        chmod 644 "$tmp"
        mv -f "$tmp" "$cache"
        break
    fi
    echo "update-gate: AgrOS's approved list has no good signature by AgrOS's key ($server/agros-approved.sig): not taken, as if unreachable (the list kept from before, nothing new let through)" >&2
done
[[ -z $tmp ]] || rm -f "$tmp" "$tmp.sig"
# (still: those installed with no update of their own in this one)
waits=() still=()
for name in "${gated[@]}"; do
    have=$(pacman -Q "${db[@]}" -- "$name" 2>/dev/null | cut -d' ' -f2) || continue
    [[ -n $have ]] || continue
    # (the version pacman would install: the first repo's, in pacman.conf's order)
    # (read whole, then its first Version line: no early reader on pacman's pipe under pipefail)
    new=$(LC_ALL=C pacman -Si --config "$base" "${db[@]}" -- "$name" 2>/dev/null)
    new=$(sed -n '/^Version *: /{s///p;q;}' <<<"$new")
    [[ -n $new && $new != "$have" ]] || { still+=("$name"); continue; }
    # (a rebuild of the same version: as Arch's for a library's new soname, which comes with it. Let through unchecked,
    # but held with the set when another of it waits, and the library then with it: hold_sonames --held)
    [[ ${new%-*} == "${have%-*}" ]] && continue
    # (older in the repo, rolled back: pacman -Su keeps the newer one)
    (($(vercmp "$new" "$have") > 0)) || { still+=("$name"); continue; }
    grep -qxF -- "$name ${new%-*}" "$cache" 2>/dev/null || waits+=("$name $have -> $new")
done
# The set waiting AGROS_GATE_DAYS (14) for AgrOS's check (CI no longer approving: broken, or not run): let through
# unchecked, said, rather than held, and with it every update that needs it, for good. Each one's since when, "<name>
# <epoch>" lines beside the list (one no longer waiting forgotten); held together as ever while one is newer than that
now=$(date +%s) since=() young=0
for w in "${waits[@]}"; do
    s=$(awk -v n="${w%% *}" '$1 == n { print $2; exit }' "$cache.waiting" 2>/dev/null)
    [[ $s =~ ^[0-9]+$ ]] || s=$now
    since+=("${w%% *} $s")
    ((now - s >= ${AGROS_GATE_DAYS:-14} * 86400)) || young=1
done
{ ((${#since[@]} == 0)) || printf '%s\n' "${since[@]}"; } >"$cache.waiting" 2>/dev/null
if ((${#waits[@]} && !young)); then
    printf "update-gate: let through unchecked, after ${AGROS_GATE_DAYS:-14} days or more waiting for AgrOS's check: %s\n" "${waits[@]}" >&2
    waits=()
fi
inc="Include = $gate"
if ((${#waits[@]})); then
    printf '%s\n' "${waits[@]}"
    # (held by the gate itself, whatever pacman.conf has: a merged .pacnew may have lost its Include)
    grep -qE "^[[:space:]]*Include[[:space:]]*=[[:space:]]*${gate//./\\.}[[:space:]]*(#.*)?\$" "$out" ||
        sed -i "/^\\[options\\]/a $inc" "$out"
else
    sed -i "\\|^[[:space:]]*Include[[:space:]]*=[[:space:]]*${gate//./\\.}[[:space:]]*\\(#.*\\)\\?\$|d" "$out"
fi
# A held one a library's update would break (a new soname, its own rebuild waiting with it): that library held too, in
# <out>, until the next lists (a few tries: one held can hold another). Found by pacman's own dry run, as the update
# it's for would fail on it whole
hold_sonames
# (nothing waiting: those with no update of their own in this one, as held: a library's new soname that came before
# their rebuild held for it, not refused at every update by the soname guard's hook)
if ((${#waits[@]})); then hold_sonames --held "${gated[@]}"; elif ((${#still[@]})); then hold_sonames --held "${still[@]}"; fi
hold_runtimes
for try in 1 2 3 4 5 6; do
    ((try < 6)) || { echo "update-gate: the update still can't be worked out (pacman says why as it runs)" >&2; break; }
    dry=$(LC_ALL=C pacman -Sup --config "$out" "${db[@]}" --print-format '%n' 2>&1) && break
    breaks=$(sed -nE "s/^:: installing ([^ ]+) .*breaks dependency '[^']*' required by ([^ ]+)\$/\\1 \\2/p" <<<"$dry")
    ignored=$(pacman-conf --config "$out" IgnorePkg)
    held=$(while read -r lib by; do [[ -n $lib ]] && grep -qxF -- "$by" <<<"$ignored" && echo "$lib $by"; done <<<"$breaks" | sort -u)
    # (a gated one, approved, whose update would break one not held: a package of AgrOS's built for the old series, its
    # rebuild not published yet, as agros-hyprbars' hyprland<0.58 for an approved 0.58. The whole set waits for that
    # rebuild, by the gate's Include, rather than the whole update failing on it, the kernel's too)
    waiting=$(while read -r lib by; do
        [[ -n $lib ]] && grep -qxF -- "$lib" <<<"$(printf '%s\n' "${gated[@]}")" && ! grep -qxF -- "$by" <<<"$ignored" &&
            echo "$lib $by"
    done <<<"$breaks" | sort -u)
    # (and any other one rebuilt against a held library's new version: it waits too)
    needs=$(sed -nE "s/^:: unable to satisfy dependency '[^']*' required by ([^ ]+)\$/\\1/p" <<<"$dry" | sort -u)
    [[ -n $held || -n $waiting || -n $needs ]] ||
        { echo "update-gate: pacman's dry run failed (it says why as it runs): $(grep -m1 . <<<"$dry")" >&2; break; }
    [[ -z $held ]] || while read -r lib by; do echo "$lib (held with $by: its update would break it)"; done <<<"$held"
    [[ -z $waiting ]] || while read -r lib by; do echo "$lib (waits for $by's rebuild: its update would break it)"; done <<<"$waiting"
    [[ -z $needs ]] || while read -r pkg; do echo "$pkg (held: its update needs something not to be had yet)"; done <<<"$needs"
    if [[ -n $waiting ]]; then
        grep -qE "^[[:space:]]*Include[[:space:]]*=[[:space:]]*${gate//./\\.}[[:space:]]*(#.*)?\$" "$out" ||
            { sed -i "/^\\[options\\]/a $inc" "$out"; hold_sonames --held "${gated[@]}"; }
    fi
    ign=$({ cut -d' ' -f1 <<<"$held"; echo "$needs"; } | grep . | sort -u | paste -sd' ')
    [[ -z $ign ]] || sed -i "/^\\[options\\]/a IgnorePkg = $ign" "$out"
done
exit 0

#!/bin/sh
# Waits while a game is open: background work (the update check, lutris-library, a config reload: hypr-reload) runs
# after it, not while it plays. What a game is: game-focus's is_game (beside this), the one definition (a Steam game,
# a window Caelestia or user/apps.lua tags "game"; not a store launcher's, tagged like a game under Proton). Returns at
# once outside Hyprland
# (In braces, read whole before it runs: an update rewriting this file while it waits broke the rest of the run)
{
bin=$(dirname "$(readlink -f "$0")")
while "$bin/game-focus" --game-open 2>/dev/null; do
    sleep 60
done
exit
}

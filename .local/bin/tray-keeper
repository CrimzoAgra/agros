#!/usr/bin/env python3
"""Keeps tray apps in the tray when the tray (Caelestia) restarts or crashes.

- Apps like Proton VPN don't re-add their tray icon when the tray comes back: re-register them.
- Spotify shows its window when the tray disappears. This watches the tray service on D-Bus and Spotify's
window through Hyprland's events: if Spotify was hidden when the tray went away, its pop-up should open on
a hidden workspace (the silent Spotify window rules in ~/.config/caelestia/user/apps.lua: caelestia-restart turns them
on before restarting, this does too when the tray goes away, and moves the window there if it was faster),
and it's minimised back to the tray (~/.local/bin/spotify-tray, which turns the rules off again).
Runs as a systemd user service (~/.config/systemd/user/tray-keeper.service), started at login.
"""
import json
import os
import socket
import subprocess
import sys
import time

from gi.repository import Gio, GLib

TRAY = "org.kde.StatusNotifierWatcher"
POPUP_WINDOW = 15  # seconds after the tray went away in which a Spotify window counts as the pop-up

loop = GLib.MainLoop()
spotify = set()          # addresses of open Spotify windows
visible_since = 0.0      # when a Spotify window last appeared
hidden_at_loss = None    # was Spotify hidden when the tray went away? (None: tray is there)
lost_at = 0.0


def running() -> bool:
    return subprocess.run(["pgrep", "-f", "com.spotify.Client"], capture_output=True).returncode == 0


def silent(on: bool) -> None:
    subprocess.run(["hyprctl", "eval", f"dots.spotify_silent_set({str(on).lower()})"], capture_output=True)


def tray_vanished(*_):
    global hidden_at_loss, lost_at
    lost_at = time.monotonic()
    # A window that only just appeared is Spotify reacting to this, not something you opened
    hidden_at_loss = running() and (not spotify or lost_at - visible_since < 0.5)
    if hidden_at_loss:
        silent(True)
        GLib.timeout_add_seconds(POPUP_WINDOW, popup_missed)


def popup_missed():
    # No pop-up came: rules off again, so opening Spotify yourself shows it
    global hidden_at_loss
    if hidden_at_loss:
        hidden_at_loss = None
        silent(False)
    return False


def tray_appeared(connection, *_):
    # Re-register the icons of apps that don't do it themselves (their bus names start with this)
    names = connection.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "ListNames",
                                 None, GLib.VariantType("(as)"), Gio.DBusCallFlags.NONE, -1, None).unpack()[0]
    for name in names:
        if name.startswith("org.kde.StatusNotifierItem-"):
            try:
                connection.call_sync(TRAY, "/StatusNotifierWatcher", TRAY, "RegisterStatusNotifierItem",
                                     GLib.Variant("(s)", (name,)), None, Gio.DBusCallFlags.NONE, 2000, None)
            except GLib.Error:
                pass


def on_window_open(addr, ws):
    global hidden_at_loss
    if hidden_at_loss and time.monotonic() - lost_at < POPUP_WINDOW:
        hidden_at_loss = None
        if ws != "special:hidden":
            subprocess.run(["hyprctl", "eval", f'dots.spotify_hide("{addr}")'], capture_output=True)
        subprocess.Popen([os.path.expanduser("~/.local/bin/spotify-tray")], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def hypr_events():
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sig = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]
    sock.connect(f"{os.environ['XDG_RUNTIME_DIR']}/hypr/{sig}/.socket2.sock")
    buf = b""

    def readable(*_):
        nonlocal buf
        global visible_since
        data = sock.recv(65536)
        if not data:
            loop.quit()  # Hyprland went away: stop (the systemd service restarts it if the session goes on)
            return False
        buf += data
        *lines, buf = buf.split(b"\n")
        for line in lines:
            event, _, args = line.decode(errors="replace").partition(">>")
            if event == "openwindow":
                addr, ws, cls, *_ = args.split(",", 3) + [""]
                if cls.lower() == "spotify":
                    spotify.add(addr)
                    visible_since = time.monotonic()
                    on_window_open(addr, ws)
            elif event == "closewindow":
                spotify.discard(args)
        return True

    GLib.io_add_watch(sock.fileno(), GLib.IO_IN | GLib.IO_HUP, readable)


def main():
    # Spotify windows already open
    out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout
    for c in json.loads(out or "[]"):
        if c.get("class", "").lower() == "spotify":
            spotify.add(c["address"].removeprefix("0x"))
    hypr_events()
    Gio.bus_watch_name(Gio.BusType.SESSION, TRAY, Gio.BusNameWatcherFlags.NONE, tray_appeared, tray_vanished)
    loop.run()
    # Hyprland went away: a clean exit, so systemd's restart limit can't block the next session's start
    sys.exit(0)


if __name__ == "__main__":
    main()

#!/usr/bin/python3 -I
# Lutris's Games view lists only its library, and games from a store (Steam, EA, Ubisoft, Epic, GOG, Battle.net,
# Rockstar) join it only once installed. Add the rest as uninstalled entries: the view then shows installed games first
# and the others below, and opening one installs it through its store like from the store's own list.
# - Installed Steam games join even when Lutris can't read the Steam library (a private profile: Overwatch)
# - A game on more than one store shows once: an installed copy, else the Steam one, else the first. The others go to
#   Lutris's Hidden category (sidebar)
# - The store launchers (EA App, Ubisoft Connect, Battle.net, Epic, GOG Galaxy, Rockstar, Steam) are listed under Launchers in
#   the sidebar, installed or not: opening one there installs it through Lutris (lutris-overlay keeps them out of the
#   Games view)
# - Installed games and launchers get an app menu entry (the Super menu), once each
# - Games Epic's own launcher installed (or uninstalled) show as installed (or not) in Lutris
# Run by lutris-library.path whenever Lutris's database changes (a store sync), and by agros-welcome. An open Lutris
# shows the changes at once (lutris-overlay's library_refresh action, asked over D-Bus); a plain one once restarted
import fcntl
import glob
import json
import logging
import os
import re
import shutil
import sqlite3
import subprocess

# One run at a time (agros-welcome's and lutris-library.path's can overlap): two at once both added the same games and
# hid each other's copies. The second waits, then looks again (what the first wrote included)
_run = os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache")
os.makedirs(_run, exist_ok=True)
_lock = open(os.path.join(_run, "lutris-library.lock"), "w")
fcntl.flock(_lock, fcntl.LOCK_EX)

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from lutris import settings  # noqa: E402
from lutris.config import LutrisConfig, write_game_config  # noqa: E402
from lutris.database import sql  # noqa: E402
from lutris.database.games import delete_game, get_games  # noqa: E402
from lutris.database.services import ServiceGameCollection  # noqa: E402
from lutris.services.lutris import sync_media  # noqa: E402
from lutris.services.steam import SteamCover, SteamGame, SteamService  # noqa: E402
from lutris.util.steam.appmanifest import AppManifest, get_appmanifests  # noqa: E402
from lutris.util.log import logger  # noqa: E402
from lutris.util.steam import config as steam_config  # noqa: E402
from lutris.util.strings import slugify  # noqa: E402

# Lutris's own warnings ("Steam game N has no config", ~50 a run) only: they also went into an open Lutris's log
logger.setLevel(logging.ERROR)

# Before Lutris's first start (agros-welcome on a fresh install) its folders and database don't exist: made as Lutris
# makes them at start-up, so the launchers are listed from its very first window
if not os.path.exists(settings.DB_PATH):
    from lutris.database.schema import syncdb  # noqa: E402
    from lutris.startup import init_dirs  # noqa: E402
    init_dirs()
    syncdb()


def library():
    """What an open Lutris shows of the library (its games and their categories), to tell whether this run changed it"""
    with sqlite3.connect(settings.DB_PATH, timeout=10) as c:
        return [c.execute(f"SELECT * FROM {table} ORDER BY 1, 2").fetchall()
                for table in ("games", "categories", "games_categories")]


before = library()

# Flathub's Steam where newer versions of it keep it, which Lutris doesn't look in (as the patched Lutris does,
# lutris-overlay's flathub_steam)
steam_config.STEAM_DATA_DIRS += ("~/.var/app/com.valvesoftware.Steam/.local/share/Steam",)

# Lutris adds installed Steam games only if they're in its copy of the Steam library, which it wipes and fails to
# reload while the profile's game details are private: add them to it from Steam's own files, then let it add them
steam = SteamService()
TOOLS = re.compile(r"^(Proton\b|Steam Linux Runtime|Steamworks Common|SteamVR\b)")  # as steam-installed-games
added = False
for path in steam.steamapps_paths:
    for name in get_appmanifests(path):
        # (each on its own, as Lutris reads them: Steam rewrites a manifest while it downloads, and a half-written one
        # mustn't stop the run)
        try:
            manifest = AppManifest(os.path.join(path, name))
            appid = manifest.steamid
            # (no name yet: Steam rewriting it mid-download; saved, its NULL name crashed every later run)
            if not manifest.is_installed() or not manifest.name or appid in steam.excluded_appids or TOOLS.match(manifest.name):
                continue
            if not ServiceGameCollection.get_game("steam", appid):
                SteamGame.new_from_steam_game({"appid": appid, "name": manifest.name, "playtime_forever": 0}).save()
                added = True
            # This script's uninstalled entry for it gives way to the installed one Lutris adds: with both, Lutris's own
            # duplicate cleanup would delete the installed one (the patched Lutris does the same, lutris-overlay)
            for placeholder in get_games(filters={"service": "steam", "service_id": appid, "installed": "0"}):
                if not placeholder["configpath"]:
                    # (its categories too: the installed one can get its id back, and with it "hidden")
                    sql.db_delete(settings.DB_PATH, "games_categories", "game_id", placeholder["id"])
                    delete_game(placeholder["id"])
            # Lutris's own entry for it, marked uninstalled by a sync while its library's drive wasn't mounted: Lutris
            # finds the entry and stops there, so it stays "not installed" for good
            for stale in get_games(filters={"service": "steam", "service_id": appid, "installed": "0"}):
                if stale["installer_slug"] == f"steam-{appid}":
                    # (Lutris's uninstall deleted its config: a new one, as Lutris writes for an install)
                    config = stale["configpath"]
                    if not config or not os.path.exists(os.path.join(settings.GAME_CONFIG_DIR, config + ".yml")):
                        config = write_game_config(f"steam-{appid}", {"game": {"appid": appid}})
                    sql.db_update(settings.DB_PATH, "games", {"installed": 1, "runner": "steam", "configpath": config},
                                  {"id": stale["id"]})
        except Exception as e:  # noqa: BLE001
            logger.error("Steam manifest %s: %s", name, e)
if added:
    steam.load_icons()  # their covers, as a Steam sync would (only the missing ones are downloaded)
steam.add_installed_games()
# Covers Lutris can't download (newer games' art isn't at the address it uses): Steam's own copies, if it has them
covers = SteamCover()
# Steam's own folder: the library that has appcache next to it (the list can start with compatibility tool folders)
steam_root = next((os.path.dirname(p) for p in steam.steamapps_paths
                   if os.path.isdir(os.path.join(os.path.dirname(p), "appcache"))), None)
for game in ServiceGameCollection.get_for_service("steam") if steam_root else []:
    dest = os.path.join(covers.dest_path, covers.get_filename(game["slug"]))
    if not (os.path.exists(dest) and os.path.getsize(dest)):  # a failed download leaves an empty file
        cache = os.path.join(steam_root, "appcache/librarycache", game["appid"])
        found = sorted(glob.glob(f"{cache}/**/library_600x900.jpg", recursive=True)
                       + glob.glob(f"{cache}/**/library_capsule.jpg", recursive=True))
        if found:
            os.makedirs(covers.dest_path, exist_ok=True)
            shutil.copyfile(found[0], dest)

db = sqlite3.connect(settings.DB_PATH, timeout=10)
# Battle.net and Rockstar: their games only while you're signed in to them in Lutris (lutris-overlay's bnet_login and
# rockstar_source: then their list is your account's). Signed out, Lutris's Battle.net list is every Blizzard game, owned
# or not. Ones no longer listed (signed out, gone
# from the account, added by an older run) are taken out again; installed ones are Lutris's own, kept
# (and only with the sign-in in the Lutris that runs: without it, turned off or left out by an update, Lutris's list is
# every Blizzard game again)
def signed_in(service, owned):
    # (in XDG_CACHE_HOME when it's set, where ~/.local/bin/lutris builds it: next to Lutris's own cache folder)
    build = os.path.join(os.path.dirname(settings.CACHE_DIR), "lutris-overlay")
    try:
        with open(os.path.join(build, f"lutris/services/{service}.py"), encoding="utf-8") as f:
            patched = "lutris-owned" in f.read()  # the patched Lutris ~/.local/bin/lutris runs
    except OSError:
        patched = False
    # (a failed rebuild runs plain Lutris, the old patched copy left in place)
    failed = os.path.exists(build + ".failed")
    return patched and not failed and os.path.exists(os.path.join(settings.CACHE_DIR, owned))


SIGN_IN = {"battlenet": "bnet-owned.json", "rockstar": "rockstar-owned.json"}
NOT_OWNED = tuple(s for s, owned in SIGN_IN.items() if not signed_in(s, owned))
# Stores whose list is the games you own; other sources (Flathub, local apps, itch.io...) list catalogues, not yours
STORES = ("steam", "ea_app", "ubisoft", "egs", "gog", "battlenet", "rockstar")
with db:
    for service in SIGN_IN:
        # (an empty list is a reload under way, Lutris refilling it: nothing taken out then)
        stale = """SELECT id FROM games WHERE installed = 0 AND runner IS NULL AND service = ? AND (? OR (service_id NOT IN
                   (SELECT appid FROM service_games WHERE service = ?)
                   AND EXISTS (SELECT 1 FROM service_games WHERE service = ?)))"""
        args = (service, service in NOT_OWNED, service, service)
        db.execute(f"DELETE FROM games_categories WHERE game_id IN ({stale})", args)
        db.execute(f"DELETE FROM games WHERE id IN ({stale})", args)


def epic_addon(details):
    """An Epic add-on (DLC, a map, a route): not a game of its own. As the Legendary client tells them: it names its
    main game, or it's in the add-ons category"""
    try:
        item = json.loads(details or "{}")
    except ValueError:
        return False
    return "mainGameItem" in item or any(c.get("path") == "addons" for c in item.get("categories") or [])


# Lutris's library sync (your lutris.net account) brings back your other PCs' games without their store ids: each given
# its id back from its store's list, by the slug this script and the store syncs give it, else by its name (lutris.net
# made their slugs its own way: alan-wake-s-... and k-ln for Köln, where Epic's are alan-wakes-, koln), else this
# script added it
# again beside it and an Epic add-on among them wasn't told as one. This script's own entry for the same game gives way
# (the synced one has your playtime and categories). (Lutris's sync matches by slug, runner, platform and store: the
# id given back doesn't make it add the game again)
ids = {}
for service, appid, name, lutris_slug, slug in db.execute(
        "SELECT service, appid, name, lutris_slug, slug FROM service_games"):
    for s in (lutris_slug, slug, f"{service}-{appid}"):
        if s:
            ids.setdefault((service, s), appid)
    if name:
        ids.setdefault((service, "name:" + name.casefold()), appid)
with db:
    placeholder = ("SELECT id FROM games WHERE service = ? AND service_id = ? AND installed = 0 AND runner IS NULL "
                   "AND configpath IS NULL")
    for game_id, service, slug, name in db.execute(
            f"SELECT id, service, slug, name FROM games WHERE service_id IS NULL AND service IN ({','.join('?' * len(STORES))})",
            STORES).fetchall():
        appid = ids.get((service, slug)) or ids.get((service, "name:" + (name or "").casefold()))
        if not appid:  # (its store not synced yet, or no longer listing it)
            continue
        db.execute(f"DELETE FROM games_categories WHERE game_id IN ({placeholder})", (service, appid))
        db.execute(f"DELETE FROM games WHERE id IN ({placeholder})", (service, appid))
        if not db.execute("SELECT 1 FROM games WHERE service = ? AND service_id = ?", (service, appid)).fetchone():
            db.execute("UPDATE games SET service_id = ? WHERE id = ?", (appid, game_id))

# Epic add-ons not installed (one installed is Lutris's own, left): hidden, not games of their own. Hidden, not taken
# out: one Lutris's library sync brought back came again with its next sync (and, its categories taken from your
# account's, one it unhid is hidden again by the next run of this)
addons = [(appid,) for appid, details in db.execute("SELECT appid, details FROM service_games WHERE service = 'egs'")
          if epic_addon(details)]
with db:
    db.execute("INSERT OR IGNORE INTO categories (name) VALUES ('.hidden')")
    (hidden_category,) = db.execute("SELECT id FROM categories WHERE name = '.hidden'").fetchone()
    db.executemany("INSERT INTO games_categories (game_id, category_id) SELECT id, ? FROM games WHERE service = 'egs' "
                   "AND service_id = ? AND installed = 0 AND id NOT IN "
                   "(SELECT game_id FROM games_categories WHERE category_id = ?)",
                   [(hidden_category, a, hidden_category) for (a,) in addons])


def epic_manifests(prefix):
    """The games Epic's launcher has installed in its prefix, by app name: their install manifests, add-ons and
    unfinished downloads left out. None when its folder isn't there (a drive not mounted: nothing to tell from that)"""
    folder = os.path.join(prefix, "drive_c/ProgramData/Epic/EpicGamesLauncher/Data/Manifests")
    if not os.path.isdir(folder):
        return None
    games = {}
    for path in glob.glob(os.path.join(folder, "*.item")):
        try:
            with open(path, encoding="utf-8") as f:
                m = json.load(f)
        except (OSError, ValueError):
            continue
        app = m.get("AppName")
        # (Epic writes MainGameAppName empty for a game itself now: Lutris's own scan skipped every one for it)
        if app and m.get("MainGameAppName") in ("", None, app) and not m.get("bIsIncompleteInstall"):
            games[app] = m
    return games


# Games installed in Epic's launcher: Lutris takes them in only on its Epic source's Reload, and then skips them all
# (Epic's manifests no longer name a main game). Each made installed here as Lutris's own import makes it (its config
# the launcher's, opening it through the launcher), the entry already listing it reused; one Epic uninstalled is
# uninstalled again. Run when its manifests change too (lutris-library.path)
def epic_installs():
    store = db.execute("SELECT directory, configpath, runner FROM games WHERE slug = 'epic-games-store' AND installed = 1"
                       ).fetchone()
    if not store or not store[0] or not store[1]:
        return "epic: launcher not installed"
    directory, configpath, runner = store
    found = epic_manifests(directory.split("drive_c")[0])
    if found is None:
        return "epic: no manifests"
    names = {a: n for a, n in db.execute("SELECT appid, name FROM service_games WHERE service = 'egs'")}
    added = removed = 0
    with db:
        for app, m in found.items():
            row = db.execute("SELECT id, installed, name FROM games WHERE service = 'egs' AND service_id = ?",
                             (app,)).fetchone()
            if row and row[1]:
                continue
            name = names.get(app) or (row[2] if row else None) or m.get("DisplayName") or app
            installer_slug = f"{slugify(name)}-egs"
            config = LutrisConfig(game_config_id=configpath).game_level
            config["game"]["args"] = f"-opengl -SkipBuildPatchPrereq -com.epicgames.launcher://apps/{app}?action=launch"
            game_config = write_game_config(installer_slug, config)
            values = (runner or "wine", directory, installer_slug, game_config)
            if row:
                db.execute("UPDATE games SET runner = ?, directory = ?, installed = 1, installer_slug = ?, configpath = ? "
                           "WHERE id = ?", (*values, row[0]))
            else:
                db.execute("INSERT INTO games (runner, directory, installed, installer_slug, configpath, name, slug, "
                           "service, service_id) VALUES (?, ?, 1, ?, ?, ?, ?, 'egs', ?)", (*values, name, slugify(name), app))
            added += 1
        # (only ones played through this launcher's prefix: one installed some other way is left alone)
        for game_id, app in db.execute("SELECT id, service_id FROM games WHERE service = 'egs' AND installed = 1 "
                                       "AND directory = ?", (directory,)).fetchall():
            if app not in found:
                db.execute("UPDATE games SET installed = 0 WHERE id = ?", (game_id,))
                removed += 1
    return f"epic: {added} installed, {removed} uninstalled"


try:
    print(epic_installs())
except Exception as e:  # (one store's trouble never stops the rest of this)
    logger.error("epic installs: %s", e)
known = {(s, i) for s, i in db.execute("SELECT service, service_id FROM games")}
# (Lutris's own slug for it, else the one its store sync made: lutris.net covers are found by it)
new = [(name, lutris_slug or slug or f"{service}-{appid}", "steam" if service == "steam" else None, service, appid)
       for service, appid, name, lutris_slug, slug, details in db.execute(
           "SELECT service, appid, name, lutris_slug, slug, details FROM service_games")
       if (service, appid) not in known and service in STORES and service not in NOT_OWNED
       and not (service == "egs" and epic_addon(details))]
if new:
    with db:
        db.executemany("INSERT INTO games (name, slug, runner, installed, service, service_id) VALUES (?, ?, ?, 0, ?, ?)",
                       new)
print(f"{len(new)} games added")


# Games a store still lists under an older name (Steam: Overwatch 2 as "Overwatch®")
SAME = {"overwatch": "overwatch2"}


def key(name):
    """The same game on two stores: names alike but for case, punctuation and ™/®"""
    k = re.sub(r"[\W_]+", "", name.lower())  # letters of any script kept (ペルソナ3 isn't 3)
    return SAME.get(k, k)


copies = {}
for game_id, name, installed, service in db.execute(
        "SELECT id, name, installed, service FROM games WHERE service IS NOT NULL ORDER BY service = 'steam' DESC, id"):
    if key(name or ""):  # (a name only of punctuation, "!", or none: no telling its copies)
        copies.setdefault(key(name), []).append((game_id, installed))
hide = [game_id for group in copies.values() if len(group) > 1
        for game_id, installed in group[0 if any(i for _, i in group) else 1:] if not installed]
# The copy that shows: an installed one, else the first (it changes as copies are installed and removed)
show = {game_id for group in copies.values() if len(group) > 1 for game_id, _ in group} - set(hide)
# Each copy hidden once: one you unhid in Lutris (the other hidden instead) stays as you left it, so the ids this script
# hid are remembered. A copy it hid that should show again (the Steam copy refunded): unhide it from Lutris's Hidden view
mine_file = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "lutris-library-hidden")
try:
    with open(mine_file, encoding="utf-8") as f:
        mine = set(json.load(f))
except (OSError, ValueError):
    mine = set()
with db:
    db.execute("INSERT OR IGNORE INTO categories (name) VALUES ('.hidden')")
    (category,) = db.execute("SELECT id FROM categories WHERE name = '.hidden'").fetchone()
    hidden = {i for (i,) in db.execute("SELECT game_id FROM games_categories WHERE category_id = ?", (category,))}
    mine &= {i for (i,) in db.execute("SELECT id FROM games")}
    # One this script hid that is now the one to show (installed from the Hidden view or its store keeps its id and
    # with it "hidden"; or the copy shown instead was removed): unhidden, else the game showed nowhere. Hidden by you
    # (not in mine): left
    unhide = sorted(show & hidden & mine)
    db.executemany("DELETE FROM games_categories WHERE game_id = ? AND category_id = ?", [(i, category) for i in unhide])
    hidden -= set(unhide)
    mine -= set(unhide)
    hide = sorted(set(hide) - hidden - mine)
    db.executemany("INSERT INTO games_categories (game_id, category_id) VALUES (?, ?)", [(i, category) for i in hide])
os.makedirs(os.path.dirname(mine_file), exist_ok=True)
with open(mine_file + ".tmp", "w", encoding="utf-8") as f:
    json.dump(sorted(mine | set(hide)), f)
os.replace(mine_file + ".tmp", mine_file)  # (cut short, the list read as empty: copies you unhid were hidden again)
print(f"{len(hide)} hidden, {len(unhide)} shown again")


# The store launchers, under "Launchers" in the sidebar (a category of Lutris's), installed or not: an entry with no
# store, which Lutris installs by its slug with its own install window (the launcher's setup then opens). Not among the
# games (lutris-overlay's launchers_apart). Hidden by an earlier version of this script: unhidden, the sidebar's view
# leaves hidden games out
LAUNCHERS = {"ea-app": "EA App", "ubisoft-connect": "Ubisoft Connect", "battlenet": "Battle.net",
             "epic-games-store": "Epic Games Store", "gog-galaxy": "GOG Galaxy",
             "rockstar-games-launcher": "Rockstar Games Launcher", "steam": "Steam"}
# Steam installed on the system (a package), else Flathub's: its entry opens it, not lutris.net's installs
# (Flatpak, Windows)
steam_game = {"exe": shutil.which("steam")}
flatpak = shutil.which("flatpak")
if not steam_game["exe"] and flatpak and subprocess.run([flatpak, "info", "com.valvesoftware.Steam"],
                                                        capture_output=True).returncode == 0:
    steam_game = {"exe": flatpak, "args": "run com.valvesoftware.Steam"}
with db:
    db.execute("INSERT OR IGNORE INTO categories (name) VALUES ('Launchers')")
    (launchers,) = db.execute("SELECT id FROM categories WHERE name = 'Launchers'").fetchone()
    listed = {i for (i,) in db.execute("SELECT game_id FROM games_categories WHERE category_id = ?", (launchers,))}
    for slug, name in LAUNCHERS.items():
        ids = [i for (i,) in db.execute("SELECT id FROM games WHERE slug = ?", (slug,))]
        if not ids:
            ids = [db.execute("INSERT INTO games (name, slug, installed) VALUES (?, ?, 0)", (name, slug)).lastrowid]
        if slug == "steam" and steam_game["exe"]:
            todo = [i for (i,) in db.execute("SELECT id FROM games WHERE slug = 'steam' AND installed = 0 AND runner IS NULL")]
            if todo:
                os.makedirs(settings.GAME_CONFIG_DIR, exist_ok=True)  # (made by Lutris at its start)
                config = write_game_config("steam-system", {"game": steam_game})
                db.executemany("UPDATE games SET installed = 1, runner = 'linux', platform = 'Linux', configpath = ? "
                               "WHERE id = ?", [(config, i) for i in todo])
        db.executemany("INSERT INTO games_categories (game_id, category_id) VALUES (?, ?)",
                       [(i, launchers) for i in ids if i not in listed])
        db.executemany("DELETE FROM games_categories WHERE game_id = ? AND category_id = ?", [(i, category) for i in ids])
# Their covers from lutris.net (the missing ones; offline: next time)
try:
    sync_media(LAUNCHERS)
except Exception as e:  # noqa: BLE001
    logger.error("launcher covers: %s", e)
# Ones lutris.net has none for (Rockstar's: Lutris stretched its small banner instead), from agros-hyprland-settings'
# /etc/skel (a new account has them already; one made before them, or with them deleted, gets them here)
# (AGROS_SKEL: another /etc/skel, for tests/lutris-library.sh, as agros-links)
bundled = f"{os.environ.get('AGROS_SKEL') or '/etc/skel'}/.local/share/lutris/coverart"
for name in os.listdir(bundled) if os.path.isdir(bundled) else []:
    slug = os.path.splitext(name)[0]
    if not glob.glob(os.path.join(settings.COVERART_PATH, slug + ".*")):
        os.makedirs(settings.COVERART_PATH, exist_ok=True)
        shutil.copyfile(os.path.join(bundled, name), os.path.join(settings.COVERART_PATH, name))


# Installed games and launchers in the app menu (the Super menu): Lutris makes an entry only when asked (its install
# window's "Create application menu shortcut", off by default, or the game's right-click menu), so Epic, EA App or a
# store game installed through Lutris was in Lutris alone. Each installed one gets Lutris's own entry, once: one you
# delete (right-click > "Delete application menu shortcut") isn't made again. None for a hidden copy (another store's
# shows) or one an app in the menu already stands for (Steam: its own steam.desktop). One made here for a game no longer
# installed (its store found it gone, or it left the library; Lutris's own uninstall removes it itself) goes too
# A menu entry's icon and what the dock knows its windows by. The icon is made before the entry names it: the shell
# remembers a name it once found no icon for (Qt's lookup), and shows none for it until it restarts
#  - a Steam game: Steam's own icon for it (steam-icon, beside this: steam_icon_<id>, the one the dock and the switcher
#    find a steam_app_<id> window's app by)
#  - else Lutris's (lutris_<slug>, from lutris.net), or one taken from the game's .exe as Lutris does (its game info's
#    "extract icon"): lutris.net has none for some (EA App)
#  - a Wine game: its prefix and .exe (X-AgrOS-WinePrefix, X-AgrOS-WineExe). Under Proton every Lutris game's window
#    has one class, steam_app_default: app-for-window tells them apart by the prefix their process runs in (and the
#    .exe, for games sharing their store launcher's prefix)
def noted_exes():
    """Wine games' own programs, by their Lutris name, as user/apps.lua noted them when they ran"""
    out = {}
    try:
        with open(os.path.expanduser("~/.local/state/agros/wine-games.tsv"), encoding="utf-8") as f:
            for line in f:
                name, _, path = line.rstrip("\n").partition("\t")
                if name and path:
                    out[name] = os.path.realpath(path)
    except OSError:
        pass
    return out


def epic_game_exe(prefix, appid):
    """An Epic game's own .exe in its launcher's prefix (its manifest's install folder and program), None if not there"""
    m = (epic_manifests(prefix) or {}).get(appid) or {}
    where, exe = m.get("InstallLocation") or "", m.get("LaunchExecutable") or ""
    if not where.lower().startswith("c:\\") or not exe:
        return None
    path = os.path.join(prefix, "drive_c", *where[3:].split("\\"), *exe.replace("\\", "/").split("/"))
    return path if os.path.isfile(path) else None


def extract_exe_icon(exe, path):
    """A .exe's icon saved as a 128x128 PNG at path, as Lutris's extract_icon does it; false if it has none"""
    try:
        from lutris.util.wine.extract_icon import PEFILE_AVAILABLE, IconExtractor  # noqa: E402
        if not PEFILE_AVAILABLE:
            return False
        icon = IconExtractor(exe).get_best_icon()
        if icon.size != (128, 128):
            icon = icon.resize((128, 128))
        os.makedirs(os.path.dirname(path), exist_ok=True)
        icon.save(path)
        return True
    except Exception as e:  # noqa: BLE001 (no icon in it, an odd .exe: Lutris's icon name stays)
        logger.error("%s: no icon taken: %s", exe, e)
        return False


def entry_details(game_id, slug, service, appid, runner):
    from lutris.util import system  # noqa: E402

    icon = f"lutris_{slug}"
    if service == "steam" and appid and subprocess.run(
            [os.path.join(os.path.dirname(os.path.realpath(__file__)), "steam-icon"), appid] + ([steam_root] if steam_root else []),
            capture_output=True).returncode == 0:
        icon = f"steam_icon_{appid}"
    keys = {}
    if runner == "wine":
        from lutris.game import Game  # noqa: E402
        try:
            game = Game(game_id)
            prefix, exe = game.runner.prefix_path, game.runner.game_exe
            # An Epic game runs through its launcher (the config's .exe): its own .exe from its manifest, or its window
            # was told apart as the launcher's, and its icon was the launcher's (Epic's logo): taken from its own .exe,
            # under a name of its own (agros_egs_<app>: the launcher's, made under Lutris's name, left aside)
            if service == "egs" and prefix:
                exe = ((epic_manifests(prefix) or {}).get(appid) or {}).get("LaunchExecutable") or exe
            own = epic_game_exe(prefix, appid) if service == "egs" and prefix else None
            own_icon = f"agros_egs_{appid}"
            # Any other Wine game: its program as noted when it last ran (user/apps.lua), when it's not the one its
            # config starts (a store's launcher: EA's, Ubisoft's...)
            noted = noted_exes().get(game.name or "")
            if not own and noted and os.path.isfile(noted) and os.path.basename(noted) != os.path.basename(exe or ""):
                own, exe, own_icon = noted, noted, f"agros_game_{slug}"
            if own:
                path = os.path.join(settings.ICON_PATH, own_icon + ".png")
                if not os.path.exists(path) and extract_exe_icon(own, path):
                    system.update_desktop_icons()
                if os.path.exists(path):
                    icon = own_icon
            elif not glob.glob(os.path.join(settings.ICON_PATH, icon + ".*")) and game.runner.extract_icon(slug):
                system.update_desktop_icons()  # (the icon cache: one older than the icon hides it)
            if prefix:
                keys["X-AgrOS-WinePrefix"] = os.path.realpath(prefix)
            if exe:
                keys["X-AgrOS-WineExe"] = os.path.basename(exe.replace("\\", "/"))
        except Exception as e:  # noqa: BLE001 (a game whose config is broken: its entry anyway, Lutris's icon name)
            logger.error("%s: %s", slug, e)
    return icon, keys


def fix_entry(path, icon, keys):
    """The entry Lutris wrote with this icon and these keys"""
    try:
        with open(path, encoding="utf-8") as f:
            lines = [line for line in f.read().splitlines() if line.split("=", 1)[0] not in keys]
    except OSError:
        return
    lines = [f"Icon={icon}" if line.startswith("Icon=") else line for line in lines]
    lines += [f"{k}={v}" for k, v in keys.items()]
    text = "\n".join(lines).strip("\n") + "\n"
    with open(path, encoding="utf-8") as f:
        if f.read() == text:
            return
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(path + ".tmp", path)


def menu_entries():
    from gi.repository import GLib  # noqa: E402
    from lutris.util import xdgshortcuts  # noqa: E402

    made_file = os.path.join(os.path.dirname(mine_file), "lutris-library-menu")
    try:
        with open(made_file, encoding="utf-8") as f:
            made = {int(k): v for k, v in json.load(f).items()}  # game id: its slug (to find its entry once it's gone)
    except (OSError, ValueError, AttributeError):
        made = {}
    # The menu's other apps by name (Lutris's own entries left out: they're Lutris and these games)
    apps = set()
    for folder in [GLib.get_user_data_dir(), *GLib.get_system_data_dirs()]:
        for entry in glob.glob(os.path.join(folder, "applications", "*.desktop")):
            if os.path.basename(entry).startswith("net.lutris."):
                continue
            try:
                with open(entry, encoding="utf-8", errors="replace") as f:
                    name = next((line[5:].strip() for line in f if line.startswith("Name=")), "")
            except OSError:
                continue
            if name:
                apps.add(name.casefold())
    (hidden_id,) = db.execute("SELECT id FROM categories WHERE name = '.hidden'").fetchone()
    installed = {i: (slug, name) for i, slug, name in db.execute(
        "SELECT id, slug, name FROM games WHERE installed = 1 AND slug IS NOT NULL AND name IS NOT NULL AND id NOT IN "
        "(SELECT game_id FROM games_categories WHERE category_id = ?)", (hidden_id,))}
    added = removed = 0
    for i, slug in sorted(made.items()):
        if i not in installed:
            if xdgshortcuts.menu_launcher_exists(slug, i):
                xdgshortcuts.remove_launcher(slug, i, menu=True)
                removed += 1
            del made[i]
    rows = {i: (service, appid, runner) for i, service, appid, runner in db.execute(
        "SELECT id, service, service_id, runner FROM games WHERE installed = 1")}
    for i, (slug, name) in installed.items():
        if i in made or name.casefold() in apps:
            continue
        # (one there already, made in Lutris: counted as made, so deleting it later is final too)
        if not xdgshortcuts.menu_launcher_exists(slug, i):
            icon, keys = entry_details(i, slug, *rows[i])  # (its icon first: see entry_details)
            xdgshortcuts.create_launcher(slug, i, name, menu=True)
            fix_entry(xdgshortcuts.get_menu_launcher_path(slug, i), icon, keys)
            added += 1
        made[i] = slug
    # Ones made before (an older run's, or by Lutris): their icon and prefix brought up to date (written only when changed)
    for i, slug in made.items():
        path = xdgshortcuts.get_menu_launcher_path(slug, i)
        if i in installed and os.path.exists(path):
            fix_entry(path, *entry_details(i, slug, *rows[i]))
    with open(made_file + ".tmp", "w", encoding="utf-8") as f:
        json.dump({str(k): v for k, v in sorted(made.items())}, f)
    os.replace(made_file + ".tmp", made_file)
    return f"menu: {added} added, {removed} removed"


try:
    print(menu_entries())
except Exception as e:  # noqa: BLE001 (the library's own changes above are made: Lutris still told of them)
    logger.error("menu entries: %s", e)


# Last, after every write: an open Lutris shows the changes now, through lutris-overlay's library-refresh action,
# activated over D-Bus (the org.freedesktop.Application interface Gtk gives it). A Lutris without the action (plain, or
# an older build) shows them once restarted; none open: nothing to tell (and none started for this: NO_AUTO_START)
def lutris_refresh():
    from gi.repository import Gio, GLib  # noqa: E402

    def call(interface, method, args=None):
        return bus.call_sync("net.lutris.Lutris", "/net/lutris/Lutris", interface, method, args, None,
                             Gio.DBusCallFlags.NO_AUTO_START, 5000, None)

    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        (actions,) = call("org.gtk.Actions", "List").unpack()
    except GLib.Error:
        return "Lutris: not open"
    if "library-refresh" not in actions:
        return "Lutris: open without the refresh change (shows the changes once restarted)"
    try:
        call("org.freedesktop.Application", "ActivateAction", GLib.Variant("(sava{sv})", ("library-refresh", [], {})))
    except GLib.Error as e:
        return f"Lutris: refresh failed: {e}"
    return "Lutris: refreshed"


# Only when the library changed: lutris-library.path starts this whenever pga.db is closed after being opened for
# writing, which Lutris does on every read (opening a category, a search). A refresh with nothing new reset the view
# (selection, scroll) for nothing, and its reads (the view's, done after this has ended) started this again
print(lutris_refresh() if library() != before else "Lutris: nothing changed")

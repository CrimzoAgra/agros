#!/usr/bin/python3 -I
"""Epic Games launcher's tray icon, with its menu in the shell's own (Caelestia shows it like any app's): under a
Proton that gives Wine apps no tray icon (CachyOS's), Epic had none, and under one that does (GE-Proton) its menu was
Epic's own window, which Caelestia doesn't show. A StatusNotifierItem with a DBusMenu, while Epic runs:
  - your installed Epic games (Lutris's library, as installed now), each started through Lutris
  - Library, Store, Unreal Engine: Epic's own pages, asked of the running launcher by their links, as its menu does
  - Exit: Epic ended (its program, as the title bar's close does: it takes no request to close)
  - a click on the icon: Epic's window brought up
Started by Hyprland as Epic's window opens (user/apps.lua); quits as Epic does, or when Epic's own tray icon shows
(a Proton that has one: not two icons).
  epic-tray            run
  epic-tray --menu     print the menu it would show, as JSON (tests)"""

import json
import os
import signal
import sqlite3
import subprocess
import sys

NAME = "Epic Games Launcher"
EXE = "EpicGamesLauncher.exe"
HOME = os.path.expanduser("~")
DATA = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share")
DB = os.path.join(DATA, "lutris/pga.db")
# Epic's pages, by the links its own menu opens (the launcher takes them as an argument)
PAGES = [("Library", "library"), ("Store", "store"), ("Unreal Engine", "ue")]


def games():
    """Installed Epic games in Lutris's library: (id, name), by name"""
    try:
        with sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=5) as c:
            rows = c.execute("SELECT id, name FROM games WHERE service = 'egs' AND installed = 1").fetchall()
    except sqlite3.Error:
        return []
    return sorted(rows, key=lambda r: (r[1] or "").casefold())


def menu():
    """The menu's entries, in order: (id, label, action), a separator as (id, None, None). Ids stay the same for the
    fixed entries (1-9); games from 100"""
    items = [(100 + i, name, ("game", gid)) for i, (gid, name) in enumerate(games())]
    if items:
        items.append((9, None, None))
    items += [(1 + i, label, ("page", page)) for i, (label, page) in enumerate(PAGES)]
    return items + [(8, None, None), (7, "Exit", ("exit", None))]


def epic():
    """Epic's processes: (the umu-run that started it, its .exe's pids), or (None, [])"""
    umu, exes = None, []
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
        except OSError:
            continue
        if not argv:
            continue
        if any(a.endswith("/umu-run") for a in argv[:2]) and any(a.endswith(EXE) for a in argv):
            umu = int(pid)
        elif argv[0].replace("/", "\\").endswith("\\" + EXE):
            exes.append(int(pid))
    return umu, exes


def run_in_epic(*args):
    """Epic's launcher run again in its prefix, by its own Proton and settings (the umu-run that started it: its
    environment and its .exe), with these arguments: the running one takes them over"""
    umu, _ = epic()
    if not umu:
        return
    try:
        with open(f"/proc/{umu}/environ", "rb") as f:
            env = dict(e.decode(errors="replace").split("=", 1) for e in f.read().split(b"\0") if b"=" in e)
        with open(f"/proc/{umu}/cmdline", "rb") as f:
            argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
    except OSError:
        return
    exe = next((a for a in argv if a.endswith(EXE)), None)
    if not exe:
        return
    env["PROTON_VERB"] = "runinprefix"  # (into the running prefix, not waiting for it to end)
    subprocess.Popen([argv[0], argv[1], exe, *args] if argv[0].endswith("python3") else [argv[0], exe, *args],
                     env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def act(action):
    kind, arg = action
    if kind == "game":
        subprocess.Popen(["env", "LUTRIS_SKIP_INIT=1", "lutris", f"lutris:rungameid/{arg}"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    elif kind == "page":
        run_in_epic(f"-com.epicgames.launcher://{arg}")
    elif kind == "exit":
        for pid in epic()[1]:
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass


def show_window():
    """Epic's window to the front (brought back if minimised); none open (closed to its tray): the launcher again"""
    try:
        clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout)
    except (OSError, ValueError):
        clients = []
    win = next((c for c in clients if c.get("title") == NAME), None)
    if win:
        subprocess.run(["hyprctl", "eval", f'dots.focus_window("{win["address"]}")'], capture_output=True)
    else:
        run_in_epic()


def wine_icon_shown():
    """Epic's own tray icon there (a Proton that makes one): Wine's items are named wine-..."""
    from gi.repository import Gio
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        items = bus.call_sync("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher", "org.freedesktop.DBus.Properties",
                              "Get", GLibVariant("(ss)", ("org.kde.StatusNotifierWatcher", "RegisteredStatusNotifierItems")),
                              None, Gio.DBusCallFlags.NONE, 2000, None).unpack()[0]
    except Exception:  # noqa: BLE001 (no watcher yet: nothing to tell)
        return False
    for item in items:
        service, _, path = item.partition("/")
        try:
            title = bus.call_sync(service, "/" + path, "org.freedesktop.DBus.Properties", "Get",
                                  GLibVariant("(ss)", ("org.kde.StatusNotifierItem", "Title")),
                                  None, Gio.DBusCallFlags.NONE, 1000, None).unpack()[0]
            sid = bus.call_sync(service, "/" + path, "org.freedesktop.DBus.Properties", "Get",
                                GLibVariant("(ss)", ("org.kde.StatusNotifierItem", "Id")),
                                None, Gio.DBusCallFlags.NONE, 1000, None).unpack()[0]
        except Exception:  # noqa: BLE001
            continue
        if title == NAME and str(sid).startswith("wine-"):
            return True
    return False


def GLibVariant(sig, value):
    from gi.repository import GLib
    return GLib.Variant(sig, value)


SNI_XML = """<node><interface name="org.kde.StatusNotifierItem">
<property name="Category" type="s" access="read"/><property name="Id" type="s" access="read"/>
<property name="Title" type="s" access="read"/><property name="Status" type="s" access="read"/>
<property name="IconName" type="s" access="read"/><property name="IconThemePath" type="s" access="read"/>
<property name="Menu" type="o" access="read"/><property name="ItemIsMenu" type="b" access="read"/>
<property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
<method name="Activate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
<method name="SecondaryActivate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
<method name="ContextMenu"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
<method name="Scroll"><arg type="i" direction="in"/><arg type="s" direction="in"/></method>
<signal name="NewIcon"/><signal name="NewTitle"/><signal name="NewStatus"><arg type="s"/></signal>
</interface></node>"""

MENU_XML = """<node><interface name="com.canonical.dbusmenu">
<property name="Version" type="u" access="read"/><property name="TextDirection" type="s" access="read"/>
<property name="Status" type="s" access="read"/><property name="IconThemePath" type="as" access="read"/>
<method name="GetLayout"><arg type="i" direction="in"/><arg type="i" direction="in"/><arg type="as" direction="in"/>
<arg type="u" direction="out"/><arg type="(ia{sv}av)" direction="out"/></method>
<method name="GetGroupProperties"><arg type="ai" direction="in"/><arg type="as" direction="in"/>
<arg type="a(ia{sv})" direction="out"/></method>
<method name="GetProperty"><arg type="i" direction="in"/><arg type="s" direction="in"/><arg type="v" direction="out"/></method>
<method name="Event"><arg type="i" direction="in"/><arg type="s" direction="in"/><arg type="v" direction="in"/>
<arg type="u" direction="in"/></method>
<method name="EventGroup"><arg type="a(isvu)" direction="in"/><arg type="ai" direction="out"/></method>
<method name="AboutToShow"><arg type="i" direction="in"/><arg type="b" direction="out"/></method>
<method name="AboutToShowGroup"><arg type="ai" direction="in"/><arg type="ai" direction="out"/><arg type="ai" direction="out"/></method>
<signal name="LayoutUpdated"><arg type="u"/><arg type="i"/></signal>
<signal name="ItemsPropertiesUpdated"><arg type="a(ia{sv})"/><arg type="a(ias)"/></signal>
</interface></node>"""


def props(item):
    from gi.repository import GLib
    _, label, _ = item
    if label is None:
        return {"type": GLib.Variant("s", "separator")}
    return {"label": GLib.Variant("s", label.replace("_", "__")), "enabled": GLib.Variant("b", True),
            "visible": GLib.Variant("b", True)}


def main():
    if sys.argv[1:] == ["--menu"]:
        print(json.dumps([{"id": i, "label": label} for i, label, _ in menu()]))
        return
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    loop = GLib.MainLoop()
    state = {"items": menu(), "revision": 1}
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    service = f"org.kde.StatusNotifierItem-{os.getpid()}-1"

    def sni_call(_c, _s, _p, _i, method, _params, inv):
        if method == "Activate":
            show_window()
        elif method in ("SecondaryActivate", "ContextMenu"):
            pass  # (the menu is the shell's: it asks for it)
        inv.return_value(None)

    def sni_get(_c, _s, _p, _i, prop):
        return {"Category": GLib.Variant("s", "ApplicationStatus"), "Id": GLib.Variant("s", "agros-epic-tray"),
                "Title": GLib.Variant("s", NAME), "Status": GLib.Variant("s", "Active"),
                "IconName": GLib.Variant("s", "lutris_epic-games-store"), "IconThemePath": GLib.Variant("s", ""),
                "Menu": GLib.Variant("o", "/MenuBar"), "ItemIsMenu": GLib.Variant("b", False),
                "ToolTip": GLib.Variant("(sa(iiay)ss)", ("", [], NAME, ""))}.get(prop)

    def refresh():
        items = menu()
        if items != state["items"]:
            state["items"] = items
            state["revision"] += 1
            bus.emit_signal(None, "/MenuBar", "com.canonical.dbusmenu", "LayoutUpdated",
                            GLib.Variant("(ui)", (state["revision"], 0)))

    def layout():
        children = [GLib.Variant("(ia{sv}av)", (i, props(it), [])) for it in state["items"] for i in [it[0]]]
        return GLib.Variant("(u(ia{sv}av))", (state["revision"], (0, {"children-display": GLib.Variant("s", "submenu")},
                                                                    children)))

    def menu_call(_c, _s, _p, _i, method, params, inv):
        if method == "GetLayout":
            return inv.return_value(layout())
        if method == "GetGroupProperties":
            ids, _names = params.unpack()
            out = [(it[0], props(it)) for it in state["items"] if not ids or it[0] in ids]
            return inv.return_value(GLib.Variant("(a(ia{sv}))", (out,)))
        if method == "GetProperty":
            iid, name = params.unpack()
            it = next((it for it in state["items"] if it[0] == iid), None)
            return inv.return_value(GLib.Variant("(v)", ((props(it) if it else {}).get(name, GLib.Variant("s", "")),)))
        if method in ("Event", "EventGroup"):
            events = [params.unpack()[:2]] if method == "Event" else [(e[0], e[1]) for e in params.unpack()[0]]
            for iid, kind in events:
                it = next((it for it in state["items"] if it[0] == iid), None)
                if kind == "clicked" and it and it[2]:
                    act(it[2])
            return inv.return_value(None if method == "Event" else GLib.Variant("(ai)", ([],)))
        if method == "AboutToShow":
            refresh()
            return inv.return_value(GLib.Variant("(b)", (False,)))
        if method == "AboutToShowGroup":
            refresh()
            return inv.return_value(GLib.Variant("(aiai)", ([], [])))
        inv.return_value(None)

    def menu_get(_c, _s, _p, _i, prop):
        return {"Version": GLib.Variant("u", 3), "TextDirection": GLib.Variant("s", "ltr"),
                "Status": GLib.Variant("s", "normal"), "IconThemePath": GLib.Variant("as", [])}.get(prop)

    bus.register_object("/StatusNotifierItem", Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0], sni_call, sni_get, None)
    bus.register_object("/MenuBar", Gio.DBusNodeInfo.new_for_xml(MENU_XML).interfaces[0], menu_call, menu_get, None)

    def registered(*_):
        try:
            bus.call_sync("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher", "org.kde.StatusNotifierWatcher",
                          "RegisterStatusNotifierItem", GLib.Variant("(s)", (service,)), None, Gio.DBusCallFlags.NONE,
                          5000, None)
        except GLib.Error:
            pass  # (no tray yet: the shell picks up items as it starts)

    # One at a time (Epic's windows each start it): a second one quits as it finds the name taken
    def first(*_):
        Gio.bus_own_name_on_connection(bus, service, Gio.BusNameOwnerFlags.NONE, registered, lambda *_: loop.quit())

    Gio.bus_own_name_on_connection(bus, "org.agros.EpicTray", Gio.BusNameOwnerFlags.DO_NOT_QUEUE, first,
                                   lambda *_: loop.quit())

    def watch():
        # Epic gone, or its own icon there: this one goes. The games listed again meanwhile (one installed or removed)
        if not epic()[0] and not epic()[1] or wine_icon_shown():
            loop.quit()
            return False
        refresh()
        return True

    GLib.timeout_add_seconds(5, watch)
    for sig in (signal.SIGTERM, signal.SIGINT):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, loop.quit)
    loop.run()


if __name__ == "__main__":
    main()

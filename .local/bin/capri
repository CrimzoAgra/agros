#!/usr/bin/env bash
# Starts Capri (installed and updated by ~/.local/bin/capri-update); started again while she runs, she comes back (she
# lets only one of her run). --hidden: started put away, only her tray icon (at login: user/apps.lua).
# $CAPRI_RUN: a start script of your own run instead, e.g. for a checkout of her code you work on (set it in your
# session's environment: user/apps.lua binds her key and starts her at login when it's there, as for her build).
# Setup copies this file over yours.
[[ -n ${CAPRI_RUN:-} ]] && exec "$CAPRI_RUN" "$@"
app="${XDG_DATA_HOME:-$HOME/.local/share}/capri/current"
[[ -x $app/node_modules/.bin/electron ]] || { echo "Capri isn't installed: run capri-update" >&2; exit 1; }
cd "$app" || exit 1
# Hyprland: through XWayland, where her window lets the clicks around her through to the apps under it (a Wayland window
# can't); Xwayland 24.1 and up. --ignore-gpu-blocklist: Chromium blocks some graphics cards for WebGL (VMware's virtual
# one) though they work, and drawn on the CPU instead she keeps it busy. Log: ~/.cache/capri.log
[[ -n $HYPRLAND_INSTANCE_SIGNATURE ]] && set -- --ozone-platform=x11 "$@"
log="${XDG_CACHE_HOME:-$HOME/.cache}/capri.log"
mkdir -p "${log%/*}"
# (each start of hers adds to it: past 5 MB it's moved to capri.log.1, the one before that gone)
(($(stat -c %s "$log" 2>/dev/null || echo 0) < 5000000)) || mv -f "$log" "$log.1"
exec node_modules/.bin/electron . --ignore-gpu-blocklist "$@" >>"$log" 2>&1

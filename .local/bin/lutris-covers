#!/usr/bin/env python3
"""Real covers from SteamGridDB for Lutris games that have none, a wide one, or Steam's padded one (its header art
pasted on a stretched background, when the publisher uploaded no cover), saved where Lutris looks first
(~/.local/share/lutris/coverart/<slug>.jpg|png). Needs a SteamGridDB API key in ~/.config/dots/steamgriddb.key
(steamgriddb.com → Preferences → API); without it, does nothing. Started in the background by ~/.local/bin/lutris
when its library changed. A game SteamGridDB has nothing for is asked once (~/.cache/lutris/steamgriddb-tried)."""
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf, GLib  # noqa: E402

HOME = os.path.expanduser("~")
API = "https://www.steamgriddb.com/api/v2"
try:
    with open(f"{HOME}/.config/dots/steamgriddb.key", encoding="utf-8") as f:
        KEY = f.read().strip()
except OSError:
    KEY = ""
if not KEY:  # (an empty file too)
    sys.exit(0)
COVERS = f"{HOME}/.local/share/lutris/coverart"
TRIED = f"{HOME}/.cache/lutris/steamgriddb-tried"
# Its firewall turns away Python's default user agent
AGENT = {"User-Agent": "lutris-covers/1.0"}


def padded(path):
    """Steam's made-up cover: below the header art each column is one colour smeared down, so neighbouring rows of
    its bottom third barely differ (about 3 on 0-765 there, 11 and up on real covers)"""
    pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 60, 90, False)
    px, stride, n = pixbuf.get_pixels(), pixbuf.get_rowstride(), pixbuf.get_n_channels()
    diffs = [sum(abs(px[y * stride + x * n + c] - px[(y + 1) * stride + x * n + c]) for c in range(3))
             for y in range(62, 89) for x in range(60)]
    return sum(diffs) / len(diffs) < 6


def needs_cover(item):
    shown = next((media.path for media in item.get_media_paths() if media.exists), None)
    if not shown:
        return True
    try:
        _format, width, height = GdkPixbuf.Pixbuf.get_file_info(shown)
        # A file that isn't a picture (cut short, corrupt) reads as size -1: as good as none
        return width <= 0 or width > height or ("/steam/covers/" in shown and padded(shown))
    except GLib.Error:
        return True


def api(path):
    request = urllib.request.Request(API + path, headers={"Authorization": f"Bearer {KEY}", **AGENT})
    with urllib.request.urlopen(request, timeout=15) as response:
        return json.load(response).get("data") or []


def same_name(a, b):
    """Named alike, punctuation and case aside"""
    return [c for c in a.lower() if c.isalnum()] == [c for c in b.lower() if c.isalnum()]


def find_cover(game):
    # (only PNG and JPEG: Lutris can't show WebP, and a cover file there stops it being asked again)
    query = "?" + urllib.parse.urlencode({"dimensions": "600x900", "types": "static", "nsfw": "false",
                                          "humor": "false", "mimes": "image/png,image/jpeg"})
    if game["service"] == "steam" and game["service_id"]:
        try:
            grids = api(f"/grids/steam/{game['service_id']}{query}")
        except urllib.error.HTTPError as err:
            if err.code != 404:  # 404: a Steam game it doesn't know
                raise
            grids = []
    else:
        found = api("/search/autocomplete/" + urllib.parse.quote(game["name"], safe=""))
        # The one named like it, else the first: its first hit can be another game ("Aerial_Knight's Never Yield"
        # gives its sequel first)
        found = [f for f in found if same_name(f["name"], game["name"])] or found
        grids = api(f"/grids/game/{found[0]['id']}{query}") if found else []
    return grids[0]["url"] if grids else None


def main():
    from lutris.database.games import get_games
    from lutris.gui.views.store_item import StoreItem
    from lutris.services.base import LutrisCoverartMedium

    medium = LutrisCoverartMedium()
    try:
        with open(TRIED, encoding="utf-8") as f:
            tried = set(f.read().split())
    except OSError:
        tried = set()
    for game in get_games():
        slug = game["slug"]
        if slug in tried or any(os.path.exists(f"{COVERS}/{slug}.{ext}") for ext in ("jpg", "png")):
            continue
        if not needs_cover(StoreItem(game, None, medium)):
            continue
        try:
            url = find_cover(game)
            if url:
                with urllib.request.urlopen(urllib.request.Request(url, headers=AGENT), timeout=30) as response:
                    data = response.read()
                # By what the image is, not its address
                ext = "png" if data[:4] == b"\x89PNG" else "jpg" if data[:2] == b"\xff\xd8" else None
                if not ext:
                    raise ValueError(f"not a PNG or JPEG: {url}")
                os.makedirs(COVERS, exist_ok=True)
                with open(f"{COVERS}/{slug}.{ext}.part", "wb") as f:
                    f.write(data)
                os.replace(f"{COVERS}/{slug}.{ext}.part", f"{COVERS}/{slug}.{ext}")
                print(f"{slug}: {url}")
            else:
                print(f"{slug}: none on SteamGridDB")
        # Offline, a bad key, a timeout, an odd answer: this game is asked again next time, the others carry on
        except (OSError, ValueError, KeyError, IndexError, TypeError) as err:
            print(f"{slug}: {err}", file=sys.stderr)
            if getattr(err, "code", None) == 401:
                return  # the key turned down: the same for every game, not a request each
            continue
        tried.add(slug)
        os.makedirs(os.path.dirname(TRIED), exist_ok=True)
        with open(TRIED, "a", encoding="utf-8") as f:
            f.write(slug + "\n")


if __name__ == "__main__":
    main()

#!/usr/bin/env bash
# Updates everything now, in a terminal you can watch: the system (AgrOS's AUR apps too: Equibop, Boxflat... are in
# [agros]), other AUR apps, firmware, Flatpaks (Spotify, Nuvio, ArtCraft), any AppImages you've installed, Capri, your
# Proton builds and developer tools. The same as the boot-time auto-update (each kind but the system's and the AUR's:
# update-kinds, which both run).
#   update-apps           update everything (the Updates app runs this and shows its output)
#   update-apps --list    what's waiting, one per line: kind<TAB>name<TAB>old<TAB>new (update-kinds --list: system,
#                         aur, firmware, flatpak, appimage, capri, proton or dev; offline when the package servers
#                         can't be reached)
#   update-apps --check   if updates are waiting, a notification whose "Update now" opens the Updates app and starts
#                         (update-check.timer); the same updates aren't announced twice
#   update-apps --check-now   check and always say the result in a notification; clicking it opens the Updates app.
#                         Returns as soon as the check is done (the Super menu's button spins until then)
#   (both checks hand the app what they found, UPDATES_LIST: it shows that list at once, not checking again)
#   update-apps --qt-mark / --qt-rebuild   this run's own steps around its pacman -Syu, alone (tests/update-apps.sh):
#                         the Qt Quickshell and Caelestia were built for written down (when it isn't yet), then what's
#                         built on it rebuilt if Qt changed since
#   update-apps --qt-stale   whether Qt changed since they were built (exit 0: it did; agros-check's)
set -uo pipefail
helpers=$(dirname "$(readlink -f "$0")")  # (the shared helpers, beside this: notify-wait)

# Your password once, from a dialog when there's no terminal (the Updates app); sudo keeps it for the whole run
# AUR build scripts shown for review when run in a terminal; the Updates app has no input to page through them with
# (its log is all it shows), so from there AUR updates are built WITHOUT that review (--skipreview: paru would wait on a
# pager no one sees). Which ones it builds is said first, in that log; those the boot's builds hold for review are left
# out (held_aur)
paru=(paru --sudoloop)
[[ -t 0 ]] || { export SUDO_ASKPASS=$helpers/askpass; paru+=(--sudoflags -A --skipreview); }
au_dir=${AUTO_UPDATE_DIR:-/var/lib/auto-update}
# held_aur: the AUR apps the boot's builds hold until their build files are reviewed (auto-update-aur's guard), one
# name a line: those whose base's AUR maintainers changed (its aur-maintainer-changed, "<base> <maintainers> <version>"
# a line, root's but readable by all: 0644 in a 0755 folder), and those a signed repository installed that dropped them
# since (the AUR's of that name someone else's). Built unreviewed here, the next boot took those maintainers as reviewed
held_aur() {
    local bases n v b
    bases=" $(awk '{ printf "%s ", $1 }' "$au_dir/aur-maintainer-changed" 2>/dev/null) "
    # (a split base's packages by the base pacman wrote down for each)
    while read -r n v; do
        b=$(sed -n '/^%BASE%$/{n;p;q;}' "${PACMAN_DB_DIR:-/var/lib/pacman}/local/$n-$v/desc" 2>/dev/null)
        [[ $bases == *" ${b:-$n} "* ]] && echo "$n"
    done < <(pacman -Qm 2>/dev/null)
    LC_ALL=C pacman -Qmi 2>/dev/null | awk -F' *: ' '$1 == "Name" { n = $2 } $1 == "Validated By" && $2 ~ /Signature/ { print n }'
}
held=()

# The AUR apps built on a runtime (update-kinds' list: Qt, whose private parts Quickshell, Caelestia's own library and
# qtengine use, so they hold only for the exact Qt they were built with; Python's minor version, whose modules folder
# changes) are rebuilt when its paru -Syu brings a new one: the same ones the boot's AUR builds rebuild (update-kinds
# --built-on), those from the AUR or [agros], not a prebuilt -bin. A Qt changed outside it (pacman by hand) too: the
# Qt they were built for is written down (~/.local/state/quickshell-qt; at the first run, the one now, as it works).
# (update-kinds --qt-now: each one's version without its package release, "none" when it isn't installed)
qt_now() { "$helpers/update-kinds" --qt-now; }
qt_stamp="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell-qt"
# The Qt the boot's update last installed them rebuilt for, at shutdown (auto-update): built for this one too
qt_built() { [[ $(cat "${AUTO_UPDATE_DIR:-/var/lib/auto-update}/qt-built" 2>/dev/null) == "$(qt_now)" ]]; }
# (its folder made first: not there, the stamp was never written and every run rebuilt them). Written again while it
# names a Qt package that wasn't installed then ("none"): what's built since was built for the Qt there is now, not one
# to rebuild for
qt_mark() { mkdir -p "${qt_stamp%/*}" && { [[ -s $qt_stamp && $(cat "$qt_stamp") != *" none "* ]] || qt_now >"$qt_stamp"; }; }
# qt_rebuild ["name old -> new" lines: the runtimes the paru -Syu changed]
qt_rebuild() {
    local changes=${1:-} old new p pkgs=() i
    # (Qt changed since the stamp: as "name old -> new" lines too)
    if [[ $(cat "$qt_stamp" 2>/dev/null) != "$(qt_now)" ]] && ! qt_built; then
        { read -ra old <"$qt_stamp"; } 2>/dev/null
        read -ra new <<<"$(qt_now)"
        for ((i = 0; i + 1 < ${#new[@]}; i += 2)); do
            [[ ${old[i + 1]:-none} != none && ${new[i + 1]} != none ]] && changes+=$'\n'"${new[i]} ${old[i + 1]} -> ${new[i + 1]}"
        done
    fi
    local agros=() rc=0
    for p in $("$helpers/update-kinds" --built-on <<<"$changes"); do
        [[ $p != *-bin ]] || continue
        # (one this run's update brought in itself: its repo's rebuild for the new runtime, as the boot's skips it)
        grep -q "^${p//./\\.} " <<<"$changes" && continue
        if grep -qxF -- "$p" <<<"$(pacman -Slq agros 2>/dev/null)"; then agros+=("$p")
        elif [[ " ${held[*]} " == *" $p "* ]]; then
            echo "!! $p wasn't rebuilt for the new runtime: held for review (to review it, run update-apps in a terminal)"
            rc=1
        elif pacman -Qm "$p" >/dev/null 2>&1; then pkgs+=("aur/$p"); fi
    done
    if ((${#pkgs[@]} + ${#agros[@]})); then
        command -v paru >/dev/null || { echo "!! A runtime (Qt, Python) was updated, but there's no paru to rebuild what's built on it with"; return 1; }
        echo "A runtime (Qt, Python) was updated: rebuilding what's built on it: ${agros[*]} ${pkgs[*]#aur/}"
        # (CI's order: Quickshell first, Caelestia's shell last, built on it)
        mapfile -t agros < <(printf '%s\n' "${agros[@]}" | sed '/^$/d' |
            awk '{ print ($0 == "quickshell-git" ? 0 : $0 == "caelestia-shell" ? 2 : 1), $0 }' | sort | cut -d' ' -f2)
        ((${#agros[@]} == 0)) || rebuild_agros "${agros[@]}" || rc=1
        ((${#pkgs[@]} == 0)) || "${paru[@]}" -S --rebuild --noconfirm "${pkgs[@]}" || rc=1
    fi
    ((rc == 0)) || return 1
    qt_now >"$qt_stamp"
}
# rebuild_agros <name>...: [agros]'s own (built there from the AUR, AgrOS's fix added: aur-agros-patch) rebuilt as the
# boot's rebuild does them, through auto-update-aur --fetch: the AUR's build files of the version installed (what CI built
# and tested), AgrOS's fix added, the sources checked. paru -S's would be the AUR's newest, without the fix
rebuild_agros() {
    local p base have rel dots built tmp rc=0 done=' ' cache=${XDG_CACHE_HOME:-$HOME/.cache}
    # (in your cache, on disk: a build in /tmp takes memory)
    mkdir -p "$cache" || return 1
    # (one a run cut off left there (logged out or shut down mid-build, a power cut: nothing took it away), a whole build
    # kept in your cache for good: its own folders alone, by their mktemp name, hours old, taken away)
    find "$cache" -mindepth 1 -maxdepth 1 -type d -name 'agros-rebuild.??????' -mmin +360 -exec rm -rf {} + 2>/dev/null
    tmp=$(mktemp -d "$cache/agros-rebuild.XXXXXX") || return 1
    for p; do
        base=$(curl -fsS --connect-timeout 10 -m 60 -G https://aur.archlinux.org/rpc/v5/info --data-urlencode "arg[]=$p" |
            jq -r '.results[0].PackageBase // empty' 2>/dev/null)
        [[ $base =~ ^[A-Za-z0-9@_+][A-Za-z0-9@._+-]*$ ]] || { echo "!! $p: not found on the AUR (offline?), not rebuilt"; rc=1; continue; }
        [[ $done != *" $base "* ]] || continue
        done+="$base "
        have=$(pacman -Q "$p" 2>/dev/null | cut -d' ' -f2)
        "${AUTO_UPDATE_AUR:-/usr/lib/agros/auto-update-aur}" --fetch "$tmp" "$base${have:+=$have}" ||
            { echo "!! $base: its build files of $have, with AgrOS's fix, couldn't be had: not rebuilt"; rc=1; continue; }
        # One CI relabelled (2.5.0-1.1: its own rebuild for new libraries, a release makepkg can't make): built here at
        # the AUR's release it would be older than CI's, and the next update put CI's back, built for the old libraries.
        # Left to the boot's rebuild, which relabels it as CI does (auto-update-aur), or to [agros]'s next rebuild
        rel=$(cd "$tmp/$base" && bash -c '. ./PKGBUILD >/dev/null 2>&1; echo "$pkgrel"')
        dots=${have##*-} dots=${dots//[^.]/} built=${rel//[^.]/}
        if ((${#dots} > ${#built})); then
            echo "!! $p: its version installed, $have, is AgrOS's own rebuild: left for AgrOS's next one"
            rc=1; continue
        fi
        # (its sources already fetched and checked there: not again)
        (cd "$tmp/$base" && SRCDEST=$tmp/src/$base "${paru[@]}" -Ui --noconfirm) || rc=1
    done
    rm -rf "${tmp:?}"
    return $rc
}
case ${1:-} in
    # (never failing: no stamp written, the next run writes it)
    --qt-mark) qt_mark || echo "!! The Qt Quickshell was built for couldn't be written down ($qt_stamp)"; exit 0 ;;
    # agros-check's: Qt changed since Quickshell and Caelestia were built (exit 0), else 1
    --qt-stale) [[ -s $qt_stamp && $(cat "$qt_stamp") != "$(qt_now)" ]] && ! qt_built; exit ;;
    --qt-rebuild) qt_rebuild; exit ;;
esac

[[ ${1:-} == --list ]] && exec "$helpers/update-kinds" --list
list_updates() { "$helpers/update-kinds" --list; }

# summary <list>: sets title ("3 updates available") and names (a few of them, so it's clear what's waiting)
summary() {
    local n
    n=$(wc -l <<<"$1")
    title="$n update$( ((n > 1)) && echo s) available"
    names=$(head -4 <<<"$1" | sed 's/^com\.spotify\.Client$/Spotify/; s|^.*/||' | paste -sd, | sed 's/,/, /g')
    ((n > 4)) && names+=", ..."
}

# A snapshot booted from the boot menu (its root an overlay in RAM: agros-boot's snapshot-overlay or grub-btrfs's), or
# the live USB: an update there is gone at the next boot. Not updated, said (as the boot's auto-update does), and no
# update offered
snapshot() { [[ $(findmnt -no FSTYPE / 2>/dev/null) == overlay ]]; }
# An admin's (wheel) alone: another account can't sudo (the boot's update installs them all the same)
admin() { [[ " $(id -nG 2>/dev/null) " == *" wheel "* ]]; }

# found <list>: what a check found, in a file of yours (RAM) the Updates app opened from its notification shows at once
# (UPDATES_LIST; it checks again when it's older than 15 minutes, and removes it)
found() { local f; f=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/update-apps-list.XXXXXX") && printf '%s\n' "$1" >"$f" && echo "$f"; }

if [[ ${1:-} == --check-now ]]; then
    all=$(list_updates)
    listed=$(found "$all")
    list=$(grep -v '^offline' <<<"$all" | cut -f2 | sed '/^$/d' | sort -u)
    if grep -q '^offline' <<<"$all"; then
        title="Couldn't check for updates"
        names="No connection to the package servers"
    elif [[ -n $list ]]; then
        summary "$list"
    else
        title="Everything is up to date"
        names="System, AUR apps, firmware, Flatpaks, AppImages, Proton and developer tools"
    fi
    # The notification waits on its own, so this returns now (sh's own $1/$2/$3, not this script's)
    # shellcheck disable=SC2016
    setsid sh -c 'a=$(timeout 1h "$3/notify-wait" -a Updates -i system-software-update -A "default=Open Updates" "$1" "$2")
        [ "$a" = default ] && exec "$3/app-launch" env UPDATES_LIST="$4" "$3/updates"; rm -f "$4"' \
        sh "$title" "$names" "$helpers" "$listed" >/dev/null 2>&1 &
    exit 0
fi

if [[ ${1:-} == --check ]]; then
    # (an admin's only: another account's "Update now" only failed)
    admin || exit 0
    ! snapshot || exit 0
    all=$(list_updates)
    list=$(grep -v '^offline' <<<"$all" | cut -f2 | sed '/^$/d' | sort -u)
    [[ -n $list ]] || exit 0
    seen="${XDG_CACHE_HOME:-$HOME/.cache}/update-apps-notified"
    [[ $list == "$(cat "$seen" 2>/dev/null)" ]] && exit 0
    summary "$list"
    listed=$(found "$all")
    # Noted as announced once the notification was there (not if Caelestia restarted under it: offered again next time).
    # Until the next check at most: a notification no one clicks never says it's gone, and this check would wait (its
    # unit "starting") through the ones after it, so updates that came since went unannounced
    # (124: that time ran out, the notification there all along: not offered again for the same updates)
    action=$(timeout 5h50m "$helpers/notify-wait" -a "Updates" -i system-software-update -A "default=Update now" "$title" "$names")
    rc=$?
    ((rc == 0 || rc == 124)) && printf '%s\n' "$list" >"$seen"
    # In a unit of its own, as from the launcher: closing the window (this service ending) doesn't stop the update
    [[ $action == default ]] && exec "$helpers/app-launch" env UPDATES_START=1 UPDATES_LIST="$listed" "$helpers/updates"
    rm -f "$listed"
    exit 0
fi

if snapshot; then
    echo "This system runs from a snapshot (or the live USB), its changes in RAM: nothing updated, none of it kept."
    echo "Boot the system itself (the boot menu's first entry) to update."
    exit 1
fi
# Another account: nothing tried (it failed at sudo, part of the way in), said (the Updates app offers it no "Update
# all", so this is from a terminal)
if ! admin; then
    echo "Only an administrator can install updates: one of them has to run Updates."
    exit 1
fi
# Nor on a battery nearly empty (as the shutdown's install, auto-update): a power cut mid-install leaves packages half
# in, which pacman doesn't undo
if charge=$("$helpers/battery-low"); then
    echo "On battery, nearly empty ($charge percent): nothing updated. Plug the charger in, then update."
    exit 1
fi
# Your password once for the whole run (the Updates app's, no terminal): each paru of it (the lists, the keyrings, the
# update, the rebuilds) is a process of its own, and with no terminal sudo remembers it per calling process, so each
# asked again (three dialogs). Asked here and checked, then kept for this run only in a file only you can read, in your
# runtime folder (RAM), which askpass hands each sudo; gone when the run ends. Not asked when sudo needs none
if [[ ! -t 0 ]] && ! sudo -n true 2>/dev/null; then
    pass_file=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/update-apps-pass.XXXXXX") || { echo "!! Couldn't start: no room for the run's files"; exit 1; }
    trap 'rm -f "$pass_file"' EXIT
    ok=
    for _ in 1 2 3; do
        pw=$(AGROS_ASKPASS_FILE='' "$helpers/askpass" "Your password, to install the updates") ||
            { echo "Not updated: no password given."; exit 1; }
        if printf '%s\n' "$pw" | sudo -S -p '' -v 2>/dev/null; then ok=1; break; fi
    done
    [[ $ok ]] || { echo "Not updated: the password was wrong three times."; exit 1; }
    printf '%s\n' "$pw" >"$pass_file"
    unset pw
    export AGROS_ASKPASS_FILE=$pass_file
fi
status=0 # 1 if any step failed (the Updates app says "Finished, with problems")
echo "== System and AUR apps"
# The boot's own downloads first (both fetching the same package into the cache at once would corrupt it): while it
# holds its lists' lock, or marks it's downloading (downloading: from the start of its run to the end of its download,
# then again around its AUR builds' own; not through the Flatpaks, nor the builds, which can take long)
downloading() { systemctl is-active -q auto-update 2>/dev/null && [[ -e $au_dir/db/db.lck || -e $au_dir/downloading ]]; }
downloading && echo "Waiting for the update started at boot to finish downloading..."
while downloading; do sleep 5; done
qt_mark
if [[ ! -t 0 ]]; then
    mapfile -t held < <(held_aur | sort -u)
    # (paru -Qua: "<name> <old> -> <new>" each, exit 1 when none; failing (the AUR not reached), its error instead)
    qua=$(LC_ALL=C paru -Qua 2>&1)
    qua_rc=$?
    aur=$(grep -F ' -> ' <<<"$qua" | "$helpers/updates-pending" | awk -v h=" ${held[*]} " 'index(h, " " $1 " ") == 0 { print $1 }' | paste -sd' ')
    if ((qua_rc)) && [[ -n $qua ]] && grep -qvF ' -> ' <<<"$qua"; then
        echo "The AUR apps about to be built, their build scripts not reviewed, couldn't be listed (paru -Qua: $(grep -vF ' -> ' <<<"$qua" | head -1))"
    elif [[ -n $aur ]]; then
        echo "AUR apps built now, their build scripts not reviewed (update-apps in a terminal shows them first): $aur"
    fi
    ((${#held[@]} == 0)) ||
        echo "Not updated, held for review (their AUR maintainers changed, or the repository they came from dropped them): ${held[*]}. To review them: run update-apps in a terminal, which shows what their build scripts changed before building them"
fi
# Power off and sleep held off while pacman installs (and the AUR apps build): killed by shutdown, pacman leaves its
# lock behind, and every install after it fails on that. Held by a process of its own, ended after (or with this).
# The lid too: logind suspends on it whatever sleep lock is held (LidSwitchIgnoreInhibited=yes, its default), and only
# a handle-lid-switch lock stops that. Where that one's refused (polkit), power off and sleep alone
inhibitor=
for what in sleep:shutdown:handle-lid-switch sleep:shutdown; do
    systemd-inhibit --what="$what" --mode=block --who=Updates --why="Installing updates" true 2>/dev/null || continue
    systemd-inhibit --what="$what" --mode=block --who=Updates --why="Installing system and AUR updates" \
        tail --pid=$$ -f /dev/null </dev/null >/dev/null 2>&1 &
    inhibitor=$!
    break
done
runtimes=$("$helpers/update-kinds" --runtimes-now)
# Through the upstream gate (update-gate): the lists synced first, then Hyprland and its libraries updated only to
# versions AgrOS's CI has checked (held, said, else)
gated=$(mktemp --tmpdir agros-pacman.XXXXXX.conf)
if "${paru[@]}" -Sy --noconfirm; then
    waits=$("$helpers/update-gate" /etc/pacman.conf "$gated") || cp /etc/pacman.conf "$gated"
    [[ -z $waits ]] || printf "Waits for AgrOS's check (comes with a later update): %s\n" "$waits"
    # The keyrings first, on their own, where there's a newer one (as the boot's update does, auto-update): a package
    # signed by a key the keyring here doesn't have yet (weeks offline, a new packager's) failed the whole update
    mapfile -t keys < <(LC_ALL=C pacman -Qu --config "$gated" 2>/dev/null | "$helpers/updates-pending" |
        awk '$1 ~ /^(archlinux|cachyos|agros)-keyring$/ { print $1 }')
    if ((${#keys[@]})); then
        echo "The keyrings first: ${keys[*]}"
        "${paru[@]}" --config "$gated" -S --needed --noconfirm "${keys[@]}" ||
            { echo "!! The keyrings couldn't be installed first: the rest tried with the keys as they are"; status=1; }
    fi
    # (those held for review left out: --ignore, a comma between two)
    ignore=()
    ((${#held[@]} == 0)) || ignore=(--ignore "$(IFS=,; echo "${held[*]}")")
    "${paru[@]}" --config "$gated" -Su --noconfirm "${ignore[@]}" || status=1
    # The packages AgrOS dropped (agros-system's list: an app it replaced), removed once an update took them out of
    # what AgrOS installs, as the boot's update does (auto-update): only those in as a dependency that nothing needs
    # now. Its failing never fails the update: said, and tried again at the next one
    mapfile -t gone < <(pacman -Qdtq 2>/dev/null | grep -xF -f "${AGROS_RETIRED:-/usr/share/agros/retired}" 2>/dev/null)
    if ((${#gone[@]})); then
        echo "Removing what AgrOS no longer installs: ${gone[*]}"
        "${paru[@]}" -Rns --noconfirm "${gone[@]}" || echo "!! Not removed (${gone[*]}): tried again at the next update"
    fi
else
    status=1
fi
rm -f "$gated"
# (the runtimes it changed: "name old -> new")
changes=$(awk 'NR == FNR { old[$1] = $2; next } ($1 in old) && old[$1] != $2 { print $1, old[$1], "->", $2 }' \
    <(printf '%s\n' "$runtimes") <("$helpers/update-kinds" --runtimes-now))
qt_rebuild "$changes" || status=1
[[ -z $inhibitor ]] || kill "$inhibitor" 2>/dev/null
# The rest, kind by kind (each under its own "== " title)
"$helpers/update-kinds" firmware flatpak appimage capri proton dev || status=1
rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/update-apps-notified"
echo
# In a terminal: wait, so the output can be read (the Updates app shows it itself), saying how it went as the Updates
# app does: "Done." under a step that failed (its error scrolled away above) read as everything updated
if [[ -t 0 ]]; then
    if ((status)); then read -rsn1 -p "Finished, with problems (see above). Press any key to close."
    else read -rsn1 -p "Done. Press any key to close."; fi
fi
exit $status

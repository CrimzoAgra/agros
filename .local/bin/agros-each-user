#!/usr/bin/env bash
# Runs a command as each AgrOS user: regular accounts (UID 1000 and up, with a home and a login shell) whose home has
# that command linked in ~/.local/bin (AgrOS gives every new account those links). For pacman's hooks and the boot's
# update, which run as root and serve every user. Both run it in a session of its own, nothing on its input, its output
# through pipes (its control characters left out), the caller's stop passed on to it and then taken here too (as(),
# below).
#   agros-each-user <command> [args...]    the command's name in ~/.local/bin: AgrOS's own, where that's a link to it
#                                          (run from /usr/lib/agros/bin; AGROS_LIB: the tests'), for 10 min at most
#   agros-each-user --limit <s> <command> [args...]   the same, for that many seconds at most
#   agros-each-user --list                 the users, one per line
#   agros-each-user --as <user> [--fd <n>]... <command...>   a command as that user (or account: the boot's AUR
#                                          builds' agros-aur), given only its own descriptors and those --fd names
#                                          (update-kinds --boot's notes, fd 3); from root: setpriv, never PAM (runuser, su and
#                                          sudo open a logind session through pam_systemd: its processes left the
#                                          calling service's cgroup and limits, and the user counted as logged in)
#   agros-each-user --sessions             the session bus of each one logged in to a desktop (/run/user/<uid>/bus),
#                                          one per line: for a system service's notes (not root's, nor the login
#                                          screen's greeter, nor a session with no desktop: an SSH login, a background
#                                          one)
#   agros-each-user --notify [--user <name>] <notify-send options and text>
#                                          said on each one's desktop (or that user's), now or once they log in (up to
#                                          12 h): in a unit of its own (systemd-run), so it returns at once and outlives
#                                          the caller. The system's one way to say something to the users
#   agros-each-user --notify-wait [--user <name>] ...   the same, waiting for it here: exit 0 once someone was told
#   (AGROS_RUN_USER: another /run/user, the tests', for both)
#   (AGROS_NO_USER_HOOKS=1: <command> run for no one: a new system's install putting packages in (agros-iso's
#   agros-gate-install), whose hooks' per-user work (hyprbars built, the config checked) is the first login's, not the
#   installer's to wait on)
set -uo pipefail
helpers=$(dirname "$(readlink -f "$0")")
users() {
    getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ {print $1 ":" $6}' |
        while IFS=: read -r u h; do [[ -d $h ]] && echo "$u:$h"; done
}
# (in a session of its own, with no terminal and nothing to read: a user's command, which that user can change, never
# gets root's terminal (a pacman hook run from one had it, to read its keys or type into it), nor root's own files: for
# its output (auto-update's log) pipes this opens and waits for, in order before this returns; no other descriptor of
# the caller's (auto-update's open /boot) but the ones --fd names. Out of the caller's process group, so a stop of the
# caller (a timeout's, a signal's) is passed on to its whole session (what it started too, a timeout of its own in a
# group of its own), then taken by the caller itself (a loop over the users stops too, not on to the next one).
# Waited for in the background: a trap runs only between commands)
stop_run() { pkill -TERM -s "$1" 2>/dev/null || kill -TERM "$1" 2>/dev/null; }  # (its session; before setsid, itself)
# (its output with no control characters but tabs and newlines: a user's command writing escapes to the admin's
# terminal (a pacman hook's) could rewrite what's on it, or its title. Line by line, as it comes. Exec'd, the reader
# itself the pipe's process: stopped below, nothing of it left holding the caller's output)
clean=(stdbuf -oL tr -d '\000-\010\013-\037\177')
# (--limit <s>: stopped after that long, its whole session, killed 10 s later if it's still there)
as() {
    local u=$1 p='' sig='' rc o e s f n w keep=' ' limit='' outs=(); shift
    while [[ ${1:-} == --fd || ${1:-} == --limit ]]; do
        if [[ $1 == --fd ]]; then keep+="$2 "; else limit=$2; fi
        shift 2
    done
    exec {o}> >(exec "${clean[@]}") && outs+=($!)
    # (one pipe for both when they go to the same place (a terminal, the log): its lines in the order it wrote them,
    # not a stderr line cut into a stdout one by two readers)
    local f1 f2 fds=/proc/$BASHPID/fd  # (this shell's: $BASHPID in a $(...) is that subshell's)
    f1=$(stat -L -c %d:%i "$fds/1" 2>/dev/null) f2=$(stat -L -c %d:%i "$fds/2" 2>/dev/null)
    if [[ $f1 == "$f2" ]]; then
        exec {e}>&"$o"
    else
        exec {e}> >(exec "${clean[@]}" >&2) && outs+=($!)
    fi
    # (set before it starts: a stop in between not missed)
    for s in TERM INT HUP; do
        # shellcheck disable=SC2064  # (each signal's name, now)
        trap "sig=$s; [[ -z \$p ]] || stop_run \$p" "$s"
    done
    (
        exec </dev/null 1>&"$o" 2>&"$e"
        for f in /proc/self/fd/*; do
            n=${f##*/}
            (( n > 2 )) && [[ $keep != *" $n "* ]] && { exec {n}>&-; } 2>/dev/null
        done
        exec setpriv --reuid="$(id -u "$u")" --regid="$(id -g "$u")" --init-groups --reset-env setsid -w "$@"
    ) &
    p=$!
    # (a stop between the start and p set: its trap had no process to pass it on to)
    [[ -z $sig ]] || stop_run "$p"
    # (its time: a sleep of its own, waited for beside it, holding none of its output's pipes; out, its session stopped,
    # then 10 s on, killed)
    local timer='' done_pid late=''
    [[ -z $limit ]] || { ( exec {o}>&- {e}>&-; exec sleep "$limit" ) & timer=$!; }
    # (again while a stop interrupted the wait and it's still this shell's running job: a pid, reused, never waited on)
    while :; do
        done_pid=
        if [[ -n $timer ]]; then wait -n -p done_pid "$p" "$timer"; rc=$?; else wait "$p"; rc=$?; fi
        if [[ -n $timer && ${done_pid:-} == "$timer" ]]; then
            if [[ -z $late ]]; then
                echo "agros-each-user: ${cmd:-$1} as $u still ran after $limit s: stopped" >&2
                late=1
                stop_run "$p"
                ( exec {o}>&- {e}>&-; exec sleep 10 ) & timer=$!
            else
                pkill -KILL -s "$p" 2>/dev/null
                timer=''
            fi
            continue
        fi
        [[ -n $sig ]] && grep -qx "$p" <<<"$(jobs -pr)" || break
    done
    [[ -z $timer ]] || kill "$timer" 2>/dev/null
    # (stopped for its time: what it left in its session too, not left running on)
    [[ -z $late ]] || pkill -KILL -s "$p" 2>/dev/null
    trap - TERM INT HUP
    exec {o}>&- {e}>&-
    # (its output's end: all of it, however long a slow terminal takes to read it, but not for as long as something
    # holds the pipes: 3 s at most when what it left still runs in its session (a notification waiting for the desktop,
    # kept: not this one's to stop), 60 s at most for one gone to a session of its own)
    ( sleep 3; pgrep -s "$p" >/dev/null || sleep 57; kill "${outs[@]}" ) 2>/dev/null & w=$!
    wait "${outs[@]}" 2>/dev/null
    pkill -P "$w" sleep 2>/dev/null; kill "$w" 2>/dev/null
    [[ -z $sig ]] || kill -s "$sig" "$BASHPID"
    return "$rc"
}
# desktop <user>: one of their logind sessions is a desktop's (Wayland or X11, a user's class: not a greeter's, a
# background one, nor a text or SSH login)
desktop() {
    local s p
    for s in $(loginctl show-user "$1" -p Sessions --value 2>/dev/null); do
        p=$(loginctl show-session "$s" -p Type -p Class 2>/dev/null)
        grep -qxE 'Type=(wayland|x11)' <<<"$p" && grep -qx 'Class=user' <<<"$p" && return 0
    done
    return 1
}
# (only a bus that's the user's own, not a link: theirs to replace, e.g. by a link to another's socket or a root file)
sessions() {
    local u b uid
    while IFS=: read -r u _; do
        [[ -z ${1:-} || $u == "$1" ]] || continue
        uid=$(id -u "$u")
        b=${AGROS_RUN_USER:-/run/user}/$uid/bus
        [[ -e $b && ! -L $b && $(stat -c %u "$b") == "$uid" ]] && desktop "$u" && echo "$b"
    done < <(users)
}
case ${1:-} in
    --list) users | cut -d: -f1; exit 0 ;;
    --sessions) sessions; exit 0 ;;
    --as) shift; as "$@"; exit ;;
    --notify)
        shift
        exec systemd-run --quiet --collect "$helpers/agros-each-user" --notify-wait "$@" ;;
    --notify-wait)
        shift
        only=
        [[ ${1:-} == --user ]] && { only=$2; shift 2; }
        for _ in $(seq 1440); do
            buses=$(sessions "$only")
            [[ -n $buses ]] && break
            sleep 30
        done
        told=1
        for bus in $buses; do
            uid=${bus%/bus} uid=${uid##*/}
            # (notify-when-up: the desktop's notification server may still be starting. The group the account's, not
            # the bus file's: theirs to change)
            as "$uid" env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" XDG_RUNTIME_DIR="${bus%/bus}" \
                "$helpers/notify-when-up" "$@" >/dev/null 2>&1 && told=0
        done
        exit $told ;;
esac
# (--limit <s>: a hook's own time limit for each user's run, shorter than 10 min where its command takes far less)
limit=600
[[ ${1:-} == --limit ]] && { limit=$2; shift 2; }
limit=${AGROS_EACH_USER_LIMIT:-$limit}
cmd=${1:?usage: agros-each-user [--limit <s>] <command> [args...]}
shift
[[ ${AGROS_NO_USER_HOOKS:-} != 1 ]] || exit 0
rc=0
# (the list read whole first: none of it left open for a command, a user's, to read the next users away)
mapfile -t list < <(users)
# Only AgrOS's own program (the user's link to it), run from where it's installed: a user's file of their own there is
# theirs to run, not root's pacman's to wait on (another account's endless one held its lock, and every update). Each
# under a time limit (--limit, else 10 min; AGROS_EACH_USER_LIMIT, seconds: the tests'), then stopped
ours=$(readlink -f "${AGROS_LIB:-/usr/lib/agros}/bin/$cmd")
for entry in "${list[@]}"; do
    u=${entry%%:*} h=${entry#*:}
    [[ -x $h/.local/bin/$cmd ]] || continue
    if [[ $(readlink -f "$h/.local/bin/$cmd") != "$ours" || ! -x $ours ]]; then
        echo "agros-each-user: $u's ~/.local/bin/$cmd isn't AgrOS's: not run for them" >&2
        continue
    fi
    run=${AGROS_RUN_USER:-/run/user}/$(id -u "$u")
    as "$u" --limit "$limit" \
        env XDG_RUNTIME_DIR="$run" DBUS_SESSION_BUS_ADDRESS="unix:path=$run/bus" "$ours" "$@" || rc=1
done
exit $rc

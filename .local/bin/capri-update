#!/usr/bin/env bash
# Installs and updates Capri, the Edgerunners 2 desktop companion: my fork (CrimzoAgra/capri-overlay, its main), a
# Tauri app (Rust, her page in WebKitGTK, native on Wayland) that no longer takes the original's (CapriDesktop's)
# Electron releases.
#   capri-update          install her, or update her when my fork has moved on (update-kinds' capri: the Updates app,
#                         when you start it, as AUR apps: the code is built and checked, so not unseen at boot)
#   capri-update --check  only fetch and say whether an update is waiting ("capri: update available (<commit>)":
#                         update-kinds' list, and its --boot run, auto-update's, instead of the update)
# Exit 1 when it failed, 2 when it failed and said so in a notification itself (dotfiles-check's install at login then
# adds none of its own)
# Built in her clone (~/.local/share/capri/src), Rust's build kept in ~/.local/share/capri/target between runs (one
# from scratch takes minutes and ~1.5 GB: each update only builds what changed). Her one binary (her page is in it)
# goes to ~/.local/share/capri/<commit>/capri once it passes her checks (her types, her tests, built); then
# ~/.local/share/capri/current points at it, the build ~/.local/bin/capri starts. A commit that fails is said once
# (notification, dotfiles-check) and not built again (her packages not downloading is tried again next time; failing
# so three runs in a row, it's that commit's own); she stays on the build she has. A running Capri carries on with her
# build until she's next started.
set -uo pipefail
dir="${XDG_DATA_HOME:-$HOME/.local/share}/capri"
src="$dir/src"
fork=${CAPRI_FORK:-https://github.com/CrimzoAgra/capri-overlay.git}
failed="${XDG_STATE_HOME:-$HOME/.local/state}/capri-update-failed"  # (the commit that failed, then why)
helpers=$(dirname "$(readlink -f "$0")")  # (the shared helpers, beside this)
check=false
[[ ${1:-} == --check ]] && check=true
# At boot it runs from the system's update, outside the desktop: its notifications go to your session's bus
export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus}
# The private fork with no GitHub login (gh auth login) fails rather than asking for one in the terminal: an
# unattended run (the boot update) waited on that prompt
export GIT_TERMINAL_PROMPT=0
# A stalled download given up on (as hyprbars-build's: one hung for minutes at a login), not waited on: at boot the
# update holds shutdown off until it's done, and the update check (update-apps --check) would never finish
export GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=30
# Rust's build shared by every run (incremental), outside her clone (git clean empties that); rustup's own install
# (rustup.rs's script) in ~/.cargo/bin, as update-kinds has it, for the install at login too (dotfiles-check)
export CARGO_TARGET_DIR="$dir/target" PATH=$HOME/.cargo/bin:$PATH
# (notify-when-up: once the notification server is up, in the background; normal urgency, from Capri)
warn() {
    setsid -f "$helpers/notify-when-up" -u normal -a Capri -i dialog-warning "$1" "$2" >/dev/null 2>&1 9>&-
    echo "capri: $1: $2" >&2
}
git() { command git -C "$src" -c advice.detachedHead=false "$@"; }
# One at a time in her folder: a --check (the update check, the Updates app's list) fetching while an update built
# there failed it on git's own lock. A --check finding one running says nothing (that one says how it went); an update
# waits for the other to finish. (Not installed: nothing to look for, and no lock left in a home without her. Her clone
# gone with a build of hers still here: said, so the Updates app lists it and a run clones her again)
if $check && [[ ! -d $src/.git ]]; then
    [[ -e $dir/current ]] && echo "capri: update available (her code fetched again)"
    exit 0
fi
lock="${XDG_STATE_HOME:-$HOME/.local/state}/capri-update.lock"
mkdir -p "${lock%/*}"
exec 9>"$lock"
if $check; then
    flock -n 9 || exit 0
elif ! flock -n 9; then
    echo "capri: waiting for the other capri-update to finish..."
    flock 9
fi

if [[ ! -d $src/.git ]]; then
    mkdir -p "$dir"
    LC_ALL=C command git clone -q --no-tags --origin origin "$fork" "$src" ||
        { echo "capri: can't clone $fork (it's private: gh auth login first)"; exit 1; }
fi
# (from where $CAPRI_FORK says, by default GitHub: set back after a test's run from a copy of it)
git remote set-url origin "$fork"
# The fork may be unreachable at boot (it's private: the GitHub login isn't there for the boot's check): its last copy is
# built then. Expected there, so not a warning
git fetch -q --no-tags origin main 2>/dev/null ||
    echo "capri: $fork not fetched (private: no GitHub login here, as at boot), its last copy used"
want=$(git rev-parse -q --verify 'origin/main^{commit}') || { echo "capri: no main branch in $src"; exit 1; }
build=$(git rev-parse --short "$want")
have=$(cat "$dir/current/.capri-build" 2>/dev/null)
if [[ $want == "$have" ]]; then
    $check || echo "capri: up to date ($build)"
    exit 0
fi
if [[ $(head -1 "$failed" 2>/dev/null) == "$want" ]]; then
    $check || echo "capri: this version failed before, not tried again: $(tail -n +2 "$failed")"
    exit 0
fi
if $check; then
    echo "capri: update available ($build)"
    exit 0
fi

# fail <why> [again]: keeps the build she has, says why once, and doesn't build this commit again; with "again" it's
# tried next time (what can go by itself: a download cut off, a full disk, Rust not installed yet)
fail() {
    if [[ ${2:-} != again ]]; then
        mkdir -p "${failed%/*}"
        printf '%s\n%s\n' "$want" "$1" >"$failed.new" && mv "$failed.new" "$failed"
    fi
    rm -rf "${new:-}"
    if [[ -n $have ]]; then warn "Capri not updated" "$1 She stays on the version she has."
    else warn "Capri not installed" "$1"; fi
    exit 2
}
# flaky <why>: what may go by itself (a download cut off) is tried again next time, as fail's "again"; failing the same
# way a third run in a row with the same commit, it's that commit's own (fail: not built again), not left failing for
# good
retries="${failed}-retries"  # (fail-streak's, beside this file: the commit, the runs in a row it failed so)
flaky() {
    local n
    n=$("$helpers/fail-streak" "$retries" "$want")
    if ((n >= 3)); then
        rm -f "$retries"
        fail "$1 (the same, $n runs in a row)"
    fi
    fail "$1" again
}
new="$dir/$build"
# The same commit as a build already here (the build before, my fork's main set back to it): that one, not built again
if [[ $(cat "$new/.capri-build" 2>/dev/null) != "$want" ]]; then
    # (rustup with no toolchain chosen has both, failing: so they're run, not only looked for)
    { cargo --version && rustc --version; } >/dev/null 2>&1 ||
        fail "Rust isn't installed (cargo, rustc): install the rust package, or run rustup default stable." again
    # (-f, clean: what a run cut off left, and her last build's page, never built into this one)
    { git checkout -q -f --detach "$want" && git clean -qffdx; } || fail "Git couldn't check out my fork in $src." again
    # Pinned by her lockfile, with no install scripts (npm may refuse those it wasn't told to allow; none of hers needs
    # one: Tauri's CLI and esbuild come as packages for this system). A lockfile that doesn't match package.json, or
    # names a version the registry doesn't have, fails the same every time: that commit's own. Anything else (the
    # network) is tried again (npm in English: its messages are read)
    if ! ( cd "$src" && LC_ALL=C npm ci --ignore-scripts --no-audit --no-fund --loglevel=error ) >"$dir/build.log" 2>&1; then
        grep -qE 'EUSAGE|in sync|from lock file|Invalid: lock file|ETARGET|E404' "$dir/build.log" &&
            fail "Her packages don't install: package.json and package-lock.json don't match ($dir/build.log)."
        flaky "Her packages didn't install ($dir/build.log)."
    fi
    # Her types and her tests first (seconds: a commit that fails them isn't built for minutes). Her Rust tests (cargo
    # test) aren't run: a second, debug build as big as the first
    ( cd "$src" && npm run -s typecheck && npm run -s test ) >>"$dir/build.log" 2>&1 ||
        fail "Her checks failed on $build ($dir/build.log)."
    # Her crates downloaded alone, so a network failure is tried again and the build after it, offline, is her code's
    # own. Cargo.lock out of date (--locked) fails the same every time: that commit's own (cargo in English: read)
    if ! ( cd "$src/src-tauri" && LC_ALL=C cargo fetch --locked ) >>"$dir/build.log" 2>&1; then
        grep -qE 'lock file .* needs to be updated|--locked was passed' "$dir/build.log" &&
            fail "Her Rust crates don't match her Cargo.lock ($dir/build.log)."
        flaky "Her Rust crates didn't download ($dir/build.log)."
    fi
    # (her page built first by Tauri itself: beforeBuildCommand, npm run build)
    { ( cd "$src" && CARGO_NET_OFFLINE=true npm run -s tauri build -- --no-bundle ) >>"$dir/build.log" 2>&1 &&
        [[ -x $CARGO_TARGET_DIR/release/capri ]]; } || fail "Her build failed on $build ($dir/build.log)."
    rm -rf "$new"
    # (not copied or marked, a full disk: not switched to; tried again next time)
    { mkdir -p "$new" && cp "$CARGO_TARGET_DIR/release/capri" "$new/capri" && echo "$want" >"$new/.capri-build"; } ||
        fail "Her build couldn't be finished (is the disk full?)." again
fi
old=$(readlink "$dir/current" 2>/dev/null)
# (not switched, a full disk: said, not "installed" with her still on the old one; tried again next time)
if ! { ln -sfn "$build" "$dir/current.new" && mv -T "$dir/current.new" "$dir/current"; }; then
    new=
    fail "She couldn't be switched to her new build (is the disk full?)." again
fi
rm -f "$failed" "$retries"
# The build before stays (when it's hers: the Electron Capri's builds aren't one to go back to), and any a Capri is
# still running from (two updates without her restarted); older ones go, and any a run cut off left. Only folders named
# by a commit: her clone, Rust's build and anything else of yours there stay
running=$(for p in /proc/[0-9]*/exe; do readlink "$p"; done 2>/dev/null)
for b in "$dir"/*/; do
    b=${b%/}
    [[ ${b##*/} =~ ^[0-9a-f]{7,40}$ && ${b##*/} != "$build" ]] || continue
    [[ ${b##*/} == "$old" && -x $b/capri ]] && continue
    grep -qF "$(readlink -f "$b")/" <<<"$running" || rm -rf "$b"
done

# Her launcher entry (Super menu) and icon, made here so they're only there once she's installed
apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
icon="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps/capri.png"
mkdir -p "$apps" "${icon%/*}"
git show "$want:src-tauri/icons/icon.png" >"$icon"
# (no StartupWMClass: her windows' own entry, capri-desktop-windows.desktop, hidden, is written by her, with their app
# id, dev.cybercompanion.capri)
cat >"$apps/capri.desktop" <<EOF
[Desktop Entry]
Name=Capri
GenericName=Desktop companion
Comment=Project Capricorn's construct, on your desktop: chat, game commentary, voice macros, a coding agent
Exec="$HOME/.local/bin/capri"
Icon=capri
Type=Application
StartupNotify=false
Categories=Utility;
Keywords=capri;claude;edgerunners;cyberpunk;companion;
EOF
# Her key is bound only once she's installed (user/apps.lua: her build's binary there): the desktop's config loaded
# again on her first install, and over an Electron Capri's build (which it no longer counts), so it works now, not from
# the next login (capri-update from the desktop), by hypr-reload beside this file (after any game). (without the lock:
# waiting through a game it held off every capri-update)
[[ -n $old && -x $dir/$old/capri ]] || setsid -f "$helpers/hypr-reload" >/dev/null 2>&1 9>&-
echo "capri: $build installed"

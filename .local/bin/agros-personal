#!/usr/bin/env bash
# Your accounts (logins, keys, LibreWolf profile, GitHub login...) back from your pen drive: the one thing to run after
# installing AgrOS. Decrypted straight into place with your passphrase; never in a repo.
#   agros-personal [folder]          restore, from the pen drive plugged in (or that folder); without the file on one,
#                                    each app is opened for you to sign in
#   agros-personal --save [folder]   put this PC's accounts on the pen drive (encrypted, apps closed)
set -euo pipefail
personal_dir=
mode=restore
helpers=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")  # (the shared helpers beside this, not links not added yet)
case ${1:-} in
    -h | --help) sed -n '2,7s/^# \{0,1\}//p' "$0"; exit 0 ;;
    --save) mode=save; shift ;;
esac
[[ ${1:-} ]] && personal_dir=$1
[[ $EUID -ne 0 || ${BASH_SOURCE[0]} != "$0" ]] || { echo "Run this as your normal user, not with sudo."; exit 1; }
# The default LibreWolf profile's folder (nothing if LibreWolf hasn't made one yet)
firefox_profile() { "$helpers/firefox-bookmarks-export" --profile 2>/dev/null || true; }


# Your logins live on your pen drive only, never in the repo (git keeps every version, and saved logins get past your
# password and 2FA): agros-personal --save puts them there, encrypted with your passphrase (gpg, AES-256: a lost
# drive gives nothing), agros-personal brings them back, decrypted straight into place (no unencrypted copy
# anywhere). No drive with them: each app is opened for you to sign in instead.
PERSONAL_FILE=dotfiles-personal.tar.gpg
# What's in it, from your home: Discord (Equibop), Spotify and Nuvio (flatpaks), Proton VPN, and the login keyring
# (where Equibop keeps the key to its login and Proton VPN its account: it opens with the password you log in with)
PERSONAL_PATHS=(.config/equibop .var/app/com.spotify.Client/config/spotify .var/app/com.nuvio.media.desktop/config/nuvio
    .config/Proton/VPN .local/share/keyrings
    # Steam: its login (accounts, the saved sign-in, the one to sign in as) and settings (Proton per game, libraries)
    .steam/registry.vdf .local/share/Steam/local.vdf .local/share/Steam/config/loginusers.vdf
    .local/share/Steam/config/config.vdf
    # SteamGridDB's key (lutris-covers: covers for games the stores have none for)
    .config/dots/steamgriddb.key
    # GitHub's login (gh): Capri's fork is private, so capri-update needs it (installs her after a restore)
    .config/gh/hosts.yml
    # VSCodium's extensions' own data (their logins and settings; the extensions themselves: agros-welcome's list)
    .config/VSCodium/User/globalStorage)
# ...less what's only cache (downloaded again)
PERSONAL_SKIP=(Cache "Code Cache" GPUCache DawnGraphiteCache DawnWebGPUCache Crashpad "Singleton*" equicord.asar
    Dictionaries updates)
# ...LibreWolf's profile, those files of it: your Firefox account (Sync), bookmarks and history, passwords, cookies,
# extensions and their data (into the profile LibreWolf makes on the new PC: its folder's name differs)
PERSONAL_LIBREWOLF=(signedInUser.json places.sqlite favicons.sqlite logins.json key4.db cert9.db cookies.sqlite
    permissions.sqlite formhistory.sqlite prefs.js extensions extensions.json extension-preferences.json
    extension-settings.json storage-sync-v2.sqlite containers.json handlers.json search.json.mozlz4 sessionstore.jsonlz4
    xulstore.json
    # (the new tab's background picture: yours, so not in the repo)
    wallpaper)
# ...Lutris's store logins (Battle.net, Steam, GOG, Epic, EA, Ubisoft, Rockstar): .cache/lutris/.<store>.auth/.token,
# and its lutris.net login (auth-token); the weather widget's place (Caelestia's services.weatherLocation): both
# gathered by personal_save itself
# ...each Steam account's own settings (controllers, launch options): folders, by pattern
PERSONAL_DIRS=(".local/share/Steam/userdata/*/config")
# ...Claude Code, all of it (its account, settings, sessions, memories, skills, plugins: ~/.claude and ~/.claude.json)
# but these, remade as it runs: copied first, as Claude Code (likely running) keeps writing them
PERSONAL_CLAUDE_SKIP=(cache shell-snapshots session-env sessions ide)
# ...the store launchers installed in Lutris (each one's Wine folder, whole: their logins are in there, and installing
# one again gives a signed-out one), put back as installed. Their Wine itself is downloaded by Lutris
PERSONAL_LAUNCHERS=(epic-games-store ea-app ubisoft-connect battlenet gog-galaxy rockstar-games-launcher)

# Without the drive: these opened one after the other for you to sign in
PERSONAL_APPS=(
    "LibreWolf: your Firefox account (Sync brings back bookmarks, passwords, history, extensions)|librewolf about:preferences#sync"
    "Discord (Equibop)|equibop"
    "Spotify|flatpak run com.spotify.Client"
    "Nuvio|flatpak run com.nuvio.media.desktop"
    "Proton VPN|protonvpn-app"
    "Lutris: your stores, in its sidebar (Steam, GOG, Epic, Battle.net, EA, Ubisoft, Rockstar)|lutris"
)

# gpg with your passphrase; PERSONAL_PASSFILE (tests): read from that file instead of asked
personal_gpg() {
    if [[ -n ${PERSONAL_PASSFILE:-} ]]; then
        gpg --batch --yes --quiet --pinentry-mode loopback --passphrase-file "$PERSONAL_PASSFILE" "$@"
    else
        gpg --quiet "$@"
    fi
}

# The folder to use on your pen drive: the one named (agros-personal [--save] <folder>), else the removable drive
# plugged in (mounted here if it isn't; with several, the one with the file on it). Nothing found: nothing printed
personal_drive() {
    [[ -n ${personal_dir:-} ]] && { echo "$personal_dir"; return; }
    local dev rm type mnt found=()
    while read -r dev rm type mnt; do
        [[ $rm == 1 && $type == part ]] || continue
        mnt=$(printf '%b' "$mnt") # (lsblk -r writes a space in it as \x20)
        # (udisksctl's answer, read for its folder, in English: not the region's language)
        [[ -n $mnt ]] || mnt=$(LC_ALL=C udisksctl mount -b "$dev" 2>/dev/null | sed -n 's/^Mounted .* at \(.*\)$/\1/p')
        [[ -n $mnt && -d $mnt ]] && found+=("$mnt")
    done < <(lsblk -nrpo NAME,RM,TYPE,MOUNTPOINT 2>/dev/null)
    local d
    for d in "${found[@]}"; do [[ -f $d/$PERSONAL_FILE ]] && { echo "$d"; return; }; done
    ((${#found[@]} == 1)) && echo "${found[0]}"
    return 0
}

# An app's processes, yours: Lutris by its command (Python runs it), VSCodium by its folder (Arch's runs as Electron on
# /usr/lib/vscodium, the AUR's binary is codium), the rest by name
personal_pids() {
    case $1 in
        lutris) pgrep -u "$UID" -f '(^|/)lutris( |$)' ;;
        codium) pgrep -u "$UID" -f '(^|/)codium( |$)|/vscodium(-bin)?/' ;;
        *) pgrep -u "$UID" -x "$1" ;;
    esac
}

# The apps it's for that are open, yours (their files change under them, or theirs would overwrite these; another
# account's use its own files)
personal_open() {
    local p
    for p in librewolf equibop spotify protonvpn-app steam lutris codium; do personal_pids "$p" >/dev/null && echo "$p"; done
    # (its list read whole: grep -q quitting early got flatpak a SIGPIPE, which pipefail took for not open)
    grep -qx com.nuvio.media.desktop <<<"$(flatpak ps --columns=application 2>/dev/null)" && echo nuvio
    return 0
}

# Lutris and Proton VPN start at login in their tray only (user/apps.lua: Lutris on by default, Proton VPN when turned
# on), so a restore from the first login's notification found them open. Of the apps named, those two with no window (nor a game they started)
# are closed for it, asked first in a terminal: nothing of theirs is lost, and they start again at the next login if
# their Startup switch is on (Proton VPN's is off at first: one started by hand doesn't), which the restore needs anyway. Hyprland not reachable to tell (a text console): left open, said as the others
personal_close_tray() {
    local app p wins mine pids=() names=() list r
    local -A shown=()
    wins=$(hyprctl -i "${HYPRLAND_INSTANCE_SIGNATURE:-0}" clients -j 2>/dev/null) || return 0
    wins=$(jq -r '.[].pid' <<<"$wins" 2>/dev/null) || return 0
    # each process a window belongs to, and the ones that started it (a game's window is Lutris's too)
    for p in $wins; do
        while [[ $p =~ ^[0-9]+$ ]] && ((p > 1)) && [[ -z ${shown[$p]-} ]]; do
            shown[$p]=1
            p=$(awk '$1 == "PPid:" {print $2}' "/proc/$p/status" 2>/dev/null) || p=  # (gone since: no parent)
        done
    done
    for app in "$@"; do
        [[ $app == lutris || $app == protonvpn-app ]] || continue
        mine=$(personal_pids "$app") || continue
        for p in $mine; do [[ -n ${shown[$p]-} ]] && continue 2; done
        # shellcheck disable=SC2206  # (process ids)
        pids+=($mine)
        if [[ $app == lutris ]]; then names+=(Lutris); else names+=("Proton VPN"); fi
    done
    ((${#pids[@]})) || return 0
    list=$(printf '%s and ' "${names[@]}") list=${list% and }
    if [[ -t 0 ]]; then
        read -rp "$list: open in the tray only. Close for this (they start again at your next login if they're on in Desktop Settings → Startup)? [Y/n] " r || r=n
        [[ $r == [nN]* ]] && return 0
    fi
    kill -TERM "${pids[@]}" 2>/dev/null || true
    for _ in {1..20}; do
        kill -0 "${pids[@]}" 2>/dev/null || break
        sleep 0.5
    done
    echo "$list closed (they were in the tray only)."
}

# Claude Code running (restoring only: saving copies its files first)
personal_claude_open() { pgrep -u "$UID" -x claude >/dev/null && echo "Claude Code"; return 0; }

# agros-personal --save: your logins on this PC onto your pen drive
personal_save() {
    local drive open prof paths=() lw=() games=() p f staged skip=() s
    drive=$(personal_drive)
    [[ -n $drive ]] || { echo "No pen drive found: plug it in, or name its folder (agros-personal --save <folder>)."; return 1; }
    # (a folder anywhere in one, not only its top: a subfolder of the dotfiles repo is in it too)
    [[ ! -e $drive/.git ]] && ! git -C "$drive" rev-parse --git-dir >/dev/null 2>&1 ||
        { echo "Not in a git repo: your logins go on your pen drive."; return 1; }
    open=$(personal_open)
    [[ -z $open ]] || { echo "Close these first (their files are being written): $(echo $open)."; return 1; }
    for p in "${PERSONAL_PATHS[@]}"; do [[ -e $HOME/$p ]] && paths+=("$p"); done
    for f in "$HOME"/.cache/lutris/.*.auth "$HOME"/.cache/lutris/.*.token "$HOME"/.cache/lutris/auth-token; do [[ -f $f ]] && paths+=("${f#"$HOME"/}"); done
    for p in "${PERSONAL_DIRS[@]}"; do
        for f in "$HOME"/$p; do [[ -d $f && -n $(ls -A "$f") ]] && paths+=("${f#"$HOME"/}"); done
    done
    prof=$(firefox_profile)
    if [[ -n $prof ]]; then
        for f in "${PERSONAL_LIBREWOLF[@]}"; do [[ -e $prof/$f ]] && lw+=("$f"); done
        for f in "$prof"/storage/default/moz-extension*; do [[ -e $f ]] && lw+=("${f#"$prof"/}"); done
    fi
    # the weather's place (a file of its own) and Claude Code's files, staged in your runtime folder (in memory, yours
    # only) and gone after
    staged=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/personal.XXXXXX")
    # (gone however this ends: a step failing (set -e) left it there, a big ~/.claude's copy in memory and the runtime
    # folder, which the desktop needs room in, full)
    # shellcheck disable=SC2064  # (its path now: $staged is this function's own, gone by the time the script ends)
    trap "rm -rf $(printf %q "$staged")" EXIT
    local onstage=(weather-location)
    jq -r '.services.weatherLocation // empty' "$HOME/.config/caelestia/shell.json" 2>/dev/null >"$staged/weather-location" || true
    if [[ -d $HOME/.claude ]]; then
        mkdir -p "$staged/.claude"; onstage+=(.claude)
        for f in "$HOME"/.claude/* "$HOME"/.claude/.[!.]*; do
            [[ -e $f ]] || continue
            for s in "${PERSONAL_CLAUDE_SKIP[@]}"; do [[ ${f##*/} == "$s" ]] && continue 2; done
            cp -a "$f" "$staged/.claude/" ||
                { echo "Claude Code's files couldn't be copied into ${staged%/*} (too big for it?): nothing saved."; return 1; }
        done
    fi
    [[ -f $HOME/.claude.json ]] && { cp -p "$HOME/.claude.json" "$staged/"; onstage+=(.claude.json); }
    # the launchers: their folders and Lutris configs (to save), their Lutris entries (lutris-launchers.json, to put back)
    if [[ -f $HOME/.local/share/lutris/pga.db ]]; then
        mapfile -t games < <(python3 -I - "$HOME" "$staged/lutris-launchers.json" "${PERSONAL_LAUNCHERS[@]}" <<'EOF'
import json, os, sqlite3, sys
home, out, slugs = sys.argv[1], sys.argv[2], sys.argv[3:]
db = sqlite3.connect(f"file:{home}/.local/share/lutris/pga.db?mode=ro", uri=True)
db.row_factory = sqlite3.Row
keep = []
for r in db.execute("SELECT slug, name, installer_slug, platform, runner, directory, configpath FROM games WHERE "
                    f"installed = 1 AND runner = 'wine' AND slug IN ({','.join('?' * len(slugs))})", slugs):
    r = dict(r)
    d, y = r["directory"] or "", f"{home}/.local/share/lutris/games/{r['configpath']}.yml"
    if d.startswith(home + "/") and os.path.isdir(d) and os.path.isfile(y):  # (elsewhere: not yours to carry)
        r["directory"] = os.path.relpath(d, home)
        keep.append(r)
        print(r["directory"])
        print(os.path.relpath(y, home))
json.dump({"home": home, "games": keep}, open(out, "w"))
EOF
        )
        onstage+=(lutris-launchers.json)
    fi
    for s in "${PERSONAL_SKIP[@]}"; do skip+=(--exclude="$s"); done
    echo "Saving to $drive/$PERSONAL_FILE. Pick a long passphrase: it's all that keeps a lost drive's finder out."
    # tars one after the other (your home, the profile as librewolf/, the launchers whole, the staged), straight into gpg
    # Each one has to work, or the save stops and the last one on the drive stays: only the group's last tar counted, so
    # an unreadable file still said "Saved" over it. (tar's 1, a file that changed while read, still saved, isn't one)
    tar_ok() { tar "$@"; (($? <= 1)); }
    if {
        { ((${#paths[@]} == 0)) || tar_ok -C "$HOME" "${skip[@]}" -cf - "${paths[@]}"; } &&
            { ((${#lw[@]} == 0)) || tar_ok -C "$prof" "${skip[@]}" --transform 's,^,librewolf/,' -cf - "${lw[@]}"; } &&
            { ((${#games[@]} == 0)) || tar_ok -C "$HOME" -cf - "${games[@]}"; } &&
            tar_ok -C "$staged" -cf - "${onstage[@]}"
    } | personal_gpg --symmetric --cipher-algo AES256 --s2k-mode 3 --s2k-digest-algo SHA512 --s2k-count 65011712 \
        -o "$drive/$PERSONAL_FILE.new"; then
        mv "$drive/$PERSONAL_FILE.new" "$drive/$PERSONAL_FILE"
        sync
    else
        rm -rf "$drive/$PERSONAL_FILE.new" "$staged"
        return 1
    fi
    rm -rf "$staged"
    trap - EXIT
    echo "Saved ($(du -h "$drive/$PERSONAL_FILE" | cut -f1)). agros-personal brings it back with the drive plugged in."
}

personal_main() {
    local drive
    drive=$(personal_drive)
    if [[ -n $drive && -f $drive/$PERSONAL_FILE ]]; then
        personal_restore "$drive/$PERSONAL_FILE"
    else
        echo "No $PERSONAL_FILE on a pen drive: you sign in to each app instead."
        personal_sign_in
    fi
}

# Your logins back from the file on the drive, decrypted straight into place (three times: the file's list, its
# files, the weather's place and the launchers' Lutris entries; gpg's agent asks the passphrase once)
personal_restore() {
    local file=$1 open prof loc name dest backup meta list to=() shell="$HOME/.config/caelestia/shell.json"
    open=$(personal_open; personal_claude_open)
    # shellcheck disable=SC2086  # (the apps' names, one word each)
    [[ -z $open ]] || { personal_close_tray $open; open=$(personal_open; personal_claude_open); }
    [[ -z $open ]] || { echo "Close these first (they'd write over what's brought back): $(echo $open)."; return 1; }
    # The file's list first, and nothing done unless it's read: a mistyped passphrase here had nothing backed up, and the
    # next ask, typed right, brought everything back over your files
    list=$(personal_gpg -d "$file" | tar -itf -) ||
        { echo "$file couldn't be read (a wrong passphrase?): nothing brought back."; return 1; }
    prof=$(firefox_profile)
    [[ $prof == "$HOME"/* ]] || prof=  # (kept outside your home: brought back by hand)
    # LibreWolf's files into its profile here; none yet (LibreWolf never started): left out, said below
    if [[ -n $prof ]]; then to=(--transform "s,^librewolf/,${prof#"$HOME"/}/,")
    else to=(--exclude='librewolf'); fi
    # what it replaces, backed up first
    backup="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)-personal"
    while IFS= read -r name; do
        [[ $name == */ || $name == weather-location || $name == lutris-launchers.json ]] && continue
        [[ $name == librewolf/* && -z $prof ]] && continue
        dest=${name/#librewolf\//${prof#"$HOME"/}/}
        # a database's journal left beside it (LibreWolf's new profile) gets replayed over the one brought back,
        # wrecking it (LibreWolf then sets it aside as .corrupt: no bookmarks): moved to the backup
        if [[ -f $HOME/$dest-wal || -f $HOME/$dest-shm ]]; then
            mkdir -p "$backup/$(dirname "$dest")"
            mv -f "$HOME/$dest"-wal "$HOME/$dest"-shm "$backup/$(dirname "$dest")/" 2>/dev/null || true
        fi
        [[ -f $HOME/$dest ]] || continue
        mkdir -p "$backup/$(dirname "$dest")"
        cp -a "$HOME/$dest" "$backup/$dest"
    done <<<"$list"
    personal_gpg -d "$file" | tar -C "$HOME" -ixf - "${to[@]}" --exclude=weather-location --exclude=lutris-launchers.json
    # the weather's place and the launchers' Lutris entries (either may not be in it: an older save)
    meta=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/personal.XXXXXX")
    personal_gpg -d "$file" | tar -C "$meta" -ixf - weather-location lutris-launchers.json 2>/dev/null || true
    loc=$(cat "$meta/weather-location" 2>/dev/null) || loc=
    [[ -s $meta/lutris-launchers.json ]] && personal_launchers "$meta/lutris-launchers.json"
    rm -rf "$meta"
    if [[ -n $loc && -f $shell ]]; then
        "$helpers/json-edit" "$shell" --indent 4 --arg l "$loc" '.services.weatherLocation = $l' ||
            echo "!! $shell isn't valid JSON: the weather place not restored"
    fi
    [[ -d $backup ]] && echo "Replaced files backed up to $backup."
    [[ -n $prof ]] || echo "LibreWolf has no profile yet: start it once and close it, then agros-personal."
    # Capri: her fork is private, so an install without your GitHub login couldn't fetch her. With it back now, she's
    # installed (a failure said, the restore still done). gh keeps its login in the keyring, and the one brought back
    # opens only from the next login: then dotfiles-check installs her (its mark), as it runs at every login
    if [[ ! -e ${XDG_DATA_HOME:-$HOME/.local/share}/capri/current && -x $helpers/capri-update ]] && command -v gh >/dev/null; then
        if gh auth status >/dev/null 2>&1; then
            echo "Installing Capri (your GitHub login is back)..."
            gh auth setup-git >/dev/null 2>&1 || true
            "$helpers/capri-update" || echo "!! Capri didn't install: run capri-update"
        elif grep -qx .config/gh/hosts.yml <<<"$list"; then
            mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/agros" && : >"${XDG_STATE_HOME:-$HOME/.local/state}/agros/capri-at-login"
            echo "Capri is installed at your next login (your GitHub login works from then: it's in the keyring)."
        fi
    fi
    # Proton VPN's account is back, but not its start at login: a desktop setting, off at first (a VPN at every login is
    # yours to choose)
    if grep -qE '^\.config/Proton/VPN(/|$)' <<<"$list" &&
        [[ $("$helpers/dots-settings" get startup.protonvpn 2>/dev/null) != true ]]; then
        echo "Proton VPN starts at login only if you turn it on: Desktop Settings → Startup."
    fi
    echo "Accounts back. Log out and in (the keyring): it opens with the password you logged in with on your old PC."
}

# The launchers brought back, installed again in Lutris: their entries (made by lutris-library, else new) marked
# installed, in their folder here; their configs' paths moved to this home if it's named differently
personal_launchers() {
    python3 -I - "$HOME" "$1" <<'EOF' || echo "!! Lutris's launchers not put back: open Lutris once, then agros-personal again"
import json, os, sqlite3, sys, time
home, f = sys.argv[1:]
data = json.load(open(f))
if not data["games"]:
    sys.exit(0)
db_path = f"{home}/.local/share/lutris/pga.db"
if not os.path.isfile(db_path):
    sys.exit(1)
db = sqlite3.connect(db_path)
with db:
    for g in data["games"]:
        y = f"{home}/.local/share/lutris/games/{g['configpath']}.yml"
        if data["home"] != home and os.path.isfile(y):
            text = open(y).read().replace(data["home"] + "/", home + "/")
            open(y, "w").write(text)
        values = (g["installer_slug"], g["platform"], g["runner"], os.path.join(home, g["directory"]), g["configpath"],
                  int(time.time()))
        if not db.execute("UPDATE games SET installer_slug = ?, platform = ?, runner = ?, directory = ?, configpath = ?, "
                          "installed_at = ?, installed = 1 WHERE slug = ?", (*values, g["slug"])).rowcount:
            db.execute("INSERT INTO games (installer_slug, platform, runner, directory, configpath, installed_at, "
                       "installed, name, slug) VALUES (?, ?, ?, ?, ?, ?, 1, ?, ?)", (*values, g["name"], g["slug"]))
print("Lutris: " + ", ".join(g["name"] for g in data["games"]) + " back, signed in")
EOF
}

personal_sign_in() {
    [[ -t 0 ]] || { echo "Signing in needs a terminal."; return 1; }
    personal_weather
    local app name cmd r
    for app in "${PERSONAL_APPS[@]}"; do
        name=${app%%|*} cmd=${app#*|}
        if [[ $cmd == "flatpak run "* ]]; then
            flatpak info "${cmd#flatpak run }" >/dev/null 2>&1 || { echo "$name: not installed, skipped."; continue; }
        else
            command -v "${cmd%% *}" >/dev/null || { echo "$name: not installed, skipped."; continue; }
        fi
        read -rp "$name: Enter opens it, s skips " r || return 0
        [[ $r == [sS]* ]] && continue
        # shellcheck disable=SC2086  # the command and its arguments, split
        setsid -f "$helpers/app-launch" $cmd >/dev/null 2>&1
        read -rp "  Signed in? Enter for the next one " r || return 0
    done
}

# The weather widget's place, asked (Enter keeps it): kept on this PC only (dotfiles-sync leaves it out of the repo)
personal_weather() {
    local shell="$HOME/.config/caelestia/shell.json" loc r
    [[ -f $shell ]] || return 0
    loc=$(jq -r '.services.weatherLocation // empty' "$shell" 2>/dev/null) || loc=
    read -rp "Weather widget's place, a city or lat,lon (Enter keeps ${loc:-"finding it from your connection"}) " r || return 0
    [[ -n $r ]] || return 0
    # (shell.json not readable as JSON, edited by hand: said, the step goes on to the apps)
    "$helpers/json-edit" "$shell" --indent 4 --arg l "$r" '.services.weatherLocation = $l' ||
        echo "!! $shell isn't valid JSON: the weather place not set"
}

# (sourced, by the tests: only the functions)
[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0
if [[ $mode == save ]]; then personal_save; else personal_main; fi

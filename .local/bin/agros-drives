#!/usr/bin/env python3
"""At login: mounts the internal drives nothing mounts yet, and adds the Steam libraries on them to Steam.

A games drive is ready without the file manager opening it first, and its library is in Steam without Settings >
Storage > Add Drive. Internal partitions with a Linux filesystem only, not the system's own, and none /etc/fstab lists
(its own mount, or noauto: left to it); a drive's other partitions (one btrfs over two) count as that one drive.
A library Steam already lists under another folder (the drive's label changed, or it was mounted elsewhere) gets the
new one: the same library by its contentid, not a second, missing one. Steam's list is only ever added to.
"""
import json
import os
import re
import subprocess
import sys

# (NTFS/exFAT: Proton's games don't run from them; FAT: the EFI partition)
FS = {"btrfs", "ext4", "ext3", "xfs", "f2fs"}
# shortcut: the system's Steam only; Flathub's sandbox doesn't see /run/media without an override (Flatseal)
STEAM = os.path.expanduser("~/.local/share/Steam")
C = {**os.environ, "LC_ALL": "C"}  # (udisksctl's answer read for its folder: in English, not the region's language)


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True, env=C)


def drives():
    """The folders the internal data drives are mounted at, mounting the ones that aren't."""

    parts = json.loads(run("lsblk", "-Jlpo", "NAME,TYPE,RM,HOTPLUG,FSTYPE,UUID,MOUNTPOINTS").stdout)["blockdevices"]
    mounts = {}
    for p in parts:
        mounts.setdefault(p["uuid"], []).extend(m for m in p["mountpoints"] if m)
    system = {u for u, ms in mounts.items() if "/" in ms}
    seen, found = set(), []
    for p in parts:
        u = p["uuid"]
        if (p["type"] != "part" or p["rm"] or p["hotplug"] or p["fstype"] not in FS or not u or u in system
                or u in seen):
            continue
        seen.add(u)
        if mounts[u]:
            found += mounts[u]
        elif run("findmnt", "--fstab", "-S", f"UUID={u}").returncode != 0:
            r = run("udisksctl", "mount", "--no-user-interaction", "-b", p["name"])
            m = re.search(r"^Mounted .* at (.*?)\.?$", r.stdout, re.M)  # (older udisks ended it with a full stop)
            if m:
                found.append(m.group(1))
            else:
                print(f"agros-drives: {p['name']} not mounted: {r.stderr.strip()}", file=sys.stderr)
    return found


def libraries(top):
    """Steam libraries on a drive: a folder with steamapps in it, up to 3 folders down (/@games/SteamLibrary)."""
    for d, dirs, files in os.walk(top):
        if "steamapps" in dirs:
            apps = os.path.join(d, "steamapps")
            vdf = os.path.join(d, "libraryfolder.vdf")
            if os.path.isfile(vdf) or any(f.startswith("appmanifest_") for f in os.listdir(apps)):
                cid = re.search(r'"contentid"\s+"(\d+)"', read(vdf) or "")
                yield d, cid and cid.group(1)
            dirs.clear()  # (not into a library: a game's own files)
        elif d.count(os.sep) - top.rstrip(os.sep).count(os.sep) >= 3:
            dirs.clear()


def read(path):
    try:
        return open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None


def esc(s):
    return s.replace("\\", "\\\\").replace('"', '\\"')


def add(libs):
    vdf = f"{STEAM}/steamapps/libraryfolders.vdf"
    text = read(vdf)
    # No list yet (Steam never started): its first start makes one, the next login adds these
    if text is None or not libs:
        return
    # Open, Steam writes its own list over this one when it closes: the next login adds them
    if run("pgrep", "-x", "-U", str(os.getuid()), "steam").returncode == 0:
        print("agros-drives: Steam is open, its libraries are added at the next login", file=sys.stderr)
        return
    # shortcut: Steam's own layout read (a tab per level, as it always writes it), not any VDF; a parser if it changes
    entries = list(re.finditer(r'^\t"(\d+)"\n\t\{\n(.*?)^\t\}\n', text, re.M | re.S))
    if not entries:
        return
    listed = {}
    for e in entries:
        path = re.search(r'^\t\t"path"\t\t"((?:[^"\\]|\\.)*)"', e.group(2), re.M)
        cid = re.search(r'^\t\t"contentid"\t\t"(\d+)"', e.group(2), re.M)
        if path:
            listed[os.path.realpath(re.sub(r"\\(.)", r"\1", path.group(1)))] = cid and cid.group(1)
    by_cid = {c: p for p, c in listed.items() if c}
    new = text
    for lib, cid in libs:
        if os.path.realpath(lib) in listed:
            continue
        if cid in by_cid:  # the same library moved: its entry's folder changed, its games kept
            old = by_cid[cid]
            new = _repath(new, cid, lib)
            listed[os.path.realpath(lib)] = cid
            del by_cid[cid]
            print(f"agros-drives: Steam library {old} now at {lib}")
            continue
        n = max(int(m.group(1)) for m in re.finditer(r'^\t"(\d+)"\n\t\{', new, re.M)) + 1
        entry = (f'\t"{n}"\n\t{{\n\t\t"path"\t\t"{esc(lib)}"\n\t\t"label"\t\t""\n\t\t"contentid"\t\t"{cid or 0}"\n'
                 f'\t\t"totalsize"\t\t"0"\n\t\t"update_clean_bytes_tally"\t\t"0"\n'
                 f'\t\t"time_last_update_verified"\t\t"0"\n\t\t"apps"\n\t\t{{\n\t\t}}\n\t}}\n')
        new = new[:new.rindex("}")] + entry + new[new.rindex("}"):]
        listed[os.path.realpath(lib)] = cid
        print(f"agros-drives: Steam library {lib} added")
    if new != text:
        tmp = f"{vdf}.agros-tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(new)
        os.replace(tmp, vdf)  # (whole or not at all: a half-written list loses every library)


def _repath(text, cid, lib):
    """The path of the entry with this contentid set to lib."""
    def one(e):
        if not re.search(rf'^\t\t"contentid"\t\t"{cid}"$', e.group(0), re.M):
            return e.group(0)
        return re.sub(r'^(\t\t"path"\t\t")(?:[^"\\]|\\.)*"', lambda m: m.group(1) + esc(lib) + '"', e.group(0),
                      count=1, flags=re.M)
    return re.sub(r'^\t"\d+"\n\t\{\n.*?^\t\}\n', one, text, flags=re.M | re.S)


if __name__ == "__main__":
    add([lib for top in drives() for lib in libraries(top)])

#!/bin/sh
# wait-online <url>: waits until <url> answers, at most ~2 min (a boot or a login comes before the network: what ran
# then failed at once). The scripts' one wait for the network (auto-update, hyprbars-build, timezone-auto). Exit 1:
# still offline. Any HTTP answer is online, an error too (no -f: open-meteo's 503 kept timezone-auto waiting at every
# login); only no connection is offline
for _ in $(seq 30); do curl -sI --max-time 2 "$1" >/dev/null 2>&1 && exit 0; sleep 2; done
exit 1

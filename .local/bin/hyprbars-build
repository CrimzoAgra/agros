#!/usr/bin/env bash
# Builds hyprbars (the title bars on floating windows: ~/.config/caelestia/user/titlebars.lua) with my hover
# highlight and the rest of my patch (~/.local/share/hyprbars/hyprbars.patch: the button under the mouse lightens,
# a restore icon on maximised windows, maximised windows un-maximise when dragged by the title bar) for the running
# Hyprland, into ~/.local/lib/hyprbars/, and swaps it in.
#   hyprbars-build          build it now
#   hyprbars-build --login  what titlebars.lua runs as Hyprland starts: load my build if it was made for this
#                           Hyprland and this patch; after a Hyprland update or a patch change, load the AUR one (no
#                           highlight) at once and rebuild mine in the background, swapping it in when done (a
#                           notification if that fails)
#   hyprbars-build --prebuild  build it for the Hyprland just installed, without loading it, so the next login has it
#                           at once (the pacman hook system/pacman-hooks/hyprbars-prebuild.hook runs it on a Hyprland
#                           update; Hyprland needn't be running)
set -euo pipefail
# (not on the live USB: no compiler, and nothing to keep it for)
[[ -d /run/archiso ]] && exit 0
patch="$HOME/.local/share/hyprbars/hyprbars.patch"
out="$HOME/.local/lib/hyprbars/libhyprbars.so"
stamp="${out%/*}/built-for"  # the Hyprland build (its ABI) and the patch it was built from
aur=/usr/lib/libhyprbars.so
# Hyprland named (its first one when run from an SSH login or a text console: there hyprctl didn't know it, and this
# stopped on jq's parse error)
hyprctl() { command hyprctl -i "${HYPRLAND_INSTANCE_SIGNATURE:-0}" "$@"; }
# Rebuilt when either changes: a Hyprland update (or a rebuild against new aquamarine/hyprutils/...: its ABI hash), or
# a new version of the patch
if [[ ${1:-} == --prebuild ]]; then
    # the Hyprland installed, from its headers: its ABI hash made the way Hyprland makes it (PluginAPI.hpp: the commit,
    # then each library's major.minor), the same as `hyprctl version`'s abiHash once it runs
    h=${HYPRBARS_VERSION_H:-/usr/include/hyprland/src/version.h}  # (the test: Hyprland main's)
    def() { grep -oP "#define $1\s+\"v?\K[^\"]+" "$h"; }
    mm() { def "$1" | cut -d. -f1,2; }
    hypr=$(def GIT_COMMIT_HASH)
    ver=$(def GIT_TAG)
    abi="${hypr}_aq_$(mm AQUAMARINE_VERSION)_hu_$(mm HYPRUTILS_VERSION)_hg_$(mm HYPRGRAPHICS_VERSION)_hc_$(mm HYPRCURSOR_VERSION)"
    # (hyprlang's only up to 0.57: Hyprland's main dropped it from the hash and from version.h, where its absence
    # stopped this script, set -e, and the pacman hook with it)
    grep -q "#define HYPRLANG_VERSION" "$h" && abi+="_hlg_$(mm HYPRLANG_VERSION)"
    build_id="$abi $(sha256sum "$patch" | cut -d" " -f1)"
    [[ -f $out && $(cat "$stamp" 2>/dev/null) == "$build_id" ]] && { echo "Already built for Hyprland $ver."; exit 0; }
    prebuild=true
else
    hypr=$(hyprctl version -j | jq -r .commit)
    ver=$(hyprctl version -j | jq -r .version)
    build_id="$(hyprctl version -j | jq -r '.abiHash // .commit') $(sha256sum "$patch" | cut -d" " -f1)"
    prebuild=false
fi
# Whether hyprbars is running (hyprctl's load prints no error when one won't start): "mine" only this build (its version
# says dotfiles), else either
loaded() {
    hyprctl plugin list -j 2>/dev/null |
        jq -e --arg mine "${1:-}" 'any(.[]?; .name == "hyprbars" and ($mine == "" or (.version | contains("dotfiles"))))' >/dev/null
}

if [[ ${1:-} == --login ]]; then
    if [[ -f $out && $(cat "$stamp" 2>/dev/null) == "$build_id" ]]; then
        hyprctl plugin load "$out" >/dev/null 2>&1 || true
        loaded mine && exit 0
    fi
    [[ -f $aur ]] && { hyprctl plugin load "$aur" >/dev/null 2>&1 || true; }
    log="$HOME/.cache/hyprbars-build.log"
    if ! "$0" >"$log" 2>&1; then
        # (the AUR one is built for one Hyprland version: after an update it may not start either)
        if loaded; then
            notify-send -a Hyprbars "Title bar highlight not rebuilt" "Building it for Hyprland $ver failed, so the title bars have no hover highlight for now. Details: $log"
        else
            notify-send -a Hyprbars "No title bars" "Building hyprbars for Hyprland $ver failed, and the AUR one doesn't start on it: no title bars for now. Details: $log"
        fi
    fi
    exit 0
fi

# Built against the headers on disk: after a Hyprland update they're the new version, and the running (old) one
# would refuse the build
headers=$(grep -oP 'GIT_COMMIT_HASH\s+"\K[0-9a-f]+' /usr/include/hyprland/src/version.h 2>/dev/null || true)
[[ -n $headers ]] || { echo "Can't read the Hyprland headers' version (/usr/include/hyprland/src/version.h): is hyprland's development part installed?"; exit 1; }
[[ $headers == "$hypr" ]] || { echo "Hyprland was updated but this session runs the old one: log out and in first."; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
# At login the network may not be up yet (the clone failed at once): wait for it, at most ~2 min. Not from the pacman
# hook: there it held the update up (at shutdown, the network maybe gone) for a build the next login makes anyway
$prebuild || for _ in $(seq 30); do curl -fsI --max-time 2 https://github.com >/dev/null 2>&1 && break; sleep 2; done
# A stalled clone is given up on and tried again, 3 times (at a login on 2026-11-04 one hung for minutes, the AUR plugin
# staying loaded meanwhile); still failing: the notification of --login says so
for try in 1 2 3; do
    rm -rf "$tmp/src"
    timeout 180 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30 clone -q https://github.com/hyprwm/hyprland-plugins.git "$tmp/src" && break
    [[ $try == 3 ]] && { echo "Couldn't download hyprland-plugins from GitHub (3 tries)."; exit 1; }
    echo "The download of hyprland-plugins failed or stalled: trying again."
    sleep 10
done
# The plugins' version made for this Hyprland: their own list (its commit pinned there), else their tag for this
# release series (v0.57.0 for 0.57.1: point releases get no tag, and their pins come weeks later), else the one the AUR
# package builds for it. A wrong pick only fails to start (the plugin checks the ABI itself): the AUR one stays then
commit=$(grep -oP "\[\"$hypr\", \"\K[0-9a-f]{40}" "$tmp/src/hyprpm.toml" || true)
[[ -n $commit ]] || commit=$(git -C "$tmp/src" rev-parse -q --verify "refs/tags/v${ver%.*}.0^{commit}" || true)
if [[ -z $commit ]]; then
    # (each may find nothing: the message below then, not a silent stop)
    pkgbuild=$(curl -fsSL --connect-timeout 10 -m 60 "https://aur.archlinux.org/cgit/aur.git/plain/PKGBUILD?h=hyprland-plugins" || true)
    pkgver=$(grep -oP "^pkgver='?\K[^'\s]+" <<<"$pkgbuild" || true)
    [[ ${pkgver%.*} == "${ver%.*}" ]] && commit=$(grep -oP "#commit=\K[0-9a-f]{40}" <<<"$pkgbuild" || true)
fi
[[ -n $commit ]] || { echo "No hyprland-plugins version for Hyprland $ver yet: try again in a few days."; exit 1; }

git -C "$tmp/src" checkout -q "$commit"
git -C "$tmp/src" apply "$patch"
# g++ by name: only then does its Makefile add --no-gnu-unique, without which the swap below can't unload the old one
make -C "$tmp/src/hyprbars" -s CXX=g++ all
mkdir -p "${out%/*}"
# A new file renamed over the old: Hyprland may have the old one loaded, and rewriting that in place can crash it
# (its own name: the update-time and login builds can overlap)
install -m755 "$tmp/src/hyprbars/hyprbars.so" "$out.new.$$" && mv -f "$out.new.$$" "$out" || { rm -f "$out.new.$$"; exit 1; }
echo "$build_id" >"$stamp"
if $prebuild; then
    echo "hyprbars with the hover highlight is built for Hyprland $ver: it's loaded at the next login."
    exit 0
fi

# Into the running Hyprland, in place of whichever hyprbars is loaded (from outside the config: loading it reloads
# the config, which is safe only from here). After any game: the reload would take it out of fullscreen
"$HOME/.local/bin/after-games"
for so in "$out" "$aur"; do hyprctl plugin unload "$so" >/dev/null 2>&1 || true; done
hyprctl plugin load "$out" >/dev/null 2>&1 || true
if ! loaded mine; then
    [[ -f $aur ]] && { hyprctl plugin load "$aur" >/dev/null 2>&1 || true; }
    echo "The new build didn't start; the AUR one is loaded instead."
    exit 1
fi
echo "hyprbars with the hover highlight is built and loaded."

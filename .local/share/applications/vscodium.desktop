# VSCodium's own entry with its logo without the white circle (.local/share/icons/hicolor/scalable/apps/vscodiumlogo.svg; no dash in the name: Qt shortens "a-b" to "a" and found Papirus's)
[Desktop Entry]
Name=VSCodium
Comment=Code Editing. Redefined.
GenericName=Text Editor
Exec=/usr/bin/codium %F
TryExec=/usr/bin/codium
Icon=vscodiumlogo
Type=Application
StartupNotify=false
StartupWMClass=codium
Categories=Utility;Development;IDE;
MimeType=text/plain;inode/directory;
Actions=new-empty-window;
Keywords=codium;vscode;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=/usr/bin/codium --new-window %F
Icon=vscodiumlogo

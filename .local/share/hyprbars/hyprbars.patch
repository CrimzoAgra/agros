 void CHyprBar::handleMovement() {
+    if (!m_pWindow.lock())
+        return;
+    // The config can change the window as the drag starts (e.g. un-maximise it round the pointer): a Lua function
+    // dots.titlebar_drag_start(address, phase), if it has one, called "before" the drag starts (a move then is where the
+    // drag starts from) and "after" (a resize then animates, as starting a drag ends any running animation)
+    const auto ADDRESS = std::format("0x{:x}", (uintptr_t)m_pWindow.lock().get());
+    const auto HOOK    = [&ADDRESS](const char* phase) {
+        HyprlandAPI::invokeHyprctlCommand("eval", std::format("if dots and dots.titlebar_drag_start then dots.titlebar_drag_start(\"{}\", \"{}\") end", ADDRESS, phase));
+    };
+    HOOK("before");
+    if (!m_pWindow.lock()) // the hook closed it
+        return;
     g_layoutManager->beginDragTarget(m_pWindow.lock()->layoutTarget(), MBIND_MOVE);
+    HOOK("after");
     m_bDraggingThis = true;
     LOG(Log::DEBUG, "[hyprbars] Dragging initiated on {:x}", (uintptr_t)m_pWindow.lock().get());
     return;
 }
 
+// With general:resize_on_border, the bar's top is the window's top edge: a press on its top 4 px or just above it
+// (Hyprland's grab area: border_size + extend_border_grab_area) resizes upwards, and one just beside the bar resizes
+// that side. Its top corners as big as Hyprland's own (InputManager::setCursorIconOnBorder: rounding + border_size + 10
+// px along each edge, the grab area out): along the top and down the side. Down the side as far as Hyprland's top
+// corner reaches below the bar, the app's surface's top corner (and its rounded corner inside it), is a side: the bar's
+// bottom is no corner. The sides to resize, or 0. Hyprland's own grab area for the top lies round the app's surface,
+// under the bar, where a press is the bar's (a drag there moves the window). Only for the window on top there (a press
+// may reach the focused window's bar through another one)
+int CHyprBar::resizeEdgeAt(const Vector2D& COORDS) {
+    static auto PRESIZEONBORDER = CConfigValue<Config::BOOL>("general:resize_on_border");
+    static auto PBORDERSIZE     = CConfigValue<Config::INTEGER>("general:border_size");
+    static auto PGRABEXTEND     = CConfigValue<Config::INTEGER>("general:extend_border_grab_area");
+    const auto  PWINDOW         = m_pWindow.lock();
+    if (!*PRESIZEONBORDER || g_layoutManager->dragController()->target() || !validMapped(PWINDOW))
+        return 0;
+    const double GRAB   = *PBORDERSIZE + *PGRABEXTEND, W = assignedBoxGlobal().w, HEIGHT = g_pGlobalState->config.barHeight->value();
+    const double CORNER = PWINDOW->presentation().rounding() + PWINDOW->presentation().borderSize() + 10;
+    const auto   MOUSE  = g_pInputManager->getMouseCoordsInternal();
+    if (!VECINRECT(COORDS, -GRAB, -GRAB, W + GRAB, HEIGHT + CORNER))
+        return 0;
+    const bool CURVED = COORDS.y >= HEIGHT && PWINDOW->presentation().isInCurvedCorner(MOUSE.x, MOUSE.y);
+    const int  SIDE   = COORDS.x < 0 || (CURVED && COORDS.x < W / 2) ? Layout::CORNER_LEFT : COORDS.x >= W || CURVED ? Layout::CORNER_RIGHT : 0;
+    const bool TOP    = COORDS.y < 4 || (SIDE && COORDS.y < CORNER);
+    const int  SIDES  = (TOP ? Layout::CORNER_TOP : 0) | (SIDE ? SIDE : !TOP ? 0 : COORDS.x < CORNER ? Layout::CORNER_LEFT : COORDS.x > W - CORNER ? Layout::CORNER_RIGHT : 0);
+    if (!SIDES)
+        return 0;
+    // None on another decoration that takes clicks (a group's tab bar, just above this one), as Hyprland's own edges
+    for (auto const& wd : PWINDOW->presentation().decorations()) {
+        if (wd.get() != this && (wd->getDecorationFlags() & DECORATION_ALLOWS_MOUSE_INPUT) && g_pDecorationPositioner->getWindowDecorationBox(wd.get()).containsPoint(MOUSE))
+            return 0;
+    }
+    return Desktop::CViewHitTester{*Desktop::viewState()}.windowAt(MOUSE, Desktop::View::RESERVED_EXTENTS | Desktop::View::INPUT_EXTENTS | Desktop::View::ALLOW_FLOATING) ==
+            PWINDOW ?
+        SIDES :
+        0;
+}
+
+// The window back as it was before a touch drag of the bar: unpinned, and tiled only if it was
+void CHyprBar::endTouchDrag() {
+    if (const auto PWINDOW = m_pWindow.lock()) {
+        if (m_bTouchPinned)
+            (void)Config::Actions::pinWindow(Config::Actions::eTogglableAction::TOGGLE_ACTION_DISABLE, PWINDOW);
+        if (m_bTouchFloated)
+            (void)Config::Actions::floatWindow(Config::Actions::eTogglableAction::TOGGLE_ACTION_DISABLE, PWINDOW);
+    }
+    m_bTouchFloated = m_bTouchPinned = false;
+}

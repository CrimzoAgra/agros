+// Every drag of a window, whatever starts it: this bar, the app's own title bar (GTK header bars, Electron's, Qt's: the
+// app asks Hyprland to move it), its edges, Super+drag. The config's dots.window_drag_start(address, "move"/"resize")
+// runs first, so a maximised window un-maximises (round the pointer, for a move) and the drag goes on from its new
+// size; apps can't do it themselves, as Hyprland never tells them they're maximised.
+// Resizing by an edge (the config's general.resize_on_border) moves that edge only, as on Windows: Hyprland grabs the
+// corner nearest the pointer, so dragging the right edge sideways changed the height too. A press outside the window
+// (its border, or the grab area round it, as Hyprland checks) moves the side or sides it's past, or the corner where
+// Hyprland shows a corner cursor (rounding + border_size + 10 px along each edge from the corner, as
+// InputManager::setCursorIconOnBorder); one inside it (a rounded corner, Super+right-drag) keeps Hyprland's corner
+static CFunctionHook* g_pBeginDragHook = nullptr;
+typedef void (*origBeginDrag)(Layout::CLayoutManager*, SP<Layout::ITarget>, eMouseBindMode, std::optional<Layout::eRectCorner>, bool);
+static void hkBeginDrag(Layout::CLayoutManager* thisptr, SP<Layout::ITarget> target, eMouseBindMode mode, std::optional<Layout::eRectCorner> edge, bool exclusive) {
+    if (mode == MBIND_RESIZE && !edge && target && target->window()) {
+        const auto BOX   = target->window()->geometricBox(Desktop::View::IGeometric::GEOMETRIC_CURRENT);
+        const auto MOUSE = g_pInputManager->getMouseCoordsInternal();
+        int        sides = Layout::CORNER_NONE;
+        if (MOUSE.x < BOX.x)

+// {address} in a button's or the double click's command: this bar's window (the focused one may have changed by the
+// time the command runs)
+std::string CHyprBar::withAddress(std::string cmd) {
+    const auto ADDRESS = std::format("0x{:x}", (uintptr_t)m_pWindow.lock().get());
+    for (size_t p = cmd.find("{address}"); p != std::string::npos; p = cmd.find("{address}", p + ADDRESS.size()))
+        cmd.replace(p, 9, ADDRESS);
+    return cmd;
+}

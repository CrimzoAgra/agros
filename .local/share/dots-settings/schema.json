{
  "pages": [
    {
      "id": "windows",
      "title": "Windows",
      "icon": "select_window",
      "groups": [
        {
          "title": "Behaviour",
          "settings": [
            {
              "key": "windows.mode",
              "label": "Window mode",
              "description": "Floating: windows open in the middle and overlap, like Windows. Tiling: they share the screen side by side. Switches every open window too (also Super+Alt+Space, or the bar's right-click menu).",
              "type": "choice",
              "options": [
                {
                  "value": "floating",
                  "label": "Floating"
                },
                {
                  "value": "tiling",
                  "label": "Tiling"
                }
              ],
              "default": "floating",
              "get": "cat ~/.local/state/window-mode 2>/dev/null || echo floating",
              "set": "[ \"$(cat ~/.local/state/window-mode 2>/dev/null || echo floating)\" = \"$VALUE\" ] || hyprctl eval 'dots.toggle_window_mode()'"
            },
            {
              "key": "windows.focus",
              "label": "Focus in floating mode",
              "description": "Click: a window takes focus when you click it, as on Windows. Hover: when the pointer moves onto it. (Tiling mode always focuses on hover.)",
              "type": "choice",
              "options": [
                {
                  "value": "click",
                  "label": "Click"
                },
                {
                  "value": "hover",
                  "label": "Hover"
                }
              ],
              "default": "hover",
              "apply": "hypr"
            },
            {
              "key": "windows.cascade",
              "label": "Cascade new windows",
              "description": "Each window opened in floating mode goes a step down and right of the one before, so none hides another. Off: all open in the middle.",
              "type": "bool",
              "default": true,
              "apply": "hypr"
            },
            {
              "key": "windows.titlebars",
              "label": "Title bars",
              "description": "Title bars with minimise, maximise and close buttons on floating windows.",
              "type": "bool",
              "default": true,
              "apply": "hypr"
            }
          ]
        }
      ]
    },
    {
      "id": "input",
      "title": "Mouse and keyboard",
      "icon": "mouse",
      "groups": [
        {
          "title": "Mouse",
          "settings": [
            {
              "key": "input.mouse_dpi",
              "label": "Mouse DPI",
              "description": "The mouse's own DPI (Logitech mice, through Solaar): the desktop and games both follow. Lower is slower. Own: whatever the mouse's own profile sets.",
              "type": "choice",
              "options": [
                {
                  "value": "",
                  "label": "Own"
                },
                {
                  "value": "400",
                  "label": "400"
                },
                {
                  "value": "600",
                  "label": "600"
                },
                {
                  "value": "800",
                  "label": "800"
                },
                {
                  "value": "1000",
                  "label": "1000"
                },
                {
                  "value": "1200",
                  "label": "1200"
                },
                {
                  "value": "1600",
                  "label": "1600"
                }
              ],
              "default": "",
              "apply": "mouse-dpi"
            },
            {
              "key": "input.mouse_accel",
              "label": "Mouse acceleration",
              "description": "Off (the default): the pointer moves exactly as far as the hand, as in games. On: faster movements move it further (libinput's own default, feels floaty).",
              "type": "bool",
              "default": false,
              "apply": "hypr"
            },
            {
              "key": "input.sensitivity",
              "label": "Pointer speed",
              "description": "Faster or slower than the mouse moves it (0: as it is). With a Logitech mouse, its DPI above changes it for games too.",
              "type": "number",
              "min": -1,
              "max": 1,
              "step": 0.05,
              "default": 0,
              "apply": "hypr"
            },
            {
              "key": "input.natural_scroll",
              "label": "Natural scrolling",
              "description": "The wheel moves the page, not the view: rolling it down scrolls up, as on a phone.",
              "type": "bool",
              "default": false,
              "apply": "hypr"
            }
          ]
        },
        {
          "title": "Touchpad",
          "settings": [
            {
              "key": "input.touchpad_natural_scroll",
              "label": "Natural scrolling",
              "description": "Two fingers move the page, as on a phone (off: the other way, as with a mouse wheel).",
              "type": "bool",
              "default": true,
              "apply": "hypr"
            },
            {
              "key": "input.tap_to_click",
              "label": "Tap to click",
              "description": "A tap is a click (two fingers: right click).",
              "type": "bool",
              "default": true,
              "apply": "hypr"
            },
            {
              "key": "caelestia-vars.touchpadDisableTyping",
              "label": "Off while typing",
              "description": "The touchpad ignores your palm while you type.",
              "type": "bool",
              "default": true,
              "apply": "hypr"
            },
            {
              "key": "caelestia-vars.touchpadScrollFactor",
              "label": "Scrolling speed",
              "description": "How far two fingers scroll.",
              "type": "number",
              "default": 0.3,
              "apply": "hypr",
              "min": 0.05,
              "max": 2,
              "step": 0.05
            }
          ]
        },
        {
          "title": "Keyboard",
          "settings": [
            {
              "key": "input.kb_layout",
              "label": "Layout",
              "description": "The keyboard layout, as the installer set it (the login screen uses it too): us, pt, de... Several, comma-separated (us,pt), with a key to switch between them in Options below. Asks for your password.",
              "type": "text",
              "default": "us",
              "apply": "hypr",
              "get": "xkb() { sed -n \"s/.*\\\"Xkb$1\\\" *\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" /etc/X11/xorg.conf.d/00-keyboard.conf 2>/dev/null; }; xkb Layout",
              "set": "xkb() { sed -n \"s/.*\\\"Xkb$1\\\" *\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" /etc/X11/xorg.conf.d/00-keyboard.conf 2>/dev/null; }; localectl set-x11-keymap \"$VALUE\" \"$(xkb Model)\" \"\" \"$(xkb Options)\""
            },
            {
              "key": "input.kb_variant",
              "label": "Variant",
              "description": "A variant of the layout (Dvorak, no dead keys...). Asks for your password.",
              "type": "choice",
              "open": true,
              "default": "",
              "apply": "hypr",
              "get": "xkb() { sed -n \"s/.*\\\"Xkb$1\\\" *\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" /etc/X11/xorg.conf.d/00-keyboard.conf 2>/dev/null; }; xkb Variant",
              "options_cmd": "xkb() { sed -n \"s/.*\\\"Xkb$1\\\" *\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" /etc/X11/xorg.conf.d/00-keyboard.conf 2>/dev/null; }; printf \"\\tNone\\n\"; localectl list-x11-keymap-variants \"$(xkb Layout)\" 2>/dev/null",
              "set": "xkb() { sed -n \"s/.*\\\"Xkb$1\\\" *\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" /etc/X11/xorg.conf.d/00-keyboard.conf 2>/dev/null; }; localectl set-x11-keymap \"$(xkb Layout)\" \"$(xkb Model)\" \"$VALUE\" \"$(xkb Options)\""
            },
            {
              "key": "input.kb_options",
              "label": "Options",
              "description": "Extra keyboard options, comma-separated: grp:alt_shift_toggle switches layouts with Alt+Shift, caps:escape makes Caps Lock an Escape. Asks for your password.",
              "type": "text",
              "default": "",
              "apply": "hypr",
              "get": "xkb() { sed -n \"s/.*\\\"Xkb$1\\\" *\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" /etc/X11/xorg.conf.d/00-keyboard.conf 2>/dev/null; }; xkb Options",
              "set": "xkb() { sed -n \"s/.*\\\"Xkb$1\\\" *\\\"\\([^\\\"]*\\)\\\".*/\\1/p\" /etc/X11/xorg.conf.d/00-keyboard.conf 2>/dev/null; }; localectl set-x11-keymap \"$(xkb Layout)\" \"$(xkb Model)\" \"$(xkb Variant)\" \"$VALUE\""
            },
            {
              "key": "input.repeat_rate",
              "label": "Key repeat rate",
              "description": "Characters a second while a key is held.",
              "type": "number",
              "integer": true,
              "min": 1,
              "max": 100,
              "step": 1,
              "default": 35,
              "apply": "hypr"
            },
            {
              "key": "input.repeat_delay",
              "label": "Key repeat delay",
              "description": "Milliseconds a key is held before it repeats.",
              "type": "number",
              "integer": true,
              "min": 100,
              "max": 1000,
              "step": 10,
              "default": 250,
              "apply": "hypr"
            }
          ]
        }
      ]
    },
    {
      "id": "screens",
      "title": "Screens",
      "icon": "desktop_windows",
      "groups": [
        {
          "title": "Arrangement",
          "arrange": true,
          "settings": [
            {
              "key": "screens.main",
              "label": "Main screen",
              "description": "It gets workspaces 1-10, and the windows of a screen unplugged. Until the screens are dragged into place above (or given a position), it's at the top left and the others go to its right.",
              "type": "choice",
              "default": "",
              "apply": "hypr",
              "options_cmd": "printf '\\tAutomatic\\n'; hyprctl -j monitors all 2>/dev/null | jq -r '.[] | select(.name != \"FALLBACK\") | \"\\(if .description != \"\" then .description else .name end)\\t\\(.name)\\(if .model != \"\" then \": \" + .model else \"\" end)\"'",
              "open": true
            }
          ]
        },
        {
          "title": "Night light (from the next login)",
          "settings": [
            {
              "key": "nightlight",
              "label": "Night light",
              "description": "Warmer screens after sunset, from where your PC finds you on the network.",
              "type": "bool",
              "default": false
            }
          ]
        },
        {
          "title": "Screens",
          "from": "screens"
        }
      ]
    },
    {
      "id": "look",
      "title": "Look",
      "icon": "palette",
      "groups": [
        {
          "title": "Wallpaper",
          "per_screen": true,
          "settings": [
            {
              "key": "look.wallpaper",
              "label": "Wallpaper",
              "description": "Pictures in Pictures/Wallpapers (add your own there). The colours follow it with the Dynamic scheme. With more than one screen, each can have its own below.",
              "type": "image",
              "open": true,
              "get": "cat ~/.local/state/caelestia/wallpaper/path.txt 2>/dev/null",
              "options_cmd": "find -L ~/Pictures/Wallpapers -maxdepth 2 -type f \\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \\) 2>/dev/null | sort",
              "set": "caelestia wallpaper -f \"$VALUE\""
            }
          ]
        },
        {
          "title": "Colours",
          "settings": [
            {
              "key": "look.scheme",
              "label": "Colour scheme",
              "description": "Dynamic: colours taken from the wallpaper.",
              "type": "choice",
              "open": true,
              "get": "jq -r .name ~/.local/state/caelestia/scheme.json 2>/dev/null",
              "options_cmd": "caelestia scheme list -n | awk '{print $0 \"\\t\" toupper(substr($0,1,1)) substr($0,2)}'",
              "set": "caelestia scheme set -n \"$VALUE\""
            },
            {
              "key": "look.mode",
              "label": "Light or dark",
              "description": "AMOLED: dark, with the shell pure black (the bar, its border, the panels) and the surfaces on it darker.",
              "type": "choice",
              "options": [
                {
                  "value": "light",
                  "label": "Light"
                },
                {
                  "value": "dark",
                  "label": "Dark"
                },
                {
                  "value": "amoled",
                  "label": "AMOLED"
                }
              ],
              "get": "m=$(jq -r .mode ~/.local/state/caelestia/scheme.json 2>/dev/null); [ \"$m\" = dark ] && [ \"$(jq '.\"look.amoled\"' ~/.config/dots/settings.json 2>/dev/null)\" != false ] && m=amoled; echo \"$m\"",
              "set": "m=$VALUE; [ \"$m\" = light ] || { dots-settings set look.amoled \"$([ \"$m\" = amoled ] && echo true || echo false)\" && m=dark; }; caelestia scheme set -m \"$m\""
            },
            {
              "key": "look.amoled",
              "label": "AMOLED black",
              "description": "Light or dark's AMOLED: in dark mode, the shell pure black.",
              "type": "bool",
              "hidden": true,
              "default": true
            },
            {
              "key": "look.variant",
              "label": "Colour style",
              "description": "How colours are picked from the wallpaper or scheme: Tonal spot is calm, Vibrant and Expressive bolder.",
              "type": "choice",
              "open": true,
              "get": "jq -r .variant ~/.local/state/caelestia/scheme.json 2>/dev/null",
              "options_cmd": "caelestia scheme list -v | awk 'BEGIN {n[\"tonalspot\"] = \"Tonal spot\"; n[\"fruitsalad\"] = \"Fruit salad\"} {print $0 \"\\t\" ($0 in n ? n[$0] : toupper(substr($0,1,1)) substr($0,2))}'",
              "set": "caelestia scheme set -v \"$VALUE\""
            },
            {
              "key": "caelestia-shell.services.smartScheme",
              "label": "Light or dark from the wallpaper",
              "description": "A new wallpaper switches light and dark to suit it."
            }
          ]
        },
        {
          "title": "Fonts (the shell's)",
          "settings": [
            {
              "key": "caelestia-shell.appearance.font.body.family",
              "label": "Text",
              "type": "choice",
              "open": true,
              "options_cmd": "fc-list : family | cut -d, -f1 | sort -u",
              "preview": "font"
            },
            {
              "key": "caelestia-shell.appearance.font.title.family",
              "label": "Titles",
              "type": "choice",
              "open": true,
              "options_cmd": "fc-list : family | cut -d, -f1 | sort -u",
              "preview": "font"
            },
            {
              "key": "caelestia-shell.appearance.font.mono.family",
              "label": "Monospace",
              "type": "choice",
              "open": true,
              "options_cmd": "fc-list : family | cut -d, -f1 | sort -u",
              "preview": "font"
            },
            {
              "key": "caelestia-shell.appearance.font.scale",
              "label": "Text size",
              "description": "Every text in the shell, bigger or smaller.",
              "min": 0.5,
              "max": 2,
              "step": 0.05
            }
          ]
        },
        {
          "title": "Windows",
          "settings": [
            {
              "key": "caelestia-vars.windowGapsIn",
              "label": "Gap between windows",
              "description": "Pixels between tiled windows.",
              "type": "number",
              "default": 5,
              "apply": "hypr",
              "integer": true,
              "min": 0,
              "max": 40,
              "step": 1
            },
            {
              "key": "caelestia-vars.windowGapsOut",
              "label": "Gap at the screen's edges",
              "description": "Pixels between windows and the screen's edges.",
              "type": "number",
              "default": 10,
              "apply": "hypr",
              "integer": true,
              "min": 0,
              "max": 60,
              "step": 1
            },
            {
              "key": "caelestia-vars.singleWindowGapsOut",
              "label": "Gap around a window alone",
              "description": "Pixels around the only tiled window on a workspace.",
              "type": "number",
              "default": 20,
              "apply": "hypr",
              "integer": true,
              "min": 0,
              "max": 80,
              "step": 1
            },
            {
              "key": "caelestia-vars.windowBorderSize",
              "label": "Border",
              "description": "The border's width around windows, in pixels.",
              "type": "number",
              "default": 1,
              "apply": "hypr",
              "integer": true,
              "min": 0,
              "max": 10,
              "step": 1
            },
            {
              "key": "caelestia-vars.windowRounding",
              "label": "Rounded corners",
              "description": "How round windows' corners are, in pixels (0: square).",
              "type": "number",
              "default": 15,
              "apply": "hypr",
              "integer": true,
              "min": 0,
              "max": 40,
              "step": 1
            },
            {
              "key": "caelestia-vars.blurEnabled",
              "label": "Blur behind see-through windows",
              "type": "bool",
              "default": true,
              "apply": "hypr"
            },
            {
              "key": "caelestia-vars.shadowEnabled",
              "label": "Shadows",
              "type": "bool",
              "default": true,
              "apply": "hypr"
            }
          ]
        },
        {
          "title": "Shell",
          "settings": [
            {
              "key": "caelestia-shell.appearance.transparency.enabled",
              "label": "See-through shell",
              "description": "The bar and panels let the wallpaper show through."
            },
            {
              "key": "caelestia-shell.appearance.transparency.base",
              "label": "How see-through",
              "description": "Lower: more see-through."
            },
            {
              "key": "caelestia-shell.appearance.rounding.scale",
              "label": "Rounded corners",
              "description": "How round the shell's corners are."
            },
            {
              "key": "caelestia-shell.border.thickness",
              "label": "Screen frame",
              "description": "The frame around the screen's edges, in pixels.",
              "min": 0,
              "max": 40
            },
            {
              "key": "caelestia-shell.border.rounding",
              "label": "Frame corners",
              "description": "How round the frame's inner corners are.",
              "min": 0,
              "max": 60
            }
          ]
        }
      ]
    },
    {
      "id": "bar",
      "title": "Bar",
      "icon": "view_sidebar",
      "groups": [
        {
          "title": "Bar",
          "settings": [
            {
              "key": "bar.side",
              "label": "Bar position",
              "description": "The screen edge it's on; the panels there move out of its way. The shell restarts to move it.",
              "type": "choice",
              "default": "bottom",
              "options": [
                {"value": "left", "label": "Left"},
                {"value": "right", "label": "Right"},
                {"value": "top", "label": "Top"},
                {"value": "bottom", "label": "Bottom"}
              ],
              "apply": "caelestia"
            },
            {
              "key": "caelestia-shell.bar.persistent",
              "label": "Always shown",
              "description": "Off: it hides, and shows when the pointer reaches the screen's edge it's on."
            },
            {
              "key": "caelestia-shell.bar.showOnHover",
              "label": "Shows on hover",
              "description": "The pointer at the screen's edge brings it out while it's hidden."
            },
            {
              "key": "caelestia-shell.bar.excludedScreens",
              "label": "Screens without a bar",
              "description": "Their names in JSON, like [\"HDMI-A-1\"] (Screens page)."
            }
          ]
        },
        {
          "title": "Workspaces",
          "settings": [
            {
              "key": "caelestia-shell.bar.workspaces.shown",
              "label": "Workspaces shown",
              "min": 1,
              "max": 10
            },
            {
              "key": "caelestia-shell.bar.workspaces.showWindows",
              "label": "App icons",
              "description": "The icons of the apps open on each workspace."
            },
            {
              "key": "caelestia-shell.bar.workspaces.maxWindowIcons",
              "label": "Most app icons per workspace",
              "min": 1,
              "max": 10
            },
            {
              "key": "caelestia-shell.bar.workspaces.activeIndicator",
              "label": "Mark the current one"
            },
            {
              "key": "caelestia-shell.bar.workspaces.occupiedBg",
              "label": "Highlight ones with windows"
            },
            {
              "key": "caelestia-shell.bar.workspaces.showUnoccupied",
              "label": "Empty ones too"
            },
            {
              "key": "caelestia-shell.bar.workspaces.perMonitor",
              "label": "Each screen its own",
              "description": "Each screen shows the workspaces on it."
            }
          ]
        },
        {
          "title": "Clock and tray",
          "settings": [
            {
              "key": "caelestia-shell.bar.clock.showDate",
              "label": "Date"
            },
            {
              "key": "caelestia-shell.bar.clock.showSeconds",
              "label": "Seconds"
            },
            {
              "key": "caelestia-shell.bar.clock.showIcon",
              "label": "Clock icon"
            },
            {
              "key": "caelestia-shell.bar.tray.compact",
              "label": "Compact tray",
              "description": "Tray icons behind one button."
            },
            {
              "key": "caelestia-shell.bar.tray.background",
              "label": "Tray background"
            },
            {
              "key": "caelestia-shell.bar.tray.recolour",
              "label": "Tray icons in the scheme's colours"
            }
          ]
        },
        {
          "title": "Scrolling on the bar",
          "settings": [
            {
              "key": "caelestia-shell.bar.scrollActions.workspaces",
              "label": "On the workspaces: switch workspace"
            },
            {
              "key": "caelestia-shell.bar.scrollActions.volume",
              "label": "On the right half: volume"
            },
            {
              "key": "caelestia-shell.bar.scrollActions.brightness",
              "label": "On the left half: brightness"
            }
          ]
        },
        {
          "title": "Pop-ups on hover",
          "settings": [
            {
              "key": "caelestia-shell.bar.popouts.activeWindow",
              "label": "Window title"
            },
            {
              "key": "caelestia-shell.bar.popouts.tray",
              "label": "Tray"
            },
            {
              "key": "caelestia-shell.bar.popouts.statusIcons",
              "label": "Status icons"
            }
          ]
        }
      ]
    },
    {
      "id": "panels",
      "title": "Panels",
      "icon": "dashboard",
      "groups": [
        {
          "title": "Dashboard (top edge)",
          "settings": [
            {
              "key": "caelestia-shell.dashboard.enabled",
              "label": "Dashboard"
            },
            {
              "key": "caelestia-shell.dashboard.showOnHover",
              "label": "Opens on hover",
              "description": "The pointer at the top edge opens it."
            },
            {
              "key": "caelestia-shell.dashboard.showMedia",
              "label": "Media tab"
            },
            {
              "key": "caelestia-shell.dashboard.showPerformance",
              "label": "Performance tab"
            },
            {
              "key": "caelestia-shell.dashboard.showWeather",
              "label": "Weather"
            },
            {
              "key": "caelestia-shell.dashboard.showClockSeconds",
              "label": "Seconds on its clock"
            },
            {
              "key": "caelestia-shell.dashboard.performance.showCpu",
              "label": "Processor"
            },
            {
              "key": "caelestia-shell.dashboard.performance.showGpu",
              "label": "Graphics card"
            },
            {
              "key": "caelestia-shell.dashboard.performance.showMemory",
              "label": "Memory"
            },
            {
              "key": "caelestia-shell.dashboard.performance.showStorage",
              "label": "Storage"
            },
            {
              "key": "caelestia-shell.dashboard.performance.showNetwork",
              "label": "Network"
            },
            {
              "key": "caelestia-shell.dashboard.performance.showBattery",
              "label": "Battery"
            }
          ]
        },
        {
          "title": "Sidebar and quick settings (right edge)",
          "settings": [
            {
              "key": "caelestia-shell.sidebar.enabled",
              "label": "Sidebar",
              "description": "Notifications history and more."
            },
            {
              "key": "caelestia-shell.sidebar.showOnHover",
              "label": "Opens on hover"
            },
            {
              "key": "caelestia-shell.utilities.enabled",
              "label": "Quick settings",

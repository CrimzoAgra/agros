# Maintainer: Filipe Agra
# The desktop's settings for every new account (/etc/skel): Caelestia's own configs (pinned, what `caelestia install`
# would put in your home), AgrOS's over them (Hyprland user modules, Caelestia's shell.json, the widgets, switcher,
# Updates and Settings apps, launcher entries, LibreWolf and VSCodium settings, the user services), and every version
# each of them has had, so agros-links can update the ones you never edited. Fonts and icons go system-wide.
pkgname=agros-hyprland-settings
pkgver=0
pkgrel=1
pkgdesc='AgrOS Hyprland + Caelestia settings for new users (/etc/skel), fonts and icons'
arch=('any')
url='https://github.com/CrimzoAgra/agros'
license=('GPL-3.0-or-later' 'OFL-1.1')
depends=('agros-scripts' 'caelestia-shell')  # (caelestia-shell: the wallpaper folder's link to its wallpaper)
# CachyOS's own fish and micro settings put their files in /etc/skel too: AgrOS's replace them
conflicts=('cachyos-fish-config' 'cachyos-micro-settings')
replaces=('cachyos-fish-config' 'cachyos-micro-settings')
makedepends=('git')
# Caelestia's dots (caelestia-dots/caelestia), pinned: a new commit is taken on purpose, after checking it (the Friday
# status, ci/status.sh, says how far upstream has gone since)
_dots=01d2df329240be60148d25804690779a078c6378
source=("caelestia-dots::git+https://github.com/caelestia-dots/caelestia.git#commit=${_dots}")
sha256sums=('SKIP')
_root=$(realpath "${startdir}/../..")
# Caelestia's components AgrOS takes (its installer's defaults, plus uwsm and the Spotify theme), as "source|dest"
_components=(hypr fish foot fastfetch btop micro "thunar|Thunar" starship.toml uwsm spicetify)
# Its shell started by caelestia-start: on AgrOS's changes to it from the first login (checked at every login, rebuilt
# when out of date or missing), else it came up on Caelestia's own config (no dock, the bar laid out otherwise) and
# jumped when agros-welcome rebuilt it and restarted it; and each start logged. Its night light (gammastep) not started:
# off by default, Settings > Startup turns it on (user/apps.lua)
_execs_start='s|^\( *\)hl.exec_cmd("caelestia shell -d")$|\1hl.exec_cmd("~/.local/bin/caelestia-start")|'
_execs_sed="$_execs_start"'; /^ *hl.exec_cmd("sleep 1 && gammastep")$/d'
# Settings that are yours to change, through the apps that write them (Caelestia's settings and weather location, the
# dock's pins, default apps, Settings > Startup, VSCodium, Legion Control) or one machine's own (hosts/): copied into a
# home once, never updated (one an app wrote back to an older AgrOS version would read as never edited)
_own=(.config/caelestia/shell.json .config/quickshell/sidedock/pins.json .config/mimeapps.list '.config/autostart/*'
    '.config/VSCodium/*' '.config/legion-control/*' '.config/caelestia/user/hosts/*')

# _versions <skel>: "<sha256>  <path>" of each version every settings file in <skel> has had: from
# AgrOS's history and Caelestia's, as package() copies them (thunar as Thunar, execs.lua changed), and as it is now
# (the only one known for a file changed some other way at build time)
_versions() {
    local skel=$1 c src dest r b p s o e fix
    {
        git -C "$_root" log --format= --raw --root --no-abbrev --no-renames HEAD -- .config .local/share |
            while read -r _ _ _ b _ p; do echo "$_root $b $p"; done
        for c in "${_components[@]}"; do
            src=${c%%|*} dest=${c#*|}
            git -C "$srcdir/caelestia-dots" log --format= --raw --root --no-abbrev --no-renames HEAD -- "$src" |
                while read -r _ _ _ b _ p; do echo "$srcdir/caelestia-dots $b .config/$dest${p#"$src"}"; done
        done
    } | LC_ALL=C sort -u | while read -r r b p; do
        # (deleted in that commit, or not a settings file any more)
        [[ $b != 0000000000000000000000000000000000000000 && -f $skel/$p && ! -L $skel/$p ]] || continue
        # (execs.lua as AgrOS has shipped it: its night light still started too, as until 2026-11-17)
        [[ $p == .config/hypr/hyprland/execs.lua ]] && fix=("$_execs_sed" "$_execs_start") || fix=('')
        for e in "${fix[@]}"; do
            s=$(git -C "$r" cat-file blob "$b" | sed "$e" | sha256sum) && echo "${s%% *}  $p"
        done
    done
    (cd "$skel" && find .config .local/share -type f -exec sha256sum {} +)
}

pkgver() {
    cd "$_root" && printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    local skel="$pkgdir/etc/skel" c src dest s p o
    install -d "$skel/.config"
    # 1. Caelestia's configs
    for c in "${_components[@]}"; do
        src=${c%%|*} dest=${c#*|}
        cp -r --no-preserve=ownership "$srcdir/caelestia-dots/$src" "$skel/.config/$dest"
    done
    # Its shell started by caelestia-start, its night light not (_execs_sed)
    sed -i "$_execs_sed" "$skel/.config/hypr/hyprland/execs.lua"
    grep -q 'hl.exec_cmd("~/.local/bin/caelestia-start")' "$skel/.config/hypr/hyprland/execs.lua" ||
        { echo "Caelestia's execs.lua changed: its shell's start not found" >&2; return 1; }
    ! grep -q gammastep "$skel/.config/hypr/hyprland/execs.lua" ||
        { echo "Caelestia's execs.lua changed: its night light's start not taken out" >&2; return 1; }
    # 2. AgrOS's, over them
    cd "$_root"
    cp -r --no-preserve=ownership .config/. "$skel/.config/"
    # Caelestia's own wallpaper in the wallpaper folder, so its picker (and Random) have one to show
    install -d "$skel/Pictures/Wallpapers"
    ln -s /etc/xdg/quickshell/caelestia/assets/wallpaper.webp "$skel/Pictures/Wallpapers/caelestia.webp"
    install -d "$skel/.local/share"
    # (lutris: the Rockstar Games Launcher's cover and banner, which Lutris has none of)
    cp -r --no-preserve=ownership .local/share/applications .local/share/firefox .local/share/lutris "$skel/.local/share/"
    # Fonts and icons: system-wide
    install -Dm644 .local/share/fonts/Bangers-Regular.ttf "$pkgdir/usr/share/fonts/agros/Bangers-Regular.ttf"
    install -Dm644 .local/share/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-Bangers.txt"
    cp -r --no-preserve=ownership .local/share/icons "$pkgdir/usr/share/"
    find "$skel" -name __pycache__ -prune -exec rm -rf {} +
    # 3. Every version of each settings file (agros-links: yours updated at login while it's one of them)
    install -d "$pkgdir/usr/share/agros"
    _versions "$skel" | while read -r s p; do
        # shellcheck disable=SC2053  # (_own's are patterns)
        for o in "${_own[@]}"; do [[ $p == $o ]] && continue 2; done
        echo "$s  $p"
    done | LC_ALL=C sort -u >"$pkgdir/usr/share/agros/skel-versions"
}

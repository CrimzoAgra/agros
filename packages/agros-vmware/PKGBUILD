# Maintainer: Filipe Agra
# In a VMware virtual machine: the desktop drawn on its virtual GPU (VMware's 3D acceleration: the host's GPU), apps
# included. vmw-dmabuf.so (vmw-dmabuf.c) lets the compositors, Hyprland and the login screen's cage, accept the apps'
# GPU buffers on VMware's vmwgfx driver, which they otherwise refuse (every GPU app dropped). Loaded only into those two
# and only where vmwgfx is loaded (hyprland-vmw-dmabuf.conf, a drop-in for Hyprland's uwsm unit; agros-greeter's run);
# anywhere else it's never loaded, and even loaded it only acts on vmwgfx
pkgname=agros-vmware
# (its version from the commits that touch it: compiled, so CI can't tell a change from a rebuild. "2." puts it above the
# 1-1 once published, with no epoch: an epoch's ':' would go in the file's name on GitHub Pages)
pkgver=0
pkgrel=1
pkgdesc='AgrOS in a VMware VM: the desktop and apps on the virtual GPU (vmw-dmabuf shim for the compositors)'
arch=('x86_64')
url='https://github.com/CrimzoAgra/agros'
license=('GPL-3.0-or-later')
depends=('libdrm')
source=('vmw-dmabuf.c')
sha256sums=('SKIP')

pkgver() {
    cd "$startdir" && printf '2.r%s.%s' "$(git rev-list --count HEAD -- .)" "$(git log -1 --format=%h -- .)"
}

build() {
    # shellcheck disable=SC2046  # (pkg-config's flags, split into words on purpose)
    gcc $CFLAGS $LDFLAGS -shared -fPIC -o vmw-dmabuf.so vmw-dmabuf.c $(pkg-config --cflags --libs libdrm) -ldl
}

package() {
    install -Dm755 vmw-dmabuf.so "$pkgdir/usr/lib/agros/vmw-dmabuf.so"
    install -Dm644 "$startdir/hyprland-vmw-dmabuf.conf" \
        "$pkgdir/usr/lib/systemd/user/wayland-wm@hyprland.desktop.service.d/agros-vmw-dmabuf.conf"
}

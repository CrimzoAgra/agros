# (AGROS_ROOT: another root, the tests' throwaway one; / when pacman runs this)
_r=${AGROS_ROOT:-}
# UFW's logging off, once (where UFW is installed; its setting yours after): it logged a BLOCK line every 20 s for the
# router's multicast queries, filling the journal. The note it's done holds the level it had (the removal's to put back)
_ufw_done=$_r/var/lib/agros/ufw-logging-off
quiet_ufw() {
    local level
    [[ -f $_r/etc/ufw/ufw.conf && ! -e $_ufw_done ]] || return 0
    level=$(sed -n 's/^LOGLEVEL=//p' "$_r/etc/ufw/ufw.conf")
    # (ufw's own command: it rewrites its LOG rules too, firewall on or off; the setting alone left them. Where it
    # can't run (the installer's chroot), tried again at the next upgrade)
    ufw logging off >/dev/null 2>&1 || return 0
    mkdir -p "${_ufw_done%/*}" && echo "$level" >"$_ufw_done"
}
# Passim off, once (its note: removal puts it back): fwupd's optional LAN cache, a network listener (mDNS, HTTPS on
# 27500) sharing fwupd's metadata with the LAN, started over D-Bus by fwupd. fwupd works without it (it only logs, at
# debug, that it isn't there), so masked: not started, by fwupd or anything else. Your own unmask stays
_passim_done=$_r/var/lib/agros/passim-masked
quiet_passim() {
    [[ -e $_passim_done ]] && return 0
    systemctl mask passim.service >/dev/null 2>&1 || return 0
    systemctl stop passim.service >/dev/null 2>&1
    mkdir -p "${_passim_done%/*}" && : >"$_passim_done"
}

# [agros] in pacman.conf as agros-iso's pacman.conf files have it: its database's signature required too (pacman's
# default, DatabaseOptional, took an unsigned one: a server could list packages AgrOS's CI never put together). Added under
# [agros] where missing, at install and at upgrade (machines installed before); a SigLevel of yours there stays. And
# its second server, AgrOS's mirror on Cloudflare R2 (agros's mirror.yml), after its others: pacman tries GitHub Pages
# first, the mirror when Pages can't be reached. Its line commented out (#Server = <mirror>) is yours: not added again.
# Both taken out at removal (agros_repo remove), only as added
_agros_sig='SigLevel = Required DatabaseRequired'
_agros_mirror='https://pub-f1a3a482900748e8b69cd81361ab96e1.r2.dev/repo/$arch'
agros_repo() {
    local conf=$_r/etc/pacman.conf new
    [[ -f $conf ]] && grep -q '^\[agros\][[:space:]]*$' "$conf" || return 0
    new=$(awk -v mode="${1:-add}" -v sig="$_agros_sig" -v murl="$_agros_mirror" '
        { line[NR] = $0 }
        END {
            mirror = "Server = " murl
            for (i = 1; i <= NR; i++) if (line[i] ~ /^\[agros\][ \t]*$/) { s = i; break }
            e = NR
            for (i = s + 1; i <= NR; i++) if (line[i] ~ /^[ \t]*\[/) { e = i - 1; break }
            last = s
            for (i = s + 1; i <= e; i++) {
                if (line[i] ~ /^[ \t]*SigLevel[ \t]*=/) hassig = 1
                if (index(line[i], murl)) hasmirror = 1
                if (line[i] ~ /^[ \t]*(Server|Include)[ \t]*=/) last = i
            }
            for (i = 1; i <= NR; i++) {
                t = line[i]; sub(/[ \t]+$/, "", t)
                if (mode == "remove" && i > s && i <= e && (t == sig || t == mirror)) continue
                print line[i]
                if (mode == "add" && i == s && !hassig) print sig
                if (mode == "add" && i == last && !hasmirror) print mirror
            }
        }' "$conf") || return 0
    # (written over in place: pacman.conf keeps its owner and mode)
    [[ $new == "$(cat "$conf")" ]] || printf '%s\n' "$new" >"$conf"
}

# The files no one uses, never unpacked (this package's agros-noextract.conf): pacman.conf includes it, added at install
# and at upgrade too (machines installed before it), as the gate's. The ISO's copy of the list (agros-iso's
# agros-trim.sh puts it in the installed pacman.conf, ending "# agros-iso", for the packages installed before this one)
# taken out once the Include is in: one list after that, this package's
include_noextract() {
    local conf=$_r/etc/pacman.conf
    [[ -f $conf ]] || return 0
    if ! grep -qE '^[[:space:]]*Include[[:space:]]*=[[:space:]]*/etc/pacman\.d/agros-noextract\.conf[[:space:]]*(#.*)?$' "$conf"; then
        sed -i '/^\[options\]/a Include = /etc/pacman.d/agros-noextract.conf' "$conf"
    fi
    sed -i '/^NoExtract = .* # agros-iso$/d' "$conf"
}

# The services on, and the keyring's password changed with yours (passwd's PAM)
post_install() {
    systemctl enable bluetooth.service paccache.timer auto-update.service auto-update-install.service \
        >/dev/null 2>&1 || true
    # (the keyring's own user services masked: the one started at login, unlocked by PAM, is the one used)
    systemctl --global mask gnome-keyring-daemon.service gnome-keyring-daemon.socket >/dev/null 2>&1 || true
    if [[ -f $_r/etc/pam.d/passwd ]] && ! grep -q pam_gnome_keyring "$_r/etc/pam.d/passwd"; then
        echo '-password   optional     pam_gnome_keyring.so' >>"$_r/etc/pam.d/passwd"
    fi
    # The upstream gate's file (this package's) included by pacman.conf, added here with the file, not by the ISO's
    # pacman.conf: that one is in place before anything is installed, and pacman can't read a config including a
    # missing file (the installer's first pacman run failed, the disk already wiped). Its removal takes it out again
    local conf=$_r/etc/pacman.conf
    if [[ -f $conf ]] && ! grep -qE '^[[:space:]]*Include[[:space:]]*=[[:space:]]*/etc/pacman\.d/agros-gate\.conf[[:space:]]*(#.*)?$' "$conf"; then
        sed -i '/^\[options\]/a Include = /etc/pacman.d/agros-gate.conf' "$conf"
    fi
    include_noextract
    agros_repo
    quiet_ufw
    quiet_passim
    true # (the quiet_ steps' status isn't the scriptlet's: a note not written is tried again at the next upgrade)
}

post_upgrade() {
    include_noextract
    agros_repo
    quiet_ufw
    quiet_passim
    true # (the quiet_ steps' status isn't the scriptlet's: a note not written is tried again at the next upgrade)
}

pre_remove() {
    # (not stopped: stopping auto-update-install runs the shutdown install, inside this pacman transaction)
    systemctl disable --now auto-update.service >/dev/null 2>&1 || true
    systemctl disable auto-update-install.service >/dev/null 2>&1 || true
    systemctl --global unmask gnome-keyring-daemon.service gnome-keyring-daemon.socket >/dev/null 2>&1 || true
    sed -i '/^-password   optional     pam_gnome_keyring.so$/d' "$_r/etc/pam.d/passwd" 2>/dev/null || true
}

post_remove() {
    # (the upstream gate's file and the NoExtract list went with this package: pacman.conf's Include of each with them,
    # or pacman can't read its config at all; the approved list the gate kept, too)
    sed -i -e '\|^[[:space:]]*Include[[:space:]]*=[[:space:]]*/etc/pacman\.d/agros-gate\.conf[[:space:]]*\(#.*\)\?$|d' \
        -e '\|^[[:space:]]*Include[[:space:]]*=[[:space:]]*/etc/pacman\.d/agros-noextract\.conf[[:space:]]*\(#.*\)\?$|d' \
        "$_r/etc/pacman.conf" 2>/dev/null
    agros_repo remove
    rm -f "$_r/var/lib/agros/agros-approved" "$_r/var/lib/agros/agros-arch-ok"
    # The name from before AgrOS's back in os-release and lsb-release: the copy agros-branding kept of each (all of it,
    # PRIVACY_POLICY_URL too); made before that copy was kept, CachyOS's own script (cachyos-branding) writes CachyOS's
    local x b=$_r/usr/share/libalpm/scripts/cachyos-branding
    for x in "$_r/etc/os-release" "$_r/etc/lsb-release"; do
        grep -qE '^(DISTRIB_)?ID=agros$' "$x" 2>/dev/null || continue
        if [[ -f $x.agros-orig ]]; then
            cp "$x.agros-orig" "$x"
        elif [[ -x $b ]]; then
            "$b" "${x##*/}"
        else
            echo "agros-system: ${x#"$_r"} still names AgrOS (no copy from before it was kept): set its names back by hand"
        fi
    done
    rm -f "$_r/etc/os-release.agros-orig" "$_r/etc/lsb-release.agros-orig"
    # What it made itself: the update's package lists, notes, AUR builds and log
    rm -rf "$_r/var/lib/auto-update"
    rm -f "$_r/var/log/auto-update.log"
    # Passim unmasked, and UFW's logging back as it was where it turned it off (and it's still off: a level set since is
    # yours)
    if [[ -e $_passim_done ]]; then
        systemctl unmask passim.service >/dev/null 2>&1
        rm -f "$_passim_done"
    fi
    if [[ -f $_ufw_done ]]; then
        x=$(cat "$_ufw_done")
        grep -qx 'LOGLEVEL=off' "$_r/etc/ufw/ufw.conf" 2>/dev/null && [[ $x != off ]] && ufw logging "${x:-low}" >/dev/null 2>&1
        rm -f "$_ufw_done"
    fi
    true
}

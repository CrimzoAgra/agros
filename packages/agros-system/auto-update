#!/usr/bin/env bash
# Automatic system update: downloaded at boot, installed at shutdown with --install
# (agros-system: /usr/lib/agros/auto-update, run by auto-update.service and auto-update-install.service)
#   auto-update                   the boot's run: pacman's download, firmware's check, Flatpaks, each user's
#                                 update-kinds, then the AUR builds (auto-update-aur)
#   auto-update --install         the shutdown's: firmware the users were told of, then the packages the download got
#   auto-update --firmware-note   the firmware waiting said to the users (its own unit, started by the boot's run)
# Everything it says goes to /var/log/auto-update.log; its notes for agros-check and Updates in /var/lib/auto-update
log=/var/log/auto-update.log
# (the last 20 runs kept: every boot's download and every shutdown's pacman output are added to it. Not by the firmware
# note, which runs beside the boot's run). Written beside it and renamed over it: on a full disk, written over in place,
# the whole log was lost, when it's what says why nothing installs.
# Root's and the admins' (wheel) alone: it has every account's update output, their apps and where they are. Nothing
# run as a user reads it (agros-check reads the notes in /var/lib/auto-update, and points admins here)
private() { chgrp wheel "$1" 2>/dev/null; chmod 640 "$1"; }
if [[ ${1:-} != --firmware-note ]] && [[ -s $log ]]; then
    kept=$(awk 'function run() { return /^===== / && !/^===== done / } NR == FNR { runs += run(); next } run() { n++ } n > runs - 20' "$log" "$log") &&
        { : >"$log.new" && private "$log.new" && printf '%s\n' "$kept" >"$log.new" && mv -f "$log.new" "$log"; }
    rm -f "$log.new"
fi
# (a log made before, open to every account, closed too)
: >>"$log" && private "$log"
exec >>"$log" 2>&1
echo "===== $(date) ${1:-} ====="
# A snapshot booted from the boot menu (its root an overlay in RAM: agros-boot's snapshot-overlay or grub-btrfs's), or
# the live USB: what this downloaded or installed, its lists and notes too, would be gone at the next boot,
# the time and the download wasted. Nothing done, said
if [[ $(findmnt -no FSTYPE / 2>/dev/null) == overlay ]]; then
    echo "the system runs from a snapshot (or the live USB), its changes in RAM: nothing updated, none of it would be kept"
    exit 0
fi

# The download's own package lists (as checkupdates does): synced into pacman's own, the system would be on newer lists
# than packages all session, and installing any one package then a partial upgrade. Its lock is its own too, so pacman
# by hand and the Updates app aren't kept waiting on it
db=/var/lib/auto-update/db
mkdir -p "$db/sync"
ln -sfn /var/lib/pacman/local "$db/local"

# pacman's own lists an install replaced, kept until it's over ("installing" while it runs): an install that fails, or
# is cut off (shutdown's time limit, a power cut), must leave pacman on the lists its packages came from, not newer
# ones (a partial upgrade). restore puts them back (at the next boot for one cut off); settled drops them
au=/var/lib/auto-update
# What takes pacman's lock, and lock_holder finding one holding it (agros-scripts' pacman-lock-holder, agros-check's
# too): pacman's lists aren't changed under any of them
pacdb=/var/lib/pacman
lock_holder() { /usr/lib/agros/bin/pacman-lock-holder "$pacdb"; }
prev=$au/prev
restore() {
    local f
    for f in "$prev"/*.db; do
        [[ -e $f ]] || continue
        cp -a "$f" /var/lib/pacman/sync/
        if [[ -e $f.sig ]]; then cp -a "$f.sig" /var/lib/pacman/sync/; else rm -f "/var/lib/pacman/sync/${f##*/}.sig"; fi
        # (one this put back, older than the download it took out: the next install takes that download again)
        sha256sum <"$f" >"$au/copied/${f##*/}.sum"
    done
    settled
}
# (the AUR builds' repo list too, put there for the install alone)
settled() { rm -rf "$prev" "$au/installing" "$pacdb/sync/agros-aur.db"; }
# retire: the packages AgrOS dropped (agros-system's list: an app it replaced), removed once an update took them out
# of what AgrOS installs: only those in as a dependency that nothing needs now (one you installed yourself, or that
# something else still needs, kept). Its failing never fails the update: said, and tried again at the next install
retire() {
    local gone
    mapfile -t gone < <(pacman -Qdtq 2>/dev/null | grep -xF -f /usr/share/agros/retired 2>/dev/null)
    ((${#gone[@]})) || return 0
    echo "removing what AgrOS no longer installs: ${gone[*]}"
    SNAP_PAC_SKIP=y LC_ALL='' LC_MESSAGES=C pacman -Rns --noconfirm -- "${gone[@]}" ||
        echo "!! not removed (${gone[*]}): tried again after the next install"
}
# recover: an install cut off (shutdown's limit, a power cut), or its recovery put off: pacman's lists put back (its
# packages came from the older ones; those it got to install are taken up again by the next install), and the lock it
# left. Run at boot and before an install, each time until it's done (only with nothing holding pacman's lock)
recover() {
    [[ -e $au/installing ]] || return 0
    echo "the last install was cut off: pacman's package lists put back as they were"
    restore
    if [[ -e $pacdb/db.lck ]]; then
        echo "removing the lock it left: $pacdb/db.lck"
        rm -f "$pacdb/db.lck"
    fi
}
# held: pacman's lock there and one of its users running (not one cut off: its lock left with nothing behind it)
held() { [[ -e $pacdb/db.lck ]] && lock_holder; }
each_user=${AGROS_EACH_USER:-/usr/lib/agros/bin/agros-each-user}
# The boot's AUR builds (auto-update-aur: what they are, and how they went)
aur=$au/aur

# Firmware the boot found (fwupd: "<device id> <name> <old> <new>" per line, tab-separated, in $au/firmware) said to the
# users before the shutdown installs it: on each one's desktop (the system's one way: agros-each-user --notify-wait),
# once someone's logged in to one (up to 12 h), then marked told (firmware-told: only that is installed). Its own unit
# (systemd-run, by the boot's run), so the boot's run doesn't wait on a login
if [[ ${1:-} == --firmware-note ]]; then
    names=$(cut -f2 "$au/firmware" | paste -sd, | sed 's/,/, /g')
    # (every desktop gets it, an account that isn't an administrator too, which Updates offers no Update all)
    title="Firmware update ready" text="$names: installed when you shut down or restart (an administrator can install it now from Updates)"
    # (one the EFI partition has no room for, the shutdown found: said once, as that)
    cmp -s "$au/firmware" "$au/firmware-noroom" && title="Firmware update can't be installed" \
        text="$names: the boot partition (EFI) is too small for it. It isn't tried again until a newer one comes"
    if "$each_user" --notify-wait -a Updates -i system-software-update "$title" "$text"; then
        cp "$au/firmware" "$au/firmware-told"
        echo "firmware update said: $names"
    fi
    exit 0
fi

if [[ ${1:-} == --install ]]; then
    # How a real install went, for agros-check (this runs at shutdown: its log alone was never seen): ok, held or
    # failed, when, and why. Shutdowns with nothing installed (skip, below) counted beside it, not over it: a held or
    # failed install is still said until one replaces it. Its why plain text alone (plain): pacman's error can carry what
    # a package's install script printed, and agros-check puts it in a notification, which renders links and images
    plain() { tr -cd "A-Za-z0-9 @._+=:,;/()'-"; }
    result() { printf '%s %s %s\n' "$1" "$(date '+%F %H:%M')" "$(plain <<<"${2:-}")" >"$au/install-result"; rm -f "$au/skipped"; }
    # Said on the splash, where its theme shows messages (the plain one looked stuck for the minutes a kernel takes)
    say() { command -v plymouth >/dev/null && plymouth --ping 2>/dev/null && plymouth display-message --text="$1" 2>/dev/null; true; }
    # skip <why>: nothing installed this shutdown, counted ("<shutdowns> <since> <why>", agros-check says it 3 in a row)
    skip() {
        echo "$1: nothing installed"
        read -r skips since _ 2>/dev/null <"$au/skipped" || true
        [[ ${skips:-} =~ ^[0-9]+$ ]] || { skips=0 since=$(date +%F); }
        echo "$((skips + 1)) $since $1" >"$au/skipped"
        exit 0
    }
    # Only at a real shutdown: power off, restart, halt or kexec, their target's job queued. A soft reboot (systemctl
    # soft-reboot) stops this too, but keeps the kernel running: a kernel or driver installed under it is the mismatch
    # installing at shutdown is for. So does anything else that stops this unit: an admin's `systemctl disable --now`
    # or restart of it (the whole install then ran under the running desktop, what its ordering is there to avoid), a
    # switch to rescue or emergency mode (an hour's install under the console opened to fix something). Left for a real
    # shutdown. (systemctl's list not to be had: installed, as before it was asked)
    if queued=$(systemctl list-jobs --no-legend 2>/dev/null); then
        ! grep -q '^ *[0-9]* *soft-reboot\.target ' <<<"$queued" ||
            skip "a soft reboot (the kernel keeps running: installed at a real shutdown)"
        grep -qE '^ *[0-9]* *(poweroff|reboot|halt|kexec)\.target ' <<<"$queued" ||
            skip "not a shutdown (its unit stopped by hand, or rescue or emergency mode): installed at a real shutdown"
    fi
    # (the boot partition, wherever fstab mounts it, mounted: a kernel or boot image written with it away would go to
    # the folder under it, and the boot use the old ones). An automount's (x-systemd.automount) placeholder counts as
    # mounted too: looked into first (that mounts it), then the real one there, not autofs. Then kept open (busy) for
    # the whole install: neither unmounted for being idle nor, "nofail" (not ordered at shutdown), under it
    for m in /boot /boot/efi /efi; do
        [[ $(findmnt --fstab -n -o TARGET "$m" 2>/dev/null) == "$m" ]] || continue
        ls "$m" >/dev/null 2>&1 || true
        # shellcheck disable=SC2034  # (busy: the open folder's number, only kept open)
        { mountpoint -q "$m" && [[ $(findmnt -n -l -o FSTYPE --mountpoint "$m" 2>/dev/null | tail -1) != autofs ]] &&
            exec {busy}<"$m"; } 2>/dev/null || skip "the boot partition ($m) isn't mounted"
    done
    # The time this has: auto-update-install.service's TimeoutStopSec (60 min; shutdown's own limit, the targets'
    # JobTimeoutSec, 75), counted from this start. The packages need up to 30 min of it (a kernel's boot images)
    stop=$((60 * 60)) packages=$((30 * 60))
    # Firmware first (fwupd), only what the users were told of (auto-update --firmware-note): a flash cut off could
    # leave a device unusable, a package install cut off is taken up again at the next shutdown (the snapshot before
    # it there to go back to). fwupdtool, by itself (it stops fwupd's daemon,
    # which can't be started any more at shutdown; it finds the EFI partition through udisks2, which this unit stops
    # before); its own checks stand (on battery below its level it refuses: tried again at the next shutdown). A UEFI or
    # BIOS update is staged, applied at the next boot. --assume-yes: its questions (a device's warning) answered, never
    # waited on. Never a time limit of its own: one sent it SIGTERM mid-flash. Started only with its time and the
    # packages' both left (55 min), it has up to 30 min before the packages are put off to the next shutdown (below),
    # and the unit's own limit alone after that (a flash still writing at 60 min has hung)
    # (nor one the EFI partition had no room for: below)
    if [[ -s $au/firmware-told ]] && cmp -s "$au/firmware" "$au/firmware-told" && ! cmp -s "$au/firmware" "$au/firmware-noroom" &&
        command -v fwupdtool >/dev/null &&
        ((SECONDS <= stop - packages - 25 * 60)); then
        say "Installing firmware updates, don't turn the computer off..."
        mapfile -t ids < <(cut -f1 "$au/firmware-told")
        LC_ALL='' LC_MESSAGES=C fwupdtool update --assume-yes --no-reboot-check "${ids[@]}" </dev/null 2>&1 |
            tee "$au/firmware-out"
        fw=${PIPESTATUS[0]}
        # fwupdtool's exit says nothing of a device it skipped (it needs AC power, the battery too low) nor, in 2.1,
        # of a flash that failed: those still offer the same update after it (a UEFI one staged offers none until the
        # next boot). Its own words for why, else its last line. (2: nothing to do, installed from Updates since)
        left=
        if ((fw == 0 || fw == 2)); then
            left=$(LC_ALL='' LC_MESSAGES=C timeout 2m fwupdtool get-updates --json </dev/null 2>/dev/null |
                jq -r '.Devices[]? | select(.Releases[0]) | .DeviceId' 2>/dev/null | grep -xF -f <(printf '%s\n' "${ids[@]}"))
        fi
        if ((fw == 0 || fw == 2)) && [[ -z $left ]]; then
            echo "firmware: installed (a UEFI or BIOS update applies at the next boot)"
            rm -f "$au/firmware" "$au/firmware-told" "$au/firmware-failed" "$au/firmware-noroom"
        elif ((${#ids[@]} == 1)) && grep -q 'does not have sufficient space' "$au/firmware-out"; then
            # The EFI partition too small for it (fwupd checks before it writes anything): beside Windows, often
            # Windows' own 100 MB, nearly full. It never fits, so not tried again at every shutdown and said at every
            # login (agros-check, firmware-failed): said once, at the next boot's login, as that (--firmware-note,
            # firmware-told gone), and tried again only for a newer one (firmware-noroom: this one). Only for one
            # device alone: with others beside it, which one has no room isn't known, and another skipped for its own
            # reason (AC power) would wait with it, said as having no room. Those fail as any, until it's left alone
            echo "!! firmware: not installed, the EFI partition is too small for it"
            mv -f "$au/firmware-told" "$au/firmware-noroom"
            rm -f "$au/firmware-failed"
        else
            echo "!! firmware: not installed"
            why=$(sed -n 's/^ *‣ *//p' "$au/firmware-out" | head -1)
            printf '%s %s\n' "$(date '+%F %H:%M')" "${why:-$(grep -v '^ *$' "$au/firmware-out" | tail -1)}" >"$au/firmware-failed"
        fi
        rm -f "$au/firmware-out"
    fi
    # (the packages only with their time left: a firmware update that took long puts them off to the next shutdown)
    ((SECONDS <= stop - packages)) || skip "the firmware update took long: the packages at the next shutdown"
    # Nor on a battery nearly empty (a laptop off its charger, below 15%: a low-battery shutdown, or one it may not last
    # through): a power cut mid-install leaves packages half in, which pacman doesn't undo. Left for a shutdown on AC
    # power or with more charge (battery-low: Updates' check too)
    ! charge=$(/usr/lib/agros/bin/battery-low) || skip "on battery, nearly empty ($charge percent): at a shutdown on AC power"
    # Only what a finished download brought (its mark, "complete"): one cut off (its 2 h, a shutdown during it) has
    # lists newer than the packages it got, and installing from them would download the rest at shutdown. But for the
    # keyrings it got first (below). Said with pacman's error, where the boot wrote one down (download-failed)
    unfinished() { local e; e=$(plain 2>/dev/null <"$au/download-failed"); echo "the boot's download didn't finish${e:+ ($e)}"; }
    [[ -e $db/complete || -s $db/keyrings ]] || skip "$(unfinished)"
    # (nor while something else using pacman holds its lock: its lists would change under it)
    ! holder=$(held) || skip "something using pacman still ran ($holder)"
    # A lock left by a pacman cut off outside this (an Updates run's paru, killed by shutdown or a power cut: pacman
    # leaves it on anything but Ctrl+C), with nothing having it open now (the sessions are all stopped): stale, else
    # every install after it failed on it. Something still having it open: left, nothing installed
    if [[ -e $pacdb/db.lck && ! -e $au/installing ]]; then
        for fd in /proc/[0-9]*/fd/*; do
            [[ $(readlink "$fd" 2>/dev/null) != "$pacdb/db.lck" ]] || skip "something has pacman's lock open (${fd%/fd/*})"
        done
        echo "removing a stale lock (a pacman cut off, nothing has it open): $pacdb/db.lck"
        rm -f "$pacdb/db.lck"
    fi
    recover
    # (gone once a real install runs: one with nothing to install, or nothing held back, leaves no "held back" for
    # agros-check to keep saying)
    rm -f "$au/held"
    # The lists the download used, each with its signature (a list without its own, pacman refuses it as invalid),
    # where newer than pacman's: by the mirror's time (the download's and pacman's own sync keep it; cp -p here too),
    # or pacman's is still the one this put there (by content: copied before -p, its time was the copy's, and a list
    # downloaded the next day looked older and was skipped). Not when the Updates app synced newer ones since. The ones
    # replaced kept aside first, every one, and on disk (sync) before the first is replaced and the install marked: a
    # power cut from then on finds them whole at the next boot. One that can't be kept (a full disk): nothing replaced,
    # nothing installed (it went on, and a failed install left pacman on lists newer than its packages)
    rm -rf "$prev"
    mkdir -p "$prev" "$au/copied" || skip "pacman's package lists couldn't be kept aside (a full disk?)"
    new=()
    for f in "$db"/sync/*.db; do
        name=${f##*/}
        dst=/var/lib/pacman/sync/$name
        ! cmp -s "$f" "$dst" || continue
        [[ $f -nt $dst || $(sha256sum <"$dst" 2>/dev/null) == "$(cat "$au/copied/$name.sum" 2>/dev/null)" ]] || continue
        for x in "$dst" "$dst.sig"; do
            [[ ! -e $x ]] || cp -a "$x" "$prev/" || skip "pacman's package lists couldn't be kept aside (a full disk?)"
        done
        new+=("$f")
    done
    sync -f "$prev" "$pacdb/sync"
    touch "$au/installing"
    for f in "${new[@]}"; do
        name=${f##*/}
        dst=/var/lib/pacman/sync/$name
        cp -p "$f" "$dst"
        if [[ -e $f.sig ]]; then cp -p "$f.sig" "$dst.sig"; else rm -f "$dst.sig"; fi
        sha256sum <"$dst" >"$au/copied/$name.sum"
    done
    # (exit 1 with nothing listed is "none". Its stderr apart: a warning there isn't an update (read as one, every
    # shutdown failed); an "error:" there, or a list with a failure, is pacman's error, not "none")
    # Through the upstream gate, on the lists this installs from (the boot's, or newer ones the Updates app synced since):
    # its decision made again here, on these lists, but offline, from the approved list kept at the last fetch: no more
    # let through than was downloaded (one approved since stays held: a download of the whole set at shutdown, beside AUR
    # builds made against the old one, is what the boot's download is for). What's pending and what's installed both
    # through it
    gated=$prev/gated.conf
    waits=$(/usr/lib/agros/bin/update-gate /etc/pacman.conf "$gated" --offline) || cp /etc/pacman.conf "$gated"
    [[ -z $waits ]] || printf "waits for AgrOS's check: %s\n" "$waits"
    # The keyrings the boot downloaded first (keyrings), installed on their own before the rest, as Arch advises: the
    # rest's signatures are checked with them. Not done: said, and the rest tried with the keys as they are. Without a
    # finished download that's all, pacman's lists put back
    if [[ -s $db/keyrings ]]; then
        mapfile -t keys <"$db/keyrings"
        echo "the keyrings first: ${keys[*]}"
        say "Installing updates, don't turn the computer off..."
        if SNAP_PAC_SKIP=y LC_ALL='' LC_MESSAGES=C pacman -S --needed --noconfirm --config "$gated" -- "${keys[@]}"; then
            keyed=": the keyrings installed first, ${keys[*]}"
        else
            echo "!! the keyrings couldn't be installed first: the rest tried with the keys as they are"
        fi
    fi
    [[ -e $db/complete ]] || { restore; skip "$(unfinished)${keyed:-}"; }
    qu=0
    # (in English, as the install's below: its "error:" is looked for)
    pending=$(LC_ALL='' LC_MESSAGES=C pacman -Qu --config "$gated" 2>"$prev/qu-err") || qu=$?
    cat "$prev/qu-err"
    if grep -q '^error:' "$prev/qu-err" || { ((qu)) && [[ -n $pending ]]; }; then
        echo "$pending"
        result failed "pacman couldn't list the updates: $(grep -m1 '^error:' "$prev/qu-err" || tail -1 <<<"$pending")"
        restore
        exit 1
    fi
    # (those pacman.conf holds back, IgnorePkg's "[ignored]", left out: counted, every shutdown took a snapshot and ran
    # an install of nothing, and an ignored Qt held everything back for good. agros-scripts' updates-pending, as
    # update-apps' list)
    pending=$(/usr/lib/agros/bin/updates-pending <<<"$pending")
    # The boot's AUR builds (auto-update-aur), installed in this same transaction: each newer than what's installed, or
    # rebuilt for the new runtime this installs. Each one on its own: one whose build failed keeps its version (as paru
    # -Syu leaves it), said by agros-check. Only a new runtime (auto-update-aur's list: Qt, whose private parts the
    # shells use, so they wouldn't start at the next boot; Python's minor version, whose modules folder changes) waits
    # for what's built on it: without every one of those rebuilt for it (the build failed or didn't finish, or was for
    # other lists than these) the whole update waits (a part of it would be a partial upgrade) for the next boot's
    # builds, or Updates
    target=$(/usr/lib/agros/bin/update-kinds --runtime-target <<<"$pending")
    # (a rebuild for it missing, or that came out older than what's installed (pacman would leave it, and the runtime go
    # in without it), isn't one)
    older='' missing=''
    if [[ -n $target && -e $aur/planned && -e $aur/rebuild ]]; then
        while read -r name; do
            [[ -n $name ]] || continue
            ver=$(awk -v n="$name" '$1 == n { print $2 }' "$aur/built" 2>/dev/null)
            have=$(pacman -Q "$name" 2>/dev/null | cut -d' ' -f2)
            if [[ -z $ver ]]; then missing+=" $name"
            elif [[ -n $have ]] && (($(vercmp "$ver" "$have") < 0)); then older+=" $name"; fi
        done <"$aur/rebuild"
    fi
    if [[ -n $target ]] && ! [[ -e $aur/planned && $(cat "$aur/runtime-target" 2>/dev/null) == "$target" && -z $older$missing ]]; then
        awk -v t="$target" 'BEGIN { k = split(t, a, " "); for (i = 1; i <= k; i += 2) n[a[i]] } $1 in n' <<<"$pending" | tee "$au/held"
        why="a new $(awk '{ for (i = 1; i <= NF; i += 2) printf "%s%s", (i > 1 ? ", " : ""), $i }' <<<"$target"), and the boot's rebuild for it $(
            if [[ -n $older ]]; then echo "came out older than what's installed:$older"
            elif [[ -n $missing ]]; then echo "failed:$missing ($(paste -sd';' "$aur/failed" 2>/dev/null | sed 's/;/; /g'))"
            elif [[ -e $aur/planned ]]; then echo "was for other package lists"
            else echo "didn't finish"; fi)"
        echo "held back: $why"
        result held "$why"
        restore
        exit 0
    fi
    targets=()
    if [[ -e $aur/planned && -s $aur/built ]]; then
        while read -r name ver; do
            have=$(pacman -Q "$name" 2>/dev/null | cut -d' ' -f2)
            [[ -n $have ]] || continue
            c=$(vercmp "$ver" "$have")
            if ((c > 0)) || { ((c == 0)) && [[ -n $target ]] && grep -qxF "$name" "$aur/rebuild" 2>/dev/null; }; then
                targets+=("agros-aur/$name")
            fi
        done <"$aur/built"
    fi
    [[ ! -s $aur/failed ]] || echo "AUR apps wait, the rest installs without them (the boot's builds: $(paste -sd';' "$aur/failed" | sed 's/;/; /g'))"
    [[ -n $pending || ${#targets[@]} -gt 0 ]] || { echo "nothing to install"; result ok; settled; exit 0; }
    # safety snapshot (pick it in the boot menu if an update breaks something). --no-dbus: this runs at shutdown, when
    # snapperd (started on demand over DBus) can't be started any more, and the snapshot was silently skipped
    # Then into the boot menu's snapshot list here: what does that otherwise (grub-btrfsd) is stopped by now, and isn't
    # started at shutdown, so this one never showed there. Not installed: nothing to do
    if snapper --no-dbus -c root list >/dev/null 2>&1 &&
        snapper --no-dbus -c root create -c number -d "auto-update $(date +%F_%H%M)"; then
        if [[ -x /etc/grub.d/41_snapshots-btrfs ]]; then
            /etc/grub.d/41_snapshots-btrfs >/dev/null || echo "the boot menu's snapshot list not refreshed (grub-btrfs)"
        fi
    fi
    # Every package is here (the download finished); the network is still up all the same (ordered after it): pacman
    # hooks may use it (hyprbars' fetches its source). Its output into the log as it goes (cut off: what it got to)
    say "Installing updates, don't turn the computer off..."
    result failed "cut off before it finished"  # (until it says otherwise: shutdown's time limit, a power cut)
    # (the AUR builds' repo for this one install: pacman's config with it last, its list in pacman's own)
    conf=$gated
    if ((${#targets[@]})); then
        { cat "$conf"; printf '\n[agros-aur]\nSigLevel = Optional TrustAll\nServer = file://%s\n' "$aur/repo"; } >"$prev/pacman.conf"
        conf=$prev/pacman.conf
        cp "$aur/repo/agros-aur.db" "$pacdb/sync/agros-aur.db"
        echo "with the AUR's: ${targets[*]#agros-aur/}"
    fi
    # (SNAP_PAC_SKIP: snap-pac's own snapshots, over DBus, fail at shutdown like snapper's did; the one above covers it)
    # (its messages in English: pacman's "error:" is what the reason below is found by; translated, "erro:" or
    # "Fehler:", it was lost. Messages only: the hooks it runs keep the system's locale)
    pacman_su() { SNAP_PAC_SKIP=y LC_ALL='' LC_MESSAGES=C pacman -Su --noconfirm --config "$conf" "$@" 2>&1 | tee "$prev/out"; return "${PIPESTATUS[0]}"; }
    pacman_su "${targets[@]}"
    rc=$?
    # AUR apps pacman can't install (a conflict, a file conflict, a dependency missing): it refuses the whole
    # transaction, at every shutdown, and the system was never updated. Tried again without them (pacman installs
    # nothing of a transaction it refuses), but for those a new runtime in it needs (installed with it or not at all),
    # their version kept. Once that goes through, the AUR apps left out are written down for agros-check ("<when>
    # <pacman's error>", then "<name> <version>" each), until an install of them goes through
    if ((rc && ${#targets[@]})); then
        keep=() drop=()
        for x in "${targets[@]}"; do
            if [[ -n $target ]] && grep -qxF "${x#agros-aur/}" "$aur/rebuild" 2>/dev/null; then keep+=("$x"); else drop+=("${x#agros-aur/}"); fi
        done
        if ((${#drop[@]})); then
            why=$(grep -m1 '^error:' "$prev/out" | plain)
            echo "!! the AUR apps couldn't be installed (${drop[*]}): tried again without them"
            # (--ignore: -Su would take them from agros-aur too, newer than what's installed)
            pacman_su --ignore "$(IFS=,; echo "${drop[*]}")" "${keep[@]}"
            rc=$?
            ((rc)) || { echo "$(date '+%F %H:%M') $why"; for x in "${drop[@]}"; do grep "^$x " "$aur/built"; done; } >"$au/aur-install-failed"
        fi
    elif ((!rc && ${#targets[@]})); then
        rm -f "$au/aur-install-failed"
    fi
    if ((rc)); then
        echo "!! the install failed: pacman's package lists put back as they were"
        result failed "$(grep -m1 '^error:' "$prev/out")"
        say "The update failed: it's tried again at the next shutdown"
        restore
        exit 1
    fi
    result ok
    # (the Qt the shells were rebuilt for, or needed no rebuild for: Updates' update-apps doesn't rebuild them again)
    [[ $target != *qt6-* ]] || /usr/lib/agros/bin/update-kinds --qt-now >"$au/qt-built"
    settled
    retire
    echo "===== done $(date) ====="
    exit
fi

# (downloading: from now to the end of the download below, pacman's cache is written; Updates' update-apps waits
# while it's there, so both never write the same package into it at once. Made first thing: an Updates run started
# meanwhile doesn't slip in before the download. auto-update-aur marks its own download the same)
touch "$au/downloading"
# The last shutdown's install cut off before it finished: recovered now, or (something using pacman holding its lock)
# at the next install or boot
if [[ -e $au/installing ]] && holder=$(held); then
    echo "the last install was cut off, but something using pacman runs ($holder): recovered later"
else
    recover
fi

# wait for the network (at most ~2 min; what fails without it is said below)
/usr/lib/agros/bin/wait-online https://archlinux.org

# The day AgrOS's checks last passed on Arch (agros-arch-ok, which its CI publishes beside the [agros] repo; Hyprland's
# updates wait while they fail), kept for agros-check, which says so after login when it's over 10 days old. Each of
# [agros]'s servers in turn; none answering, the copy kept as it is (its file's time: when it was fetched). Taken only
# with a good signature by AgrOS's key beside it (agros-arch-ok.sig, checked with gpgv against agros-keyring's key
# alone, as update-gate takes its list): none, or a bad one (a mirror or a network in between that changed it, to hide
# that the checks stopped passing), and that server counts as not answering, said
archok=/var/lib/agros/agros-arch-ok
keyring=/usr/share/pacman/keyrings/agros.gpg
mkdir -p "${archok%/*}"
while read -r server; do
    curl -fsS --connect-timeout 10 -m 30 -o "$archok.new" "$server/agros-arch-ok" 2>/dev/null || continue
    day=$(head -c 100 "$archok.new" 2>/dev/null)
    [[ $day =~ ^[0-9]{4}/[0-9]{2}/[0-9]{2}$ ]] || continue
    if ! curl -fsS --connect-timeout 10 -m 30 -o "$archok.new.sig" "$server/agros-arch-ok.sig" 2>/dev/null ||
        ! gpgv --keyring "$keyring" "$archok.new.sig" "$archok.new" >/dev/null 2>&1; then
        echo "agros-arch-ok has no good signature by AgrOS's key ($server/agros-arch-ok.sig): not taken"
        continue
    fi
    echo "$day" >"$archok.new" && chmod 644 "$archok.new" && mv -f "$archok.new" "$archok"
    break
done < <(pacman-conf --repo agros Server 2>/dev/null)
rm -f "$archok.new" "$archok.new.sig"

# system and CachyOS gaming packages, the NVIDIA driver too: downloaded now, installed at shutdown (only once this
# finished: its mark, complete).
# A lock a download cut off left (shutdown stopped it mid-way) taken out first, only with nothing on these lists that
# may hold it running (pacman-lock-holder); else every boot's download failed on it (agros-check says when one is left)
if [[ -e $db/db.lck ]] && ! /usr/lib/agros/bin/pacman-lock-holder "$db" >/dev/null; then
    echo "removing a stale lock: $db/db.lck"
    rm -f "$db/db.lck"
fi
# (the AUR builds made for the last download's lists with it: made again for this one's, below)
rm -rf "$db/complete" "$db/keyrings" "$au/download-failed" "$aur"
# Through the upstream gate (update-gate): Hyprland and its libraries only to versions AgrOS's CI has checked, else
# held (a library whose update would break one held, with it). The pacman.conf it gives for the download and the AUR
# builds for it (the shutdown decides again, on the lists it installs from)
gated=$au/pacman.conf
# (pacman's errors kept apart, then added to the log: the first written down when the download didn't finish
# (download-failed), for the shutdown's note that agros-check says: an expired key, a dependency that can't be had.
# In English: "error:" is what's looked for)
err=$au/download-err
if LC_ALL='' LC_MESSAGES=C pacman -Sy --noconfirm --dbpath "$db" --logfile /dev/null 2>"$err"; then
    # (it failing: pacman.conf as it is, the gate's Include in it, as the shutdown and Updates do; not the last boot's
    # copy, made for older lists, which let a newer Hyprland, not checked yet, through)
    waits=$(/usr/lib/agros/bin/update-gate /etc/pacman.conf "$gated" --dbpath "$db") || cp /etc/pacman.conf "$gated"
    [[ -z $waits ]] || printf "waits for AgrOS's check: %s\n" "$waits"
    # The keyrings first, on their own, where these lists have a newer one (none pacman.conf holds back): a package
    # signed by a key the keyring here doesn't have yet, or has expired (CachyOS's users, an Arch packager's, 2026-11),
    # fails the whole download's check, and so every shutdown's install. Downloaded alone (their own signatures
    # checked), they're installed first at shutdown, as Arch advises, even when the rest didn't download: the next
    # boot's download is checked with the new keys (keyrings: their names, once downloaded)
    mapfile -t keys < <(LC_ALL=C pacman -Qu --config "$gated" --dbpath "$db" 2>/dev/null | /usr/lib/agros/bin/updates-pending |
        awk '$1 ~ /^(archlinux|cachyos|agros)-keyring$/ { print $1 }')
    if ((${#keys[@]})) &&
        LC_ALL='' LC_MESSAGES=C pacman -Sw --noconfirm --config "$gated" --dbpath "$db" --logfile /dev/null -- "${keys[@]}" 2>>"$err"; then
        printf '%s\n' "${keys[@]}" >"$db/keyrings"
    fi
    LC_ALL='' LC_MESSAGES=C pacman -Suw --noconfirm --config "$gated" --dbpath "$db" --logfile /dev/null 2>>"$err" &&
        touch "$db/complete"
else
    cp /etc/pacman.conf "$gated"
fi
cat "$err"
[[ -e $db/complete ]] || grep -m1 '^error:' "$err" >"$au/download-failed" || rm -f "$au/download-failed"
rm -f "$err" "$au/downloading"

# Firmware (fwupd): its list of updates refreshed (LVFS's metadata, signed and checked by fwupd) and looked at; any
# waiting said to the users (--firmware-note, in a unit of its own: it waits for a login) and installed at shutdown.
# Offline or nothing waiting: nothing said
if command -v fwupdmgr >/dev/null; then
    timeout 5m fwupdmgr refresh >/dev/null 2>&1
    fw=$(timeout 2m fwupdmgr get-updates --json --no-unreported-check --no-metadata-check 2>/dev/null |
        jq -r '.Devices[]? | select(.Releases[0]) | [.DeviceId, .Name, .Version, .Releases[0].Version] | @tsv' 2>/dev/null)
    if [[ -n $fw ]]; then
        printf '%s\n' "$fw" >"$au/firmware"
        echo "firmware ready, installed at shutdown: $(cut -f2 "$au/firmware" | paste -sd,)"
        cmp -s "$au/firmware" "$au/firmware-told" ||
            systemd-run --quiet --collect --unit=agros-firmware-note /usr/lib/agros/auto-update --firmware-note
    else
        rm -f "$au/firmware" "$au/firmware-told" "$au/firmware-failed" "$au/firmware-noroom"
    fi
fi

# flatpak apps: the system-wide ones, then each user's (Spotify: user-installed so spicetify can change it) and those
# installed from a downloaded file (Nuvio, ArtCraft), as that user; then their AppImages, Capri's check, Proton builds
# and developer tools (update-kinds, as Updates runs them)
# (each given up on after half an hour: a stalled one held shutdown off for as long as it hung)
# Root's apps from a file (system-wide, and root's own) first have their -origin remote's URL emptied
# (flatpak-bundle-update --no-origin-urls): flatpak update, as root, took one from the URL its file named, past that
# script's checks. Not emptied: not updated
if command -v flatpak >/dev/null; then
    if /usr/lib/agros/bin/flatpak-bundle-update --no-origin-urls system user; then
        timeout 30m flatpak update -y --noninteractive
    else
        echo "!! Flatpaks not updated: an app installed from a file kept the URL its file named"
    fi
fi
# Flatpaks installed from a file (bundles [runner...]: the system-wide ones as root, once; each user's own as them,
# below): downloaded first (nothing held), then reinstalled (old one out first) with sleep and power off held for that
# step alone: by root, here (logind refuses a user that hold outside a session). Usually seconds; a runtime the new
# version needs is downloaded in it too, so given up on after half an hour. Not with less than 35 min of the run's 4 h
# left (auto-update.service's RuntimeMaxSec): cut off between the old one's removal and the new one's install, the app
# would be gone (the next boot does it)
bundles() {
    local fetched
    command -v flatpak >/dev/null && [[ -x /usr/lib/agros/bin/flatpak-bundle-update ]] || return 0
    # (on disk, /var/tmp: the file and the repo it's read into, about twice the app's size, in /tmp took memory)
    fetched=$("$@" mktemp -d -p /var/tmp agros-flatpak.XXXXXX) || return 0
    "$@" /usr/lib/agros/bin/flatpak-bundle-update --fetch "$fetched"
    if [[ -s $fetched/fetched ]] && ((SECONDS > 4 * 3600 - 35 * 60)); then
        echo "Flatpaks from a file: too little of the run's time left to reinstall them, at the next boot"
    elif [[ -s $fetched/fetched ]]; then
        timeout 30m systemd-inhibit --what=sleep:shutdown --mode=block --who="Flatpak update" \
            --why="Reinstalling apps from their files" "$@" /usr/lib/agros/bin/flatpak-bundle-update --install-fetched "$fetched"
    fi
    # (removed by whoever made it: never root's rm in a folder a user owns)
    "$@" rm -rf -- "$fetched"
}
bundles
# The AgrOS users (agros-each-user's list): accounts with a home, each one's own apps, as that user (agros-each-user
# --as: setpriv, no PAM, so no logind session: they'd count as logged in, and leave this unit's time limit)
# (the list read whole first: a command in the loop, a user's own programs, can't read the next users away)
mapfile -t users < <("$each_user" --list)
for user in "${users[@]}"; do
    uid=$(id -u "$user")
    echo "-- $user"
    # (what it has to say (a new Proton: restart Steam, pick it in Lutris) handed back on fd 3, a file of root's, and
    # said on that user's desktop once they're logged in: agros-each-user --notify. A few lines at most)
    notes=$(mktemp)
    "$each_user" --as "$user" --fd 3 \
        env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        /usr/lib/agros/bin/update-kinds --boot flatpak appimage capri proton dev 3>"$notes"
    head -n 5 "$notes" | while IFS=$'\t' read -r icon title text; do
        [[ -n $title ]] && "$each_user" --notify --user "$user" -a Updates -i "$icon" "$title" "$text"
    done
    rm -f "$notes"
    bundles "$each_user" --as "$user"
done

# The AUR's apps last (the longest: builds), for this download's lists, as their own account, agros-aur, no user's
# (auto-update-aur); installed at shutdown with the rest
[[ -e $db/complete ]] && AGROS_PACMAN_CONF=$gated /usr/lib/agros/auto-update-aur "$db"
rm -f "$au/downloading"

echo "===== done $(date) ====="

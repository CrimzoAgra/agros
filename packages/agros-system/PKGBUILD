# Maintainer: Filipe Agra
# AgrOS's system parts: the update at every boot (downloaded and AUR apps built at boot, installed at shutdown, firmware too), pacman's hooks that keep
# each user's Caelestia overlay, hyprbars and Hyprland config check in step with updates, Bluetooth and the screens back on after sleep,
# the desktop shell at normal CPU priority, the keyring unlocked with the login password, a VMware VM's screen
# following its window, the night light's location (geoclue), the automatic time zone without a password (polkit),
# Hyprland's updates held until AgrOS's CI has checked them (the upstream gate), folder icons in the colour scheme's colour (papirus-folders, sudoers), mDNS from Avahi alone, UFW's logging off,
# File Roller's first window wide enough for its file names
pkgname=agros-system
pkgver=0
pkgrel=1
pkgdesc='AgrOS system parts: boot-time updates, per-user pacman hooks, Bluetooth resume, ananicy rule, keyring'
arch=('any')
url='https://github.com/CrimzoAgra/agros'
license=('GPL-3.0-or-later')
# (fwupd: firmware updates; base-devel and bubblewrap: the boot's AUR builds, in a sandbox, as an account of their own
# (agros-aur, sysusers.d); passt: that sandbox's own network, pasta; iproute2 and jq: the host's addresses closed off in it;
# btrfs-progs: a btrfs over several partitions listed once by udisks, agros-btrfs-member)
depends=('agros-scripts' 'pacman-contrib' 'bluez' 'bluez-utils' 'gnome-keyring' 'libsecret' 'sudo' 'curl' 'flatpak'
         'iproute2' 'fwupd' 'base-devel' 'bubblewrap' 'passt' 'git' 'jq' 'btrfs-progs')
optdepends=('snapper: a snapshot before each update' 'ananicy-cpp: the shell rule')
install=agros-system.install
# (settings of /etc yours to change: an edited one kept at upgrade, AgrOS's new one beside it as .pacnew. Not the gate,
# the NoExtract list or the sudoers rule: those reach every machine as they are)
backup=('etc/vmware-tools/tools.conf' 'etc/geoclue/conf.d/90-agros.conf' 'etc/ananicy.d/99-agros/agros.rules')
_root=$(realpath "${startdir}/../..")

pkgver() {
    cd "$_root" && printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    cd "$startdir"
    install -Dm755 -t "$pkgdir/usr/lib/agros" auto-update auto-update-aur aur-agros-patch
    install -Dm644 -t "$pkgdir/usr/lib/agros/aur-patches" aur-patches/*.patch
    install -Dm644 agros-aur.sysusers "$pkgdir/usr/lib/sysusers.d/agros-aur.conf"
    install -Dm644 -t "$pkgdir/usr/lib/systemd/system" auto-update.service auto-update-install.service
    local t
    for t in poweroff reboot halt kexec; do
        install -Dm644 auto-update-timeout.conf "$pkgdir/usr/lib/systemd/system/$t.target.d/agros-auto-update.conf"
    done
    install -Dm644 -t "$pkgdir/usr/share/libalpm/hooks" 00-agros-links.hook agros-*.hook zz-agros-os-release.hook
    install -Dm755 agros-branding "$pkgdir/usr/share/libalpm/scripts/agros-branding"
    install -Dm644 vmware-tools.conf "$pkgdir/etc/vmware-tools/tools.conf"
    # (the upstream gate: pacman.conf includes it; not a backup file, so a changed list reaches every machine)
    install -Dm644 agros-gate.conf "$pkgdir/etc/pacman.d/agros-gate.conf"
    # (the files no one uses, never unpacked: pacman.conf includes it, the same way)
    install -Dm644 agros-noextract.conf "$pkgdir/etc/pacman.d/agros-noextract.conf"
    # (the packages AgrOS dropped: removed after an update where nothing needs them, auto-update's and update-apps')
    install -Dm644 agros-retired "$pkgdir/usr/share/agros/retired"
    install -Dm755 "$_root/system/bluetooth-resume" "$pkgdir/usr/lib/systemd/system-sleep/agros-bluetooth-resume"
    install -Dm755 "$_root/system/screens-resume" "$pkgdir/usr/lib/systemd/system-sleep/agros-screens-resume"
    install -Dm644 "$_root/system/ananicy/dotfiles.rules" "$pkgdir/etc/ananicy.d/99-agros/agros.rules"
    install -Dm644 "$_root/system/geoclue/agros.conf" "$pkgdir/etc/geoclue/conf.d/90-agros.conf"
    install -Dm644 "$_root/system/polkit/agros-timezone.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-agros-timezone.rules"
    install -Dm644 "$_root/system/polkit/agros-drives.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-agros-drives.rules"
    install -dm750 "$pkgdir/etc/sudoers.d"  # (as sudo has it: 755 made pacman warn at every install)
    install -Dm440 "$_root/system/sudoers/agros-papirus-folders" "$pkgdir/etc/sudoers.d/50-agros-papirus-folders"
    install -Dm644 "$_root/system/resolved/agros.conf" "$pkgdir/usr/lib/systemd/resolved.conf.d/50-agros.conf"
    install -Dm644 "$_root/system/udev/90-agros-btrfs-members.rules" "$pkgdir/usr/lib/udev/rules.d/90-agros-btrfs-members.rules"
    install -Dm755 "$_root/system/udev/agros-btrfs-member" "$pkgdir/usr/lib/udev/agros-btrfs-member"
    # File Roller's first window: its own 600x480 leaves its file names about 50 px (glib2's pacman hook compiles it in)
    install -Dm644 "$_root/system/file-roller/50-agros-file-roller.gschema.override" \
        "$pkgdir/usr/share/glib-2.0/schemas/50-agros-file-roller.gschema.override"
}

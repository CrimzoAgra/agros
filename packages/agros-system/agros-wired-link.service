[Unit]
Description=Wired links that keep dropping stepped down (EEE off, then 1 Gbps)
After=NetworkManager.service
# (a VM's card is the host's to fix: vmxnet3 says 10 Gbps, and a 1 Gbps cap would take it down)
ConditionVirtualization=!vm

[Service]
ExecStart=/usr/lib/agros/wired-link-watch
Restart=always
RestartSec=5
StateDirectory=agros/wired-link

[Install]
WantedBy=multi-user.target

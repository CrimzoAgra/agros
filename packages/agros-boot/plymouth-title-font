#!/bin/bash
# Fonts for the splash's shutdown and restart titles (agros-boot): Plymouth draws text only in Plymouth.ttf and
# Plymouth-bold.ttf, and its own hook copies fonts under their real names only. An mkinitcpio install hook
# (/usr/lib/initcpio/install/plymouth-title-font), in the shutdown's image: agros-boot.tmpfiles adds it to
# mkinitcpio-shutdown.conf's HOOKS
build() {
  local f
  for f in /usr/share/fonts/Plymouth.ttf /usr/share/fonts/Plymouth-bold.ttf; do
    [[ -e $f ]] && add_file "$(readlink -f "$f")" "$f"
  done
}

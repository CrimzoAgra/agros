# agros-boot: GRUB's "Loading Linux..." lines out of its script again after each GRUB update (its package puts them
# back); the menu has them gone the next time it's made (grub-mkconfig: grub ships no pacman hook that makes it)
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = grub

[Action]
Description = Hiding GRUB loading messages (agros-boot)...
When = PostTransaction
Exec = /usr/lib/agros/boot-menu --grub-quiet

# Maintainer: Filipe Agra
# A faster, cleaner boot: the boot menu hidden (Esc shows it; Windows and snapshots listed), the CachyOS splash without
# its closing animation (and with shutdown/restart titles), no text at boot or shutdown behind it, the console in each
# screen's best mode from boot, a snapshot booted from the menu writable in RAM
pkgname=agros-boot
pkgver=0
pkgrel=1
pkgdesc='AgrOS boot: hidden boot menu, faster splash, screens in their best mode from boot'
arch=('any')
url='https://github.com/CrimzoAgra/agros'
license=('GPL-3.0-or-later')
# (CachyOS's splash themes, splash-theme's source: CachyOS's installer installed them with its base packages until its
# cachyos branch, which leaves the splash to a package-list group AgrOS's list doesn't take)
depends=('plymouth' 'cachyos-plymouth-bootanimation' 'cachyos-plymouth-theme' 'noto-fonts' 'os-prober' 'ntfs-3g' 'v4l-utils' 'python' 'efibootmgr' 'mkinitcpio')
optdepends=('snapper: snapshots before updates, listed in the boot menu'
            'snap-pac: snapshots around pacman transactions'
            'grub-btrfs: snapshots in the GRUB menu')
install=agros-boot.install
backup=('etc/mkinitcpio.conf.d/90-agros-plymouth.conf' 'etc/mkinitcpio.conf.d/91-agros-snapshot-overlay.conf')
_root=$(realpath "${startdir}/../..")
# What it's made from (package() below): its version counts only the commits that touch these, not every AgrOS commit, as
# each new version makes every boot image again (it ships a file mkinitcpio's pacman hook watches, usr/lib/initcpio/*).
# "1." keeps it above the r<count of every commit> published before
_inputs=(packages/agros-boot system/boot-video-mode .local/share/caelestia-greeter/screenmode.py)

pkgver() {
    cd "$_root" && printf '1.r%s.%s' "$(git rev-list --count HEAD -- "${_inputs[@]}")" "$(git log -1 --format=%h -- "${_inputs[@]}")"
}

package() {
    cd "$startdir"
    install -Dm755 boot-menu "$pkgdir/usr/lib/agros/boot-menu"
    install -Dm755 splash-theme "$pkgdir/usr/lib/agros/splash-theme"
    install -Dm755 boot-loader "$pkgdir/usr/lib/agros/boot-loader"
    install -Dm755 "$_root/system/boot-video-mode" "$pkgdir/usr/lib/agros/boot-video-mode/boot-video-mode"
    install -Dm644 "$_root/.local/share/caelestia-greeter/screenmode.py" "$pkgdir/usr/lib/agros/boot-video-mode/screenmode.py"
    install -Dm644 boot-video-mode.service "$pkgdir/usr/lib/systemd/system/boot-video-mode.service"
    install -Dm644 -t "$pkgdir/usr/share/libalpm/hooks" agros-grub-quiet.hook agros-splash.hook
    install -Dm644 plymouth-title-font "$pkgdir/usr/lib/initcpio/install/plymouth-title-font"
    install -Dm644 mkinitcpio-plymouth.conf "$pkgdir/etc/mkinitcpio.conf.d/90-agros-plymouth.conf"
    # (a snapshot booted from the boot menu made writable in RAM: a systemd boot image's hook, its script and unit put
    # in the image by it, and the drop-in that adds it where no such hook is there)
    install -Dm644 snapshot-overlay-hook "$pkgdir/usr/lib/initcpio/install/agros-snapshot-overlay"
    install -Dm755 snapshot-overlay "$pkgdir/usr/lib/agros/snapshot-overlay"
    install -Dm644 snapshot-overlay.service "$pkgdir/usr/lib/agros/snapshot-overlay.service"
    install -Dm644 mkinitcpio-snapshot-overlay.conf "$pkgdir/etc/mkinitcpio.conf.d/91-agros-snapshot-overlay.conf"
    # (the boots after an update counted, the system from before it brought back when they fail: GRUB's menu script,
    # the watch at each boot, and boot-rollback, put in the boot image by the hook above)
    install -Dm755 grub-agros-trial "$pkgdir/etc/grub.d/01_agros-trial"
    install -Dm755 -t "$pkgdir/usr/lib/agros" boot-trial boot-rollback
    install -Dm644 boot-rollback.service "$pkgdir/usr/lib/agros/boot-rollback.service"
    install -Dm644 boot-trial.service "$pkgdir/usr/lib/systemd/system/agros-boot-trial.service"
    install -Dm644 agros-boot.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/agros-boot.conf"
    # AgrOS's GRUB theme (boot-menu sets it); make.sh, which made its pictures and fonts, isn't installed
    install -Dm644 -t "$pkgdir/usr/share/grub/themes/agros" grub-theme/theme.txt grub-theme/*.png grub-theme/*.pf2
    install -Dm644 -t "$pkgdir/usr/share/grub/themes/agros/icons" grub-theme/icons/*.png
    install -d "$pkgdir/usr/share/fonts"
    ln -s noto/NotoSans-Medium.ttf "$pkgdir/usr/share/fonts/Plymouth.ttf"
    ln -s noto/NotoSans-Bold.ttf "$pkgdir/usr/share/fonts/Plymouth-bold.ttf"
}

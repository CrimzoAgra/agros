#!/usr/bin/env bash
# Whether GRUB is set up here (exit 0; else 1), decided here alone for boot-menu, boot-video-mode and agros-boot's
# install (agros-boot: /usr/lib/agros/boot-loader): its settings and grub-mkconfig are there.
# (AGROS_ROOT: another root, the tests' throwaway one)
r=${AGROS_ROOT:-}
[[ -f $r/etc/default/grub ]] && command -v grub-mkconfig >/dev/null

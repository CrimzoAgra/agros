#!/bin/bash
# boot-rollback: in the boot image, before the root is mounted (agros-boot-rollback.service, put in by the hook
# agros-snapshot-overlay), the snapshot GRUB booted for a failed update (01_agros-trial, agros.rollback=<its path from
# the filesystem's top>) made the system: a writable copy of it in place of the root subvolume (rootflags' subvol=, e.g.
# @), the root's own subvolumes (/.snapshots, /var/lib/machines...: a snapshot leaves an empty folder for each) moved
# into it, the root kept beside as <root>.agros-broken-<time>. Then the boot goes on
# into it. Each step undone if a later one fails: the root as it was, booted as it was. What it did written in the new
# root's /var/lib/auto-update/rolled-back ("<date> <time> <snapshot> <boot id> <rollbacks in a row>"), for boot-trial
# and agros-check, and the update's hold (auto-update)
# (BOOT_ROLLBACK_CMDLINE, BOOT_ROLLBACK_TOP: the tests', the filesystem's top already there, nothing mounted)
cmdline=$(cat "${BOOT_ROLLBACK_CMDLINE:-/proc/cmdline}")
word() { tr ' ' '\n' <<<"$cmdline" | sed -n "s/^$1=//p" | tail -1; }
snap=$(word agros.rollback) uuid=$(word root) flags=$(word rootflags) dev=
[[ -n $snap ]] || exit 0
say() { echo "boot-rollback: $*"; }
# (the root's device: root=UUID=<uuid>, as GRUB writes it, or a device's path)
case $uuid in UUID=*) dev=/dev/disk/by-uuid/${uuid#UUID=} ;; *) dev=$uuid ;; esac
root=$(tr ',' '\n' <<<"$flags" | sed -n 's/^subvol=//p' | tail -1) root=${root#/}
[[ -n $root && $snap != "$root" && $snap != */../* ]] || { say "no root subvolume to bring $snap back over"; exit 0; }
top=${BOOT_ROLLBACK_TOP:-/run/agros-top}
if [[ -z ${BOOT_ROLLBACK_TOP:-} ]]; then
    mkdir -p "$top" && mount -t btrfs -o subvolid=5 "$dev" "$top" ||
        { say "the filesystem couldn't be mounted: booted as it was"; exit 0; }
    trap 'umount "$top"' EXIT
fi
[[ -d $top/$snap && -d $top/$root ]] || { say "$snap or $root not there: booted as it was"; exit 0; }
# shortcut: the old roots kept beside (<root>.agros-broken-<time>) are never taken out, one a rollback; delete them by
# hand (btrfs subvolume delete) if rollbacks ever become common
stamp=$(date +%Y%m%d-%H%M%S)
new=$top/$root.agros-new broken=$top/$root.agros-broken-$stamp
# (a copy left by a try cut off)
[[ ! -e $new ]] || btrfs subvolume delete "$new" >/dev/null || { say "$new left from before can't be removed"; exit 0; }
btrfs subvolume snapshot "$top/$snap" "$new" >/dev/null || { say "the snapshot couldn't be copied: booted as it was"; exit 0; }
moved=()
undo() {
    local m
    for m in "${moved[@]}"; do mv "$new/$m" "$top/$root/$m" && mkdir -p "$new/$m"; done
    btrfs subvolume delete "$new" >/dev/null
    say "$1: booted as it was"
    exit 0
}
# The root's own subvolumes (the direct ones: btrfs-progs' path from the top, "<FS_TREE>/" before it in some versions;
# one with a space in its path can't be told apart: Snapper and systemd make none)
while read -r sub; do
    sub=${sub#"<FS_TREE>/"} rel=${sub#"$root"/}
    [[ $rel != "$sub" && -n $rel ]] || continue
    # (the snapshot's empty folder for it; none, or not empty: left in the old root, but /.snapshots must come)
    if [[ -d $new/$rel ]] && rmdir "$new/$rel" 2>/dev/null; then
        mv "$top/$root/$rel" "$new/$rel" || undo "$rel couldn't be moved"
        moved+=("$rel")
    elif [[ $rel == .snapshots ]]; then
        undo "the snapshots couldn't be moved"
    fi
done < <(btrfs subvolume list -o "$top/$root" 2>/dev/null | awk '{print $NF}')
# (the snapshots still in the root, never listed: btrfs-progs printing its paths otherwise. Not swapped without them)
[[ " ${moved[*]} " == *" .snapshots "* || ! -d $top/$root/.snapshots ]] || undo "the snapshots weren't found to move"
mv "$top/$root" "$broken" || undo "the root couldn't be moved aside"
mv "$new" "$top/$root" || { mv "$broken" "$top/$root"; undo "the snapshot couldn't take the root's place"; }
au=$top/$root/var/lib/auto-update
mkdir -p "$au"
# (one brought back before, the update after it never confirmed: the snapshot's own note, counted on)
count=$(awk '{print $5}' "$au/rolled-back" 2>/dev/null)
echo "$(date '+%F %H:%M') $snap $(cat /proc/sys/kernel/random/boot_id) $((${count:-0} + 1))" >"$au/rolled-back"
say "$snap is the system now; the root before it kept as ${broken#"$top"/}"
exit 0

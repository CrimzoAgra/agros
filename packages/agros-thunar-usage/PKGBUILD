# Maintainer: Filipe Agra
# Thunar: a bar in the status bar, beside the free space, showing how full the folder's drive is (each window its own
# drive), and "Set as wallpaper" on a picture, through Caelestia. Two Thunar plugins (thunar-usage.c,
# thunar-wallpaper.c), loaded into Thunar
pkgname=agros-thunar-usage
# (its version from the commits that touch it, as agros-vmware's: compiled, so CI can't tell a change from a rebuild)
pkgver=0
pkgrel=1
pkgdesc="AgrOS: a disk usage bar in Thunar's status bar, and Set as wallpaper through Caelestia"
arch=('x86_64')
url='https://github.com/CrimzoAgra/agros'
license=('GPL-3.0-or-later')
depends=('thunar' 'caelestia-cli')
source=('thunar-usage.c' 'thunar-wallpaper.c')
sha256sums=('SKIP' 'SKIP')

pkgver() {
    cd "$startdir" && printf '1.r%s.%s' "$(git rev-list --count HEAD -- .)" "$(git log -1 --format=%h -- .)"
}

build() {
    # shellcheck disable=SC2046  # (pkg-config's flags, split into words on purpose)
    gcc $CFLAGS $LDFLAGS -shared -fPIC -Wl,-z,defs -o agros-thunar-usage.so thunar-usage.c \
        $(pkg-config --cflags --libs thunarx-3)
    # shellcheck disable=SC2046
    gcc $CFLAGS $LDFLAGS -shared -fPIC -Wl,-z,defs -o agros-thunar-wallpaper.so thunar-wallpaper.c \
        $(pkg-config --cflags --libs thunarx-3)
}

package() {
    install -Dm755 -t "$pkgdir/usr/lib/thunarx-3" agros-thunar-usage.so agros-thunar-wallpaper.so
}

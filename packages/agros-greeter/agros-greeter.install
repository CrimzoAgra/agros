# greetd pointed at the login screen (its own config kept as config.toml.agros-orig), its PAM service made from the
# system's (greetd-pam, the keyring's lines from its template), the user it shows by default, and greetd on
# (AGROS_ROOT: another root, the tests' throwaway one; / when pacman runs this)
_r=${AGROS_ROOT:-}
_dm=$_r/var/lib/agros/display-manager
# (at install and each upgrade: one it can't follow said both times; the keyring named only when the file left there
# hasn't its lines, as one an earlier run made has)
_pam() {
    local why=
    "$_r/etc/greetd/caelestia-greeter/greetd-pam" >/dev/null 2>&1 && return
    grep -qs pam_gnome_keyring "$_r/etc/pam.d/greetd" || why=": the passwords keyring isn't unlocked at login"
    echo "agros-greeter: greetd's PAM service left as it was (greetd-pam couldn't follow the system's$why)"
}

post_install() {
    local g=$_r/etc/greetd/caelestia-greeter cfg=$_r/etc/greetd/config.toml u
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/agros-greeter.conf >/dev/null 2>&1 || true
    [[ -f $cfg && ! -f $cfg.agros-orig ]] && cp "$cfg" "$cfg.agros-orig"
    install -m644 "$g/greetd-config.toml" "$cfg"
    _pam
    # Who it shows should its theme break: the first account (the one made in the installer; agros-each-user's list of
    # the AgrOS users), until someone logs in. Its theme made as them through agros-each-user --as (setpriv: runuser's
    # PAM opened a logind session for them)
    u=$("$_r/usr/lib/agros/bin/agros-each-user" --list | head -1)
    if [[ -n $u ]] && ! grep -q '^CAELESTIA_GREETER_USER=' "$g/env"; then
        echo "CAELESTIA_GREETER_USER=$u" >>"$g/env"
        [[ -e $g/theme/theme.json ]] || "$_r/usr/lib/agros/bin/agros-each-user" --as "$u" "$g/make-theme.sh" "$g/theme" "$u" >/dev/null 2>&1 || true
    fi
    # (the display manager it takes over from, noted once: its removal turns that one back on)
    local dm
    dm=$(readlink "$_r/etc/systemd/system/display-manager.service" 2>/dev/null) && dm=${dm##*/}
    [[ -n $dm && $dm != greetd.service && ! -e $_dm ]] &&
        mkdir -p "${_dm%/*}" && echo "$dm" >"$_dm"
    systemctl enable -f greetd.service >/dev/null 2>&1 || true
}

post_upgrade() {
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/agros-greeter.conf >/dev/null 2>&1 || true
    _pam
    true
}

post_remove() {
    local cfg=$_r/etc/greetd/config.toml pam=$_r/etc/pam.d/greetd dm
    # greetd's own config back. None kept (there was none to keep): greetd's stock one written, its text login, rather
    # than one pointing at a file just removed with this package (greetd then shows nothing at all): the login screen
    # (/etc/greetd/caelestia-greeter), or login-reset's text login into hyprland-session
    if [[ -f $cfg.agros-orig ]]; then
        mv "$cfg.agros-orig" "$cfg"
    elif grep -qE 'caelestia-greeter|hyprland-session|login-reset' "$cfg" 2>/dev/null; then
        printf '%s\n' '[terminal]' 'vt = 1' '' '[default_session]' 'command = "agreety --cmd /bin/sh"' 'user = "greeter"' >"$cfg"
    fi
    # greetd's own PAM service back (greetd-pam's greetd.orig), while greetd is still here
    [[ -f $pam.orig && -f $pam ]] && mv "$pam.orig" "$pam"
    # The display manager on before it back on (where it's still installed), in greetd's place. None noted (greetd was
    # the one before, as an AgrOS install has it): greetd stays, with its text login, said with how to choose another
    if dm=$(cat "$_dm" 2>/dev/null); then
        systemctl enable -f "$dm" >/dev/null 2>&1 || echo "agros-greeter: $dm not turned back on (greetd stays the login screen)"
        rm -f "$_dm"
    else
        echo "agros-greeter: greetd stays the login screen, as its text login (agreety). Another one: sudo systemctl enable -f <it>.service (sddm, gdm, lightdm...)"
    fi
    # What the login screen made itself: its wallpaper and colours, its state and cache
    rm -rf "$_r/etc/greetd/caelestia-greeter/theme" "$_r/var/lib/caelestia-greeter" "$_r/var/cache/caelestia-greeter"
    true
}

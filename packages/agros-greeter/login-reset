#!/bin/sh
# Puts back greetd's text login (the Caelestia login screen not used), and restarts the login service.
#   login-reset --back   the Caelestia login screen again (as agros-greeter's install sets it; reinstalling the package
#                        doesn't: pacman runs it as an upgrade, which leaves greetd's config alone)
[ "$(id -u)" -eq 0 ] || { echo "Run: sudo login-reset${1:+ $1}"; exit 1; }
if [ "${1:-}" = --back ]; then
    install -m644 /etc/greetd/caelestia-greeter/greetd-config.toml /etc/greetd/config.toml.new
else
    printf '[terminal]\nvt = 1\n\n[default_session]\ncommand = "agreety --cmd hyprland-session"\nuser = "greeter"\n' >/etc/greetd/config.toml.new
    chmod 644 /etc/greetd/config.toml.new
fi
# (beside it, then renamed over it: cut off midway, never half a file greetd can't start from)
mv /etc/greetd/config.toml.new /etc/greetd/config.toml
systemctl restart greetd

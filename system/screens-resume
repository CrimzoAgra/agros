#!/usr/bin/env bash
# systemd sleep hook (installed by agros-system to /usr/lib/systemd/system-sleep/agros-screens-resume).
# After waking: each logged-in user's screens switched back on (screens-on, as each AgrOS user: Caelestia's idle had
# them off before its idle sleep, and on only at the next key press). In a unit of its own, not waited on here: sleep
# hooks run before the user sessions are thawed (where systemd freezes them), and Hyprland can't answer before that
# (AGROS_EACH_USER: another agros-each-user, the tests')
[[ $1 == post ]] || exit 0
systemd-run --quiet --collect --no-block "${AGROS_EACH_USER:-/usr/lib/agros/bin/agros-each-user}" screens-on
exit 0

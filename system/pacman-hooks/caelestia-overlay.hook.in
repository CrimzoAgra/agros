# Template: setup.sh fills in @USER@ and @HOME@ and installs it as /etc/pacman.d/hooks/caelestia-overlay.hook
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = caelestia-shell
Target = caelestia-shell-git

[Action]
Description = Re-applying your Caelestia changes (caelestia-overlay)...
When = PostTransaction
Exec = /usr/bin/runuser -u @USER@ -- "@HOME@/.local/bin/caelestia-overlay"

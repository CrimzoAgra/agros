#!/usr/bin/env bash
# A wired card whose link keeps dropping (down and back within seconds, 3 times in 2 minutes) is stepped down, one step
# each time it keeps on: Energy-Efficient Ethernet off; then, for a card above 1 Gbps, only 1 Gbps offered; then a
# note, once, that the cable, the router or its port needs a look. Each step goes in the card's NetworkManager profile
# (kept across reboots; with no profile, through ethtool, made again each time its link comes up) and is noted per
# card, by its MAC, in /var/lib/agros/wired-link: done and said once; a new card starts fresh. Physical wired cards
# only: not Wi-Fi, bridges, VPNs, VMware's or other virtual ones. A cable pulled out (down longer than 15 s) isn't a
# drop, nor one within 15 s of a change the watch made (it renegotiates the link). Not in a VM (its unit's condition).
# It follows the kernel's link changes (ip monitor), nothing polled; each step is said to the logged-in users.
# (WIRED_SYSFS, WIRED_STATE, WIRED_EACH_USER: the tests')
set -uo pipefail
sysfs=${WIRED_SYSFS:-/sys/class/net}
state=${WIRED_STATE:-/var/lib/agros/wired-link}
each_user=${WIRED_EACH_USER:-/usr/lib/agros/bin/agros-each-user}
short=15 window=120 needed=3
declare -A down_at flaps ours
now=$(date +%s)  # (the time of the event being handled: when a change is made)

wired() {
    local d=$sysfs/$1
    [[ -e $d/device && ! -e $d/wireless && ! -e $d/phy80211 && $(cat "$d/type" 2>/dev/null) == 1 ]]
}

# note <title> <text>: on each logged-in user's desktop, or once someone logs in (agros-each-user --notify: the
# system's one way, in a unit of its own; the login screen's greeter isn't anyone)
note() {
    echo "$1: $2"
    "$each_user" --notify -a Network -i network-wired "$@" </dev/null >/dev/null 2>&1
}

# The steps taken through ethtool (no NetworkManager profile) again, where the link came back without them (a reboot,
# the driver reloaded): only when not in effect, as setting them renegotiates the link
keep_ethtool() {
    local f=$state/$2
    if grep -q '^eee ethtool' "$f" 2>/dev/null && grep -q 'EEE status: enabled' <<<"$(ethtool --show-eee "$1" 2>/dev/null)"; then
        ethtool --set-eee "$1" eee off
        ours[$1]=$now
    fi
    if grep -q '^speed ethtool' "$f" 2>/dev/null && (($(cat "$sysfs/$1/speed" 2>/dev/null || echo 0) > 1000)); then
        ethtool -s "$1" speed 1000 duplex full autoneg on
        ours[$1]=$now
    fi
}

# change <dev> <uuid> <ethtool args> -- <nmcli settings>: in the profile when there's one, applied now
change() {
    local dev=$1 uuid=$2 args=()
    shift 2
    while [[ $1 != -- ]]; do args+=("$1"); shift; done
    shift
    # (what they print to the journal: this one's output is the way it went)
    if [[ -n $uuid ]] && nmcli connection modify uuid "$uuid" "$@" >&2; then
        # (NetworkManager can't reapply ethtool.* settings on a live device: those only with the profile brought up)
        { [[ $1 != ethtool.* ]] && nmcli device reapply "$dev" >&2; } || nmcli connection up uuid "$uuid" >&2 ||
            ethtool "${args[@]}" >&2
        echo nm
    else
        ethtool "${args[@]}" >&2 && echo ethtool
    fi
}

step() {
    local dev=$1 mac=$2 f=$state/$2 uuid how speed undo
    uuid=$(nmcli -g GENERAL.CON-UUID device show "$dev" 2>/dev/null)
    mkdir -p "$state"
    if ! grep -q '^eee ' "$f" 2>/dev/null && grep -q 'EEE status: enabled' <<<"$(ethtool --show-eee "$dev" 2>/dev/null)"; then
        how=$(change "$dev" "$uuid" --set-eee "$dev" eee off -- ethtool.eee-enabled off) || return
        ours[$dev]=$now
        echo "eee $how $uuid" >>"$f"
        undo="nmcli connection modify uuid $uuid ethtool.eee-enabled \"\" (it's back on after a restart)"
        [[ $how == nm ]] || undo="sudo rm $f, then restart"
        note "Wired network: power saving off" "The wired connection ($dev) kept dropping, so its power saving \
(Energy-Efficient Ethernet), a common cause, is now off. To undo: $undo"
        return
    fi
    speed=$(cat "$sysfs/$dev/speed" 2>/dev/null || echo 0)
    if ! grep -q '^speed ' "$f" 2>/dev/null && ((speed > 1000)); then
        # (auto-negotiate with one speed set: NetworkManager offers only that one; nm-settings-nmcli(5))
        how=$(change "$dev" "$uuid" -s "$dev" speed 1000 duplex full autoneg on -- 802-3-ethernet.auto-negotiate yes \
            802-3-ethernet.speed 1000 802-3-ethernet.duplex full) || return
        ours[$dev]=$now
        echo "speed $how $uuid" >>"$f"
        undo="nmcli connection modify uuid $uuid 802-3-ethernet.speed \"\" 802-3-ethernet.duplex \"\" && nmcli connection up uuid $uuid"
        [[ $how == nm ]] || undo="sudo rm $f, then restart"
        note "Wired network: 1 Gbps" "The wired connection ($dev) kept dropping at $speed Mbit/s, so it now connects \
at 1 Gbps at most: faster speeds are often unstable with some cards, cables and routers. To undo: $undo"
        return
    fi
    grep -qx noted "$f" 2>/dev/null && return
    echo noted >>"$f"
    note "Wired network keeps dropping" "The wired connection ($dev) still drops every few seconds, and there's \
nothing more to change on this computer. Check the cable (or try another), and the router or switch: another port, or \
restart it."
}

# event <time> <dev> <flags>: a drop is the carrier lost and back within $short s (taken down on purpose isn't one, nor
# one starting within $short s of a change made here: the link renegotiated)
event() {
    local t=$1 dev=$2 flags=,$3, d mac x c keep=()
    now=$t
    wired "$dev" || return 0
    if [[ $flags != *,UP,* ]]; then unset 'down_at[$dev]'; return; fi
    if [[ $flags == *,NO-CARRIER,* || $flags != *,LOWER_UP,* ]]; then
        down_at[$dev]=${down_at[$dev]:-$t}
        return
    fi
    d=${down_at[$dev]:-}
    unset 'down_at[$dev]'
    [[ -n $d ]] || return 0
    mac=$(cat "$sysfs/$dev/address") mac=${mac//:/-}
    c=${ours[$dev]:-}
    keep_ethtool "$dev" "$mac"
    ((t - d <= short)) || return 0
    [[ -z $c ]] || ((d < c || d - c > short)) || return 0
    for x in ${flaps[$dev]:-}; do ((t - x < window)) && keep+=("$x"); done
    keep+=("$t")
    flaps[$dev]=${keep[*]}
    ((${#keep[@]} >= needed)) || return 0
    echo "$dev: link dropped ${#keep[@]} times in $((t - keep[0])) s"
    flaps[$dev]=
    step "$dev" "$mac"
}

for x in "$sysfs"/*; do
    x=${x##*/}
    if wired "$x"; then y=$(cat "$sysfs/$x/address"); keep_ethtool "$x" "${y//:/-}"; fi
done
# ([2026-11-14T11:30:47.368668] 2: enp8s0: <NO-CARRIER,BROADCAST,MULTICAST,UP> ...; a veth's name has @peer)
re='^\[([0-9-]+)T([0-9:]+)[^]]*\] [0-9]+: ([^:@ ]+)[^:]*: <([^>]*)>'
while read -r line; do
    [[ $line =~ $re ]] || continue
    t=$(date -d "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}" +%s) || continue
    event "$t" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
done < <(ip -o -ts monitor link)
